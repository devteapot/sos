{
  "name": "sos-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:android": "npm run build && esbuild dist/src/android-runner.js --bundle --platform=node --format=cjs --target=node24 --outfile=dist/android-runner.cjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
