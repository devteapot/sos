#!/usr/bin/env bash

set -euo pipefail

[[ "$#" -eq 1 ]] || {
  printf 'usage: tests/fixtures/linux-x11-socket-owner SOCKET\n' >&2
  exit 2
}

exec python3 - "$1" <<'PY'
import signal
import socket
import sys

listener = socket.socket(socket.AF_UNIX)
listener.bind(sys.argv[1])
listener.listen()
signal.pause()
PY
