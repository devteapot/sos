<?xml version="1.0" encoding="utf-8" ?>
<!--
  AndroidManifest.xml for the GPUI Mobile Android Example.

  This manifest declares a NativeActivity that loads the Rust shared library
  compiled from the `android_app` example.  The library name is injected via
  the `nativeLibraryName` manifest placeholder defined in build.gradle.kts.

  Key points:
    - NativeActivity is used instead of a regular Activity so the entire
      application lifecycle is driven from native (Rust) code.
    - The `android.app.lib_name` meta-data tells NativeActivity which .so
      to dlopen.  It must match the cdylib / example output name WITHOUT
      the `lib` prefix or `.so` suffix.
    - `configChanges` prevents the activity from being recreated on common
      configuration changes (rotation, keyboard, screen size).  The Rust
      code handles these via NDK callbacks instead.
    - Hardware acceleration is enabled for Vulkan / GPU compositing.
    - The theme hides the title bar and status bar for a fullscreen
      immersive experience.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.MANAGE_ROLE_HOLDERS" />
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <!-- Platform-signature permission used only to mark the permanent Compat
         escape chrome as a system application overlay. This keeps the trusted
         controls visible when a compatibility Activity asks WindowManager to
         hide ordinary overlays. -->
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="dev.sos.permission.REPORT_HOME_HEARTBEAT" />
    <uses-permission android:name="dev.sos.permission.REPORT_ADB_CONSENT" />
    <!-- SOS is platform-signed and is the system HOME on SOS products. This
         signature permission keeps scan/configuration access inside the
         trusted permanent host rather than exposing Wi-Fi objects to Luau. -->
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />

    <!-- Package visibility is deliberately limited to exported launcher
         Activities. Compat never receives a general inventory of installed
         packages or system services. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Vulkan feature declaration.
         `required="false"` allows the app to fall back to OpenGL ES on
         devices without Vulkan support. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />

    <!-- GPU hardware acceleration is required for wgpu rendering. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Touchscreen support (virtually all Android devices). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <application
        android:name="dev.gpui.mobile.SosApplication"
        android:allowBackup="false"
        android:directBootAware="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SOS"
        android:persistent="${sosExperiencePersistent}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >

        <!--
          GpuiActivity extends NativeActivity and integrates the AndroidX
          SplashScreen API.  The splash screen is held visible until the
          Rust native library signals readiness via NATIVE_INITIALIZED.

          The Android framework loads the specified native library and calls
          ANativeActivity_onCreate(), which is defined in gpui_mobile::android::jni.
          The spawned Rust thread calls gpui_android_main() (defined in the
          android_app example) to start the application.
        -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:directBootAware="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >

            <!-- The native library name WITHOUT the "lib" prefix and ".so" suffix.
                 This is set via manifestPlaceholders in build.gradle.kts. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <!-- Mark this activity as the main launcher entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link intent filter for custom URL scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sos" />
            </intent-filter>
        </activity>

        <!-- Enabled only for the AOSP product build. Keeping HOME on an alias
             prevents the ordinary physical-device regression APK from
             competing with the user's installed launcher. -->
        <activity-alias
            android:name="dev.sos.experience.SosHomeActivity"
            android:directBootAware="false"
            android:enabled="${sosHomeEnabled}"
            android:exported="true"
            android:targetActivity="dev.gpui.mobile.GpuiActivity"
        >
            <!-- Activity aliases have their own metadata bundle; they do not
                 inherit the target Activity's android.app.lib_name entry. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Transparent helper Activity for file/image picker results. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:enabled="${sosAndroidCeremoniesEnabled}"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Transparent helper Activity for runtime permission requests. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:enabled="${sosAndroidCeremoniesEnabled}"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Transparent helper Activity for biometric authentication (BiometricPrompt). -->
        <activity
            android:name="dev.gpui.mobile.GpuiAuthActivity"
            android:enabled="${sosAndroidCeremoniesEnabled}"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Native Pi is a real child process, not a WebView. Keep the app in
             foreground-service state while a provider request or external
             OAuth browser temporarily backgrounds HOME so Android does not
             reap that bounded child process. -->
        <service
            android:name="dev.gpui.mobile.GpuiAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false"
        />

        <activity
            android:name="dev.gpui.mobile.SosAdbConfirmationActivity"
            android:directBootAware="true"
            android:enabled="${sosCompatEnabled}"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnCloseSystemDialogs="true"
            android:permission="android.permission.MANAGE_DEBUGGING"
            android:theme="@style/GpuiTheme"
        />

        <service
            android:name="dev.gpui.mobile.SosCompatChromeService"
            android:directBootAware="false"
            android:enabled="${sosCompatEnabled}"
            android:exported="false"
            android:stopWithTask="false"
        />

        <service
            android:name="dev.gpui.mobile.SosAttentionListenerService"
            android:directBootAware="false"
            android:enabled="${sosCompatEnabled}"
            android:exported="true"
            android:label="SOS attention broker"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        >
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>

        <receiver
            android:name="dev.gpui.mobile.SosBootReceiver"
            android:directBootAware="true"
            android:enabled="${sosHomeEnabled}"
            android:exported="true"
        >
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="dev.gpui.mobile.SosSystemAttentionReceiver"
            android:directBootAware="false"
            android:enabled="${sosCompatEnabled}"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
        >
            <intent-filter>
                <action android:name="dev.sos.action.SYSTEM_ATTENTION" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
