From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SOS bring-up <sos@localhost>
Date: Sun, 16 Aug 2026 23:55:00 +0200
Subject: [PATCH] s5e8825-common: Allow SOS Core to enable the Samsung TSP

Core 1 has no InputFlinger, so the native host must write the Samsung TSP
enable node. That node is a vendor SELinux type invisible from system_ext
policy; include the SOS vendor rules when the overlay is staged.

---
 BoardConfigCommon.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index 6fe45e9..ffaeef6 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -186,6 +186,10 @@ VENDOR_SECURITY_PATCH := 2025-10-01
 # SELinux
 BOARD_SEPOLICY_TEE_FLAVOR := teegris
 BOARD_VENDOR_SEPOLICY_DIRS += $(COMMON_PATH)/sepolicy/vendor
+# SOS Core writes /sys/class/sec/tsp/input/enabled; the type is vendor-only.
+ifneq ($(wildcard device/sos/a33x/sepolicy/vendor),)
+BOARD_VENDOR_SEPOLICY_DIRS += device/sos/a33x/sepolicy/vendor
+endif
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/private
 include device/lineage/sepolicy/exynos/sepolicy.mk
 include device/samsung_slsi/sepolicy/sepolicy.mk
-- 
2.51.0
