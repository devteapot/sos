+    private void notifySosAttention(ProcessRecord proc, String kind) {
+        final String packageName = proc.info == null || proc.info.packageName == null
+                ? proc.processName : proc.info.packageName;
+        final Intent intent = new Intent("dev.sos.action.SYSTEM_ATTENTION")
+                .setPackage("dev.sos.experience")
+                .putExtra("kind", kind)
+                .putExtra("package", packageName)
+                .putExtra("title", "Application " + kind)
+                .putExtra("detail", packageName);
+        // Crash UI dispatch can hold mProcLock. Keep the SOS presentation
+        // bridge asynchronous so a receiver launch never nests back into AMS
+        // while process state is locked.
+        mService.mHandler.post(() ->
+                mContext.sendBroadcastAsUser(intent, UserHandle.SYSTEM));
+    }
