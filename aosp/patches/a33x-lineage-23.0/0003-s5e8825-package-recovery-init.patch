From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SOS bring-up <sos@localhost>
Date: Sat, 15 Aug 2026 10:15:00 +0200
Subject: [PATCH] s5e8825-common: Package device init in recovery ramdisk

Recovery's generic init imports /init.recovery.${ro.hardware}.rc, while the
device-specific recovery init was only installed into vendor. Install it at
the imported s5e8825 recovery-ramdisk path so configfs receives the DWC3
controller property and watchdogd feeds the hardware watchdog.
---
 common.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/common.mk b/common.mk
index 8476908..1233c99 100644
--- a/common.mk
+++ b/common.mk
@@ -275,4 +275,7 @@ PRODUCT_PACKAGES += powerhint.json
 # Recovery
+PRODUCT_COPY_FILES += \
+    $(COMMON_PATH)/configs/init/init.s5e8825.recovery.rc:$(TARGET_COPY_OUT_RECOVERY)/root/init.recovery.s5e8825.rc
+
 PRODUCT_PACKAGES += init.s5e8825.recovery.rc
 
 # RIL
