# Shared native Core host. Core Shadow starts it manually; active Core 1 and the
# frozen Core 0B migration target use the pre-unlock trigger below.
on post-fs-data
    mkdir /data/misc/sos/core 0770 system system
    restorecon_recursive /data/misc/sos/core

on property:debug.sos.core.host=1
    start sos_core_host

on property:debug.sos.core.host=0
    stop sos_core_host

on property:debug.sos.core.bridge_probe=1
    start sos_core_bridge_probe

on property:init.svc.surfaceflinger=running && property:ro.sos.core.autostart=preunlock
    start sos_core_host

service sos_core_host /system_ext/bin/sos-core-host
    class late_start
    user system
    group system graphics input inet
    disabled
    oneshot
    gentle_kill
    restart_period 1
    task_profiles MaxPerformance

# Read-only instrumentation for the headless bridge boundary. It reports only
# credential type and unlocked state; it cannot accept credential bytes.
service sos_core_bridge_probe /system_ext/bin/sos-core-host --bridge-probe
    class late_start
    user system
    group system
    disabled
    oneshot
