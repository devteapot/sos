init_daemon_domain(sos_core_host)
net_domain(sos_core_host)

# The fixed supervisor re-execs this one signed binary for a clean GPUI child.
allow sos_core_host sos_core_host_exec:file execute_no_trans;
# Core's deterministic agent path executes the same immutable Pi bundle as
# Compat, while the host remains the compile/render/activation authority.
allow sos_core_host sos_node_exec:file rx_file_perms;
allow sos_core_host sos_node_exec:file execute_no_trans;
# Node reads the aggregate memory snapshot while starting the immutable Pi
# runner. It does not need process-specific proc access or any writable proc
# surface.
allow sos_core_host proc_meminfo:file r_file_perms;

binder_use(sos_core_host)
binder_call(sos_core_host, surfaceflinger)
binder_call(surfaceflinger, sos_core_host)
hwbinder_use(sos_core_host)

hal_client_domain(sos_core_host, hal_graphics_allocator)
hal_client_domain(sos_core_host, hal_graphics_composer)

allow sos_core_host surfaceflinger_service:service_manager find;
allow sos_core_host gpu_device:chr_file rw_file_perms;
allow sos_core_host gpu_device:dir r_dir_perms;
allow sos_core_host sysfs_gpu:file r_file_perms;
allow sos_core_host sysfs_net:dir r_dir_perms;
allow sos_core_host sysfs_net:file r_file_perms;
allow sos_core_host ion_device:chr_file rw_file_perms;
allow sos_core_host dmabuf_system_heap_device:chr_file r_file_perms;
allow sos_core_host hal_graphics_allocator:fd use;
allow sos_core_host hal_graphics_composer:fd use;

allow sos_core_host input_device:chr_file rw_file_perms;
allow sos_core_host input_device:dir r_dir_perms;
allow sos_core_host sos_authority_data_file:dir create_dir_perms;
allow sos_core_host sos_authority_data_file:file create_file_perms;
allow sos_core_host sos_authority_data_file:sock_file rw_file_perms;
allow sos_core_host sos_authority:unix_stream_socket connectto;
allow sos_core_host { sos_provider_port sos_revision_port }:tcp_socket name_connect;

# Core 0B's only Java dependency is a direct-boot, system-UID process with no
# Activities. Peer credentials and this domain transition bound the abstract
# socket before a credential byte is accepted.
allow sos_core_host system_app:unix_stream_socket connectto;
# The same non-rendering bridge reports screen-off and permanent-HOME failure
# into the fixed Compat supervisor. Peer UID checks still gate the abstract
# control socket in native code.
allow system_app sos_core_host:unix_stream_socket connectto;

# The fixed Volume Up+Down chord is the recovery path even when system_server
# and Android's power UI are absent.
set_prop(sos_core_host, powerctl_prop)
