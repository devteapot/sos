package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_etc {
    name: "sos-compat-privapp-permissions",
    src: "permissions/privapp-permissions-sos.xml",
    filename: "privapp-permissions-sos.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

cc_binary {
    name: "sos-core-surface-probe",
    srcs: ["core/surface_probe.cpp"],
    compile_multilib: "64",
    system_ext_specific: true,
    init_rc: ["core/sos-core-surface-probe.rc"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    shared_libs: [
        "libEGL",
        "libGLESv2",
        "libbinder",
        "libgui",
        "liblog",
        "libui",
        "libutils",
    ],
}

cc_binary {
    name: "sos-core-host",
    srcs: ["core/host.cpp"],
    compile_multilib: "64",
    system_ext_specific: true,
    init_rc: ["core/sos-core-host.rc"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libdl",
        "libgui",
        "liblog",
        "libnativewindow",
        "libui",
        "libutils",
    ],
}

cc_binary {
    name: "sos-core-platform-adapter",
    stem: "sos-core-platform",
    srcs: ["core/platform_adapter.cpp"],
    compile_multilib: "64",
    system_ext_specific: true,
    init_rc: ["core/sos-core-platform.rc"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    shared_libs: [
        "android.hardware.health-V4-ndk",
        "android.hardware.wifi.supplicant-V4-ndk",
        "libaudioclient",
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcrypto",
        "libjsoncpp",
        "liblog",
        "libutils",
    ],
}

cc_defaults {
    name: "sos-ui-removal-marker-defaults",
    srcs: ["core/ui_removal_marker.cpp"],
    compile_multilib: "64",
    system_ext_specific: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    overrides: [
        "Aperture",
        "ApertureLensLauncher",
        "AccessibilityMenu",
        "AudioFX",
        "AvatarPicker",
        "Backgrounds",
        "BackupRestoreConfirmation",
        "BasicDreams",
        "Camelot",
        "CaptivePortalLogin",
        "CertInstaller",
        "Contacts",
        "CredentialManager",
        "DeskClock",
        "DeviceAsWebcam",
        "DeviceDiagnostics",
        "Dialer",
        "DocumentsUI",
        "DownloadProviderUi",
        "DynamicSystemInstallationService",
        "EasterEgg",
        "EmergencyInfo",
        "Etar",
        "ExactCalculator",
        "Gallery2",
        "Glimpse",
        "HTMLViewer",
        "IntentResolver",
        "Jelly",
        "Launcher3QuickStep",
        "LineageParts",
        "LineageSetupWizard",
        "LiveWallpapersPicker",
        "ManagedProvisioning",
        "PhotoTable",
        "PrintSpooler",
        "Profiles",
        "QuickAccessWallet",
        "Recorder",
        "SamsungDoze",
        "SamsungDAP-custom",
        "Seedvault",
        "Settings",
        "SettingsIntelligence",
        "SimAppDialog",
        "SimpleSettingsConfig",
        "SoundPicker",
        "SpeakerFX",
        "Stk",
        "StorageManager",
        "SystemUI",
        "ThemePicker",
        "ThemesStub",
        "Twelve",
        "Updater",
        "VpnDialogs",
        "messaging",
    ],
}

// Core excludes LatinIME in addition to the shared Android UI package set.
cc_binary {
    name: "sos-ui-removal-marker",
    defaults: ["sos-ui-removal-marker-defaults"],
    overrides: [
        "LatinIME",
    ],
}

// Compat keeps the Android application runtime's system IME service, but no
// other inherited Android UI package. Its distinct installed filename avoids
// colliding with the globally defined Core marker during graph generation.
cc_binary {
    name: "sos-compat-ui-removal-marker",
    defaults: ["sos-ui-removal-marker-defaults"],
}

android_app {
    name: "SosFrameworkBridge",
    srcs: ["frameworkbridge/src/**/*.java"],
    manifest: "frameworkbridge/AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    optimize: {
        enabled: true,
    },
}

cc_prebuilt_library_shared {
    name: "sos-core-experience-runtime",
    srcs: ["prebuilts/arm64/libsos_core_experience.so"],
    stem: "libsos_core_experience",
    compile_multilib: "64",
    check_elf_files: false,
    system_ext_specific: true,
    strip: {
        none: true,
    },
}

android_app_import {
    name: "SosShell",
    apk: "prebuilts/SosShell.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

cc_prebuilt_binary {
    name: "sos-android-system-authority",
    srcs: ["prebuilts/arm64/sos-android-system-authority"],
    stem: "sos-authority",
    compile_multilib: "64",
    check_elf_files: false,
    system_ext_specific: true,
    strip: {
        none: true,
    },
    init_rc: ["sos-authority.rc"],
}

cc_prebuilt_binary {
    name: "sos-node",
    srcs: ["prebuilts/arm64/sos-node"],
    stem: "sos-node",
    compile_multilib: "64",
    check_elf_files: false,
    system_ext_specific: true,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "sos-node-cxx-shared",
    srcs: ["prebuilts/arm64/libc++_shared.so"],
    stem: "libc++_shared",
    compile_multilib: "64",
    check_elf_files: false,
    system_ext_specific: true,
    strip: {
        none: true,
    },
}

prebuilt_etc {
    name: "sos-agent-runner",
    src: "prebuilts/sos-agent/agent-runner.cjs",
    filename: "agent-runner.cjs",
    sub_dir: "sos-agent",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sos-agent-experience-api",
    src: "prebuilts/sos-agent/experience-api.md",
    filename: "experience-api.md",
    sub_dir: "sos-agent",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sos-agent-example-primary",
    src: "prebuilts/sos-agent/example-primary.luau",
    filename: "example-primary.luau",
    sub_dir: "sos-agent",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sos-agent-example-secondary",
    src: "prebuilts/sos-agent/example-secondary.luau",
    filename: "example-secondary.luau",
    sub_dir: "sos-agent",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sos-default-experience",
    src: "prebuilts/default.luau",
    filename: "default.luau",
    sub_dir: "sos",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "sos-core-app-manifest",
    src: "core/core-apps.json",
    filename: "core-apps.json",
    sub_dir: "sos",
    system_ext_specific: true,
}
