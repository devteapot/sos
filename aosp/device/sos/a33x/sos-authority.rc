on post-fs-data
    mkdir /data/misc/sos 0770 system system
    mkdir /data/misc/sos/revisions 0770 system system
    restorecon_recursive /data/misc/sos

# Physical recovery acceptance must restart only the authority while leaving
# the host process intact. The property is shell-writable only in userdebug and
# eng policy, names exactly this service, and is reset after one use.
on property:sys.sos.authority_recovery_probe=1
    restart sos_authority
    setprop sys.sos.authority_recovery_probe 0

service sos_authority /system_ext/bin/sos-authority --root /data/misc/sos/revisions --state-file /data/misc/sos/provider-state.json --bootstrap-source /system_ext/etc/sos/mobile.luau --bootstrap-package /system_ext/etc/sos/mobile.package.json --bootstrap-asset mobile.theme luau /system_ext/etc/sos/modules/mobile-theme.luau --install-reference-composition
    class main
    user system
    group system inet
    restart_period 1
