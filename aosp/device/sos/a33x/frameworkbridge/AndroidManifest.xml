<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sos.frameworkbridge"
    android:sharedUserId="android.uid.system">
    <permission
        android:name="dev.sos.permission.REPORT_HOME_HEARTBEAT"
        android:protectionLevel="signature" />
    <permission
        android:name="dev.sos.permission.REPORT_ADB_CONSENT"
        android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.MANAGE_DEBUGGING" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name=".SosFrameworkBridgeApplication"
        android:allowBackup="false"
        android:directBootAware="true"
        android:hasCode="true"
        android:label="SOS trusted framework bridge"
        android:persistent="true"
        android:supportsRtl="false">
        <receiver
            android:name=".SosAdbConsentReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="dev.sos.permission.REPORT_ADB_CONSENT">
            <intent-filter>
                <action android:name="dev.sos.action.ADB_CONSENT_RESULT" />
            </intent-filter>
        </receiver>
        <service
            android:name=".SosProviderNotificationListenerService"
            android:directBootAware="true"
            android:exported="true"
            android:label="SOS attention provider"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
