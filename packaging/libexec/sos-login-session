#!/usr/bin/env bash

set -euo pipefail

sos_login_fail() {
  printf 'sos_login_session_failed error=%s\n' "$*" >&2
  exit 1
}

[[ "$(id -u)" -ne 0 ]] || sos_login_fail "refusing to run a selectable desktop session as root"
[[ -n "${HOME:-}" && "$HOME" == /* ]] || sos_login_fail "HOME must be an absolute path"
[[ -n "${XDG_RUNTIME_DIR:-}" && "$XDG_RUNTIME_DIR" == /* ]] || \
  sos_login_fail "XDG_RUNTIME_DIR must be an absolute path supplied by the display manager"
[[ -d "$XDG_RUNTIME_DIR" && -O "$XDG_RUNTIME_DIR" ]] || \
  sos_login_fail "XDG_RUNTIME_DIR must exist and belong to the login user"

sos_login_bin_dir="${SOS_INSTALL_ROOT:-/usr/local/libexec/sos}"
sos_login_default_source="${SOS_DEFAULT_EXPERIENCE:-/usr/share/sos/experiences/default.luau}"
sos_login_default_package="${SOS_DEFAULT_PACKAGE:-/usr/share/sos/experiences/default.package.json}"
sos_login_stock_theme="${SOS_STOCK_THEME:-/usr/share/sos/experiences/modules/stock-theme.luau}"
sos_login_state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
for sos_login_path in \
  "$sos_login_bin_dir" \
  "$sos_login_default_source" \
  "$sos_login_default_package" \
  "$sos_login_stock_theme" \
  "$sos_login_state_home"; do
  [[ "$sos_login_path" == /* ]] || sos_login_fail "session paths must be absolute: $sos_login_path"
done

sos_login_session_bin="$sos_login_bin_dir/sos-linux-session"
sos_login_compositor_bin="$sos_login_bin_dir/sos-compositor"
sos_login_provider_bin="$sos_login_bin_dir/sos-provider-state-service"
sos_login_supervisor_bin="$sos_login_bin_dir/sos-revision-supervisor"
sos_login_host_bin="$sos_login_bin_dir/sos-experience-host"
sos_login_authoring_bin="$sos_login_bin_dir/sos-agent-authoring"
sos_login_agent_main="${SOS_AGENT_MAIN:-/usr/local/libexec/sos-agent/dist/agent-runner.cjs}"
for sos_login_executable in \
  "$sos_login_session_bin" \
  "$sos_login_compositor_bin" \
  "$sos_login_provider_bin" \
  "$sos_login_supervisor_bin" \
  "$sos_login_host_bin"; do
  [[ -x "$sos_login_executable" ]] || sos_login_fail "missing executable: $sos_login_executable"
done
[[ -r "$sos_login_default_source" ]] || \
  sos_login_fail "missing default experience: $sos_login_default_source"
for sos_login_package_file in \
  "$sos_login_default_package" \
  "$sos_login_stock_theme"; do
  [[ -r "$sos_login_package_file" ]] || \
    sos_login_fail "missing v4 experience package input: $sos_login_package_file"
done
command -v systemd-inhibit >/dev/null 2>&1 || \
  sos_login_fail "systemd-inhibit is required to keep the SOS session awake"

umask 077
sos_login_state_dir="$sos_login_state_home/sos"
sos_login_revision_root="$sos_login_state_dir/revisions"
sos_login_authority_file="$sos_login_state_dir/provider/authority.json"
sos_login_token_file="$sos_login_state_dir/shell-token"
sos_login_appearance_capability_file="$sos_login_state_dir/appearance-write.capability"
sos_login_grant_capability_file="$sos_login_state_dir/grant-review.capability"
sos_login_trusted_stock_file="$sos_login_state_dir/trusted-stock-revision"
sos_login_output_config="$sos_login_state_dir/output.json"
sos_login_agent_state_dir="$sos_login_state_dir/agent"
sos_login_agent_credentials="$sos_login_agent_state_dir/auth.json"
sos_login_agent_config="$sos_login_agent_state_dir/config.env"
sos_login_provider_root="${SOS_LINUX_PROVIDER_ROOT:-$sos_login_state_dir/providers}"
sos_login_provider_grants="${SOS_PROVIDER_GRANTS:-$sos_login_state_dir/provider-grants.json}"
sos_login_graph_runtime_isolation="${SOS_GRAPH_RUNTIME_ISOLATION:-process}"
case "$sos_login_graph_runtime_isolation" in
  thread|process) ;;
  *) sos_login_fail "SOS_GRAPH_RUNTIME_ISOLATION must be thread or process" ;;
esac
export SOS_GRAPH_RUNTIME_ISOLATION="$sos_login_graph_runtime_isolation"
install -d -m 0700 "$sos_login_state_home" "$sos_login_state_dir" "$sos_login_revision_root"

for sos_login_path in "$sos_login_provider_root" "$sos_login_provider_grants"; do
  [[ "$sos_login_path" == /* ]] || \
    sos_login_fail "provider paths must be absolute: $sos_login_path"
done
sos_login_development_grants="${SOS_PROVIDER_DEVELOPMENT_GRANTS:-}"
sos_login_image_identity="${SOS_IMAGE_IDENTITY_FILE:-/usr/share/doc/sos/image-identity.env}"
if [[ -z "$sos_login_development_grants" && -r "$sos_login_image_identity" ]] \
  && grep -Fx 'image_kind=development-live' "$sos_login_image_identity" >/dev/null \
  && grep -Fx 'mutable_runtime=true' "$sos_login_image_identity" >/dev/null; then
  sos_login_development_grants=1
fi
if [[ "$sos_login_development_grants" == 1 ]]; then
  install -d -m 0700 "$sos_login_provider_root"
  sos_login_grants_tmp="$sos_login_state_dir/.provider-grants.$$"
  printf '%s\n' \
    '{"*":["application_launch","audio_control","calendar_read","calendar_write","network_control","notes_read","notes_write","music_read","music_control","system_read","video_read","camera_read"]}' \
    >"$sos_login_grants_tmp"
  chmod 0600 "$sos_login_grants_tmp"
  mv -f -- "$sos_login_grants_tmp" "$sos_login_provider_grants"
  export SOS_LINUX_PROVIDER_ROOT="$sos_login_provider_root"
  export SOS_PROVIDER_GRANTS="$sos_login_provider_grants"
  export SOS_PROVIDER_DEVELOPMENT_GRANTS=1
elif [[ -n "${SOS_LINUX_PROVIDER_ROOT:-}" || -n "${SOS_PROVIDER_GRANTS:-}" ]]; then
  [[ -n "${SOS_LINUX_PROVIDER_ROOT:-}" && -n "${SOS_PROVIDER_GRANTS:-}" ]] || \
    sos_login_fail "SOS_LINUX_PROVIDER_ROOT and SOS_PROVIDER_GRANTS must be configured together"
  [[ -d "$sos_login_provider_root" && -r "$sos_login_provider_grants" ]] || \
    sos_login_fail "configured Linux provider root or grants are unavailable"
fi

if [[ ! -f "$sos_login_token_file" ]]; then
  sos_login_token_tmp="$sos_login_state_dir/.shell-token.$$"
  od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$sos_login_token_tmp"
  chmod 0600 "$sos_login_token_tmp"
  mv -n -- "$sos_login_token_tmp" "$sos_login_token_file"
  rm -f -- "$sos_login_token_tmp"
fi
chmod 0600 "$sos_login_token_file"
if [[ ! -f "$sos_login_appearance_capability_file" ]]; then
  sos_login_appearance_tmp="$sos_login_state_dir/.appearance-write.$$"
  od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$sos_login_appearance_tmp"
  chmod 0600 "$sos_login_appearance_tmp"
  mv -n -- "$sos_login_appearance_tmp" "$sos_login_appearance_capability_file"
  rm -f -- "$sos_login_appearance_tmp"
fi
chmod 0600 "$sos_login_appearance_capability_file"
if [[ ! -f "$sos_login_grant_capability_file" ]]; then
  sos_login_grant_tmp="$sos_login_state_dir/.grant-review.$$"
  od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$sos_login_grant_tmp"
  chmod 0600 "$sos_login_grant_tmp"
  mv -n -- "$sos_login_grant_tmp" "$sos_login_grant_capability_file"
  rm -f -- "$sos_login_grant_tmp"
fi
chmod 0600 "$sos_login_grant_capability_file"
if [[ ! -e "$sos_login_output_config" ]]; then
  printf '{}\n' >"$sos_login_output_config"
fi
[[ ! -L "$sos_login_output_config" && -f "$sos_login_output_config" \
  && -O "$sos_login_output_config" ]] || \
  sos_login_fail "output configuration must be a regular file"
chmod 0600 "$sos_login_output_config"

sos_login_stock_graph="$($sos_login_supervisor_bin graph-status \
  --root "$sos_login_revision_root" \
  --experience sos.stock.shell)"
if [[ "$sos_login_stock_graph" == none ]]; then
  sos_login_legacy_current="$($sos_login_supervisor_bin status \
    --root "$sos_login_revision_root")"
  if [[ "$sos_login_legacy_current" == none ]]; then
    sos_login_initial_state="$sos_login_state_dir/.initial-state.$$"
    printf '{}\n' >"$sos_login_initial_state"
    sos_login_revision="$($sos_login_supervisor_bin install-package \
      --root "$sos_login_revision_root" \
      --source "$sos_login_default_source" \
      --state "$sos_login_initial_state" \
      --schema 1 \
      --package "$sos_login_default_package" \
      --asset "stock.theme:luau:$sos_login_stock_theme")"
    rm -f -- "$sos_login_initial_state"
    "$sos_login_supervisor_bin" bootstrap-graph \
      --root "$sos_login_revision_root" \
      --experience sos.stock.shell \
      --revision "$sos_login_revision" >/dev/null
    printf '%s\n' "$sos_login_revision" >"$sos_login_trusted_stock_file"
    chmod 0600 "$sos_login_trusted_stock_file"
    printf 'sos_login_session_initialized api_version=4 revision_id=%s\n' \
      "$sos_login_revision"
  else
    sos_login_migration="$($sos_login_supervisor_bin migrate-stock-v4 \
      --root "$sos_login_revision_root" \
      --source "$sos_login_default_source" \
      --package "$sos_login_default_package" \
      --asset "stock.theme:luau:$sos_login_stock_theme")"
    printf 'sos_login_session_migrated %s\n' "$sos_login_migration"
    sos_login_migrated_revision="$($sos_login_supervisor_bin experience-status \
      --root "$sos_login_revision_root" \
      --experience sos.stock.shell)"
    printf '%s\n' "$sos_login_migrated_revision" >"$sos_login_trusted_stock_file"
    chmod 0600 "$sos_login_trusted_stock_file"
  fi
fi

if [[ "$($sos_login_supervisor_bin experience-status \
    --root "$sos_login_revision_root" \
    --experience sos.timeflow)" != none ]]; then
  "$sos_login_supervisor_bin" retire-experience \
    --root "$sos_login_revision_root" \
    --experience sos.timeflow
fi
if [[ ! -f "$sos_login_trusted_stock_file" ]]; then
  sos_login_current_stock="$($sos_login_supervisor_bin experience-status \
    --root "$sos_login_revision_root" \
    --experience sos.stock.shell)"
  [[ "$sos_login_current_stock" =~ ^[0-9a-f]{64}$ \
    && -f "$sos_login_revision_root/revisions/$sos_login_current_stock/source.luau" ]] || \
    sos_login_fail "Stock registry does not contain a verifiable v4 revision"
  cmp -s -- "$sos_login_default_source" \
    "$sos_login_revision_root/revisions/$sos_login_current_stock/source.luau" || \
    sos_login_fail "cannot infer a trusted product grant for a customized Stock revision"
  printf '%s\n' "$sos_login_current_stock" >"$sos_login_trusted_stock_file"
  chmod 0600 "$sos_login_trusted_stock_file"
fi
sos_login_stock_revision="$(tr -d '\r\n' <"$sos_login_trusted_stock_file")"
[[ "$sos_login_stock_revision" =~ ^[0-9a-f]{64}$ ]] || \
  sos_login_fail "trusted Stock revision is invalid"

sos_login_runtime="$(mktemp -d "$XDG_RUNTIME_DIR/sos-session.XXXXXX")"
sos_login_agent_socket="$sos_login_runtime/agent.sock"
sos_login_agent_authoring_socket="$sos_login_runtime/agent-authoring.sock"
sos_login_provider_socket="$sos_login_runtime/provider-state.sock"
sos_login_accessibility_socket="$sos_login_runtime/accessibility.sock"
sos_login_supervisor_socket="$sos_login_revision_root/run/supervisor.sock"
sos_login_session_pid=""
sos_login_authoring_pid=""
sos_login_agent_pid=""
sos_login_graphical_target_started=false
# ShellCheck cannot infer that EXIT invokes this callback.
# shellcheck disable=SC2317,SC2329
sos_login_cleanup() {
  if [[ "$sos_login_graphical_target_started" == true ]]; then
    systemctl --user start sos-session-shutdown.target >/dev/null 2>&1 || true
  fi
  for sos_login_cleanup_pid in \
    "$sos_login_agent_pid" \
    "$sos_login_authoring_pid" \
    "$sos_login_session_pid"; do
    if [[ -n "$sos_login_cleanup_pid" ]] && kill -0 "$sos_login_cleanup_pid" 2>/dev/null; then
      kill -TERM "$sos_login_cleanup_pid" 2>/dev/null || true
    fi
  done
  for sos_login_cleanup_pid in \
    "$sos_login_agent_pid" \
    "$sos_login_authoring_pid" \
    "$sos_login_session_pid"; do
    [[ -z "$sos_login_cleanup_pid" ]] || wait "$sos_login_cleanup_pid" 2>/dev/null || true
  done
  if [[ "$sos_login_runtime" == "$XDG_RUNTIME_DIR"/sos-session.* && -d "$sos_login_runtime" ]]; then
    rm -r -- "$sos_login_runtime"
  fi
}
# ShellCheck cannot infer that the signal traps invoke this callback.
# shellcheck disable=SC2317,SC2329
sos_login_forward_stop() {
  for sos_login_stop_pid in \
    "$sos_login_agent_pid" \
    "$sos_login_authoring_pid" \
    "$sos_login_session_pid"; do
    [[ -z "$sos_login_stop_pid" ]] || kill -TERM "$sos_login_stop_pid" 2>/dev/null || true
  done
}
trap sos_login_cleanup EXIT
trap sos_login_forward_stop HUP INT TERM

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=SOS
export XDG_CURRENT_DESKTOP=SOS:GNOME
export DESKTOP_SESSION=sos
export LIBSEAT_BACKEND=logind
export SOS_ALLOW_SESSION_EXIT=1
export SOS_OUTPUT_CONFIG_FILE="$sos_login_output_config"
export SOS_ACCESSIBILITY_SOCKET="$sos_login_accessibility_socket"
export WAYLAND_DISPLAY="$sos_login_runtime/wayland-sos"
unset DISPLAY

systemd-inhibit \
  --what=idle:sleep:handle-lid-switch \
  --who="SOS graphical session" \
  --why="Keep the interactive SOS shell and remote development link available" \
  --mode=block \
  -- "$sos_login_session_bin" run-user \
  --root "$sos_login_revision_root" \
  --runtime-dir "$sos_login_runtime" \
  --authority-file "$sos_login_authority_file" \
  --shell-token-file "$sos_login_token_file" \
  --trusted-stock-revision "$sos_login_stock_revision" \
  --agent-socket "$sos_login_agent_socket" \
  --compositor "$sos_login_compositor_bin" \
  --provider "$sos_login_provider_bin" \
  --supervisor "$sos_login_supervisor_bin" \
  --host "$sos_login_host_bin" \
  --timeout-ms 30000 &
sos_login_session_pid=$!

sos_login_wait_for_socket() {
  local sos_login_wait_path="$1"
  local sos_login_wait_pid="$2"
  local sos_login_wait_name="$3"
  for _ in {1..3000}; do
    [[ -S "$sos_login_wait_path" ]] && return 0
    kill -0 "$sos_login_wait_pid" 2>/dev/null || \
      sos_login_fail "$sos_login_wait_name exited before creating $sos_login_wait_path"
    sleep 0.01
  done
  sos_login_fail "$sos_login_wait_name did not create $sos_login_wait_path"
}

sos_login_wait_for_socket "$sos_login_provider_socket" \
  "$sos_login_session_pid" "SOS provider"
sos_login_wait_for_socket "$sos_login_supervisor_socket" \
  "$sos_login_session_pid" "SOS supervisor"
command -v systemctl >/dev/null 2>&1 || sos_login_fail "systemctl is not installed"
systemctl --user import-environment \
  XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP DESKTOP_SESSION \
  WAYLAND_DISPLAY SOS_ACCESSIBILITY_SOCKET || \
  sos_login_fail "could not publish the SOS graphical-session environment"
systemctl --user start sos-session.target || \
  sos_login_fail "could not start sos-session.target"
sos_login_graphical_target_started=true

[[ -s "$sos_login_agent_config" ]] || \
  sos_login_fail "resident agent is not configured; run /usr/local/libexec/sos/sos-agent-login or sos-agent-login --offline"
[[ -x "$sos_login_authoring_bin" ]] || \
  sos_login_fail "missing agent authoring broker: $sos_login_authoring_bin"
[[ -r "$sos_login_agent_main" ]] || \
  sos_login_fail "missing resident agent: $sos_login_agent_main"
command -v node >/dev/null 2>&1 || sos_login_fail "Node.js is not installed"
unset SOS_AGENT_FAKE_SOURCE
set -a
# This file is written by sos-agent-login in the current user's private state directory.
# shellcheck source=/dev/null
source "$sos_login_agent_config"
set +a
[[ "${SOS_AGENT_PROVIDER:-}" == openai-codex ]] || \
  sos_login_fail "selectable-session agent config must use openai-codex"
[[ "${SOS_AGENT_MODEL:-}" =~ ^[A-Za-z0-9._:/-]+$ ]] || \
  sos_login_fail "agent config contains an invalid model ID"
sos_login_agent_arguments=()
if [[ -n "${SOS_AGENT_FAKE_SOURCE:-}" ]]; then
  [[ "$SOS_AGENT_FAKE_SOURCE" == /* && -r "$SOS_AGENT_FAKE_SOURCE" ]] || \
    sos_login_fail "configured offline source must be an absolute readable file"
  sos_login_agent_mode=offline
  sos_login_agent_arguments+=(--fake-source "$SOS_AGENT_FAKE_SOURCE")
else
  [[ -s "$sos_login_agent_credentials" ]] || \
    sos_login_fail "resident agent is not authenticated; run /usr/local/libexec/sos/sos-agent-login"
  sos_login_agent_mode=live
  sos_login_agent_arguments+=(--credentials "$sos_login_agent_credentials")
fi
printf 'sos_login_agent_mode mode=%s\n' "$sos_login_agent_mode"

"$sos_login_authoring_bin" \
  --root "$sos_login_revision_root" \
  --service-socket "$sos_login_provider_socket" \
  --supervisor-socket "$sos_login_supervisor_socket" \
  --listen-socket "$sos_login_agent_authoring_socket" \
  --agent-user "$(id -un)" \
  --timeout-ms 30000 &
sos_login_authoring_pid=$!
sos_login_wait_for_socket "$sos_login_agent_authoring_socket" \
  "$sos_login_authoring_pid" "SOS agent authoring broker"

node "$sos_login_agent_main" serve \
  --socket "$sos_login_agent_socket" \
  --authoring-socket "$sos_login_agent_authoring_socket" \
  --state "$sos_login_agent_state_dir/messages.json" \
  --api-doc /usr/share/doc/sos/experience-api.md \
  --example /usr/share/sos/experiences/default.luau \
  "${sos_login_agent_arguments[@]}" &
sos_login_agent_pid=$!
sos_login_wait_for_socket "$sos_login_agent_socket" \
  "$sos_login_agent_pid" "SOS resident agent"
printf 'sos_login_agent_started pid=%s socket=%s\n' \
  "$sos_login_agent_pid" "$sos_login_agent_socket"

set +e
sos_login_finished_pid=""
wait -n -p sos_login_finished_pid \
  "$sos_login_session_pid" "$sos_login_authoring_pid" "$sos_login_agent_pid"
sos_login_status=$?
if [[ "$sos_login_finished_pid" != "$sos_login_session_pid" ]]; then
  printf 'sos_login_session_failed component=background-agent pid=%s status=%s\n' \
    "$sos_login_finished_pid" "$sos_login_status" >&2
  [[ "$sos_login_status" -ne 0 ]] || sos_login_status=1
fi
set -e
exit "$sos_login_status"
