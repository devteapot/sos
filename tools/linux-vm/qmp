#!/usr/bin/env python3

import json
import os
import socket
import sys


def fail(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


if len(sys.argv) not in (2, 3):
    fail("usage: tools/linux-vm/qmp COMMAND [JSON-ARGUMENTS]")

command = sys.argv[1]
try:
    arguments = json.loads(sys.argv[2]) if len(sys.argv) == 3 else None
except json.JSONDecodeError as error:
    fail(f"invalid JSON arguments: {error}")
if arguments is not None and not isinstance(arguments, dict):
    fail("JSON arguments must be an object")

repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
cache_root = os.environ.get("SOS_LINUX_VM_ROOT", os.path.join(repo_root, ".cache", "linux-vm"))
name = os.environ.get("SOS_LINUX_VM_NAME", "sos-debian13")
qmp_path = os.path.join(cache_root, f"{name}-qmp.sock")
if not os.path.exists(qmp_path):
    fail(f"QMP socket does not exist: {qmp_path}")


def receive(file) -> dict:
    line = file.readline()
    if not line:
        fail("QMP connection closed")
    value = json.loads(line)
    while "event" in value:
        value = json.loads(file.readline())
    return value


with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
    client.settimeout(10)
    client.connect(qmp_path)
    file = client.makefile("rwb", buffering=0)
    greeting = receive(file)
    if "QMP" not in greeting:
        fail("QMP greeting was missing")
    file.write(b'{"execute":"qmp_capabilities"}\n')
    capability = receive(file)
    if "error" in capability:
        fail(json.dumps(capability["error"], sort_keys=True))
    request = {"execute": command}
    if arguments is not None:
        request["arguments"] = arguments
    file.write(json.dumps(request, separators=(",", ":")).encode() + b"\n")
    response = receive(file)
    print(json.dumps(response, sort_keys=True))
    if "error" in response:
        raise SystemExit(1)
