#!/usr/bin/env bash

set -euo pipefail

vm_tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
vm_repo_root="$(cd "$vm_tools_dir/../.." && pwd)"
vm_cache_root="${SOS_LINUX_VM_ROOT:-$vm_repo_root/.cache/linux-vm}"
vm_ssh_port="${SOS_LINUX_VM_SSH_PORT:-2222}"
vm_ssh_user="${SOS_LINUX_VM_SSH_USER:-sos}"
vm_guest_root="${SOS_LINUX_VM_GUEST_ROOT:-/home/$vm_ssh_user/sos}"
vm_ssh_key="${SOS_LINUX_VM_SSH_PRIVATE_KEY:-$vm_cache_root/id_ed25519}"
vm_destination="$vm_ssh_user@127.0.0.1"
vm_ssh_options=(
  -p "$vm_ssh_port"
  -o BatchMode=yes
  -o ConnectTimeout=5
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
)
if [[ -f "$vm_ssh_key" ]]; then
  vm_ssh_options+=(-i "$vm_ssh_key")
fi

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

for vm_command in rsync ssh; do
  command -v "$vm_command" >/dev/null 2>&1 || fail "required command not found: $vm_command"
done
[[ "$#" -eq 0 ]] || fail "usage: tools/linux-vm/verify-boot-session"
[[ "$vm_ssh_port" =~ ^[0-9]+$ ]] || fail "SSH port must be numeric"
[[ "$vm_guest_root" == /home/*/sos* ]] || \
  fail "guest worktree must be an explicit path below /home ending in an SOS directory"

vm_ssh() {
  # Arguments intentionally form the remote command after SSH has connected.
  # shellcheck disable=SC2029
  ssh "${vm_ssh_options[@]}" "$vm_destination" "$@"
}

wait_for_vm_down() {
  for _ in {1..90}; do
    if ! vm_ssh true >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done
  fail "VM did not disconnect for reboot"
}

wait_for_vm_up() {
  for _ in {1..240}; do
    if vm_ssh true >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done
  fail "VM did not return after reboot"
}

vm_cleanup_required=false
vm_cleanup_complete=false
cleanup_boot_gate() {
  local vm_status="$?"
  trap - EXIT INT TERM
  if [[ "$vm_cleanup_required" == true && "$vm_cleanup_complete" == false ]]; then
  set +e
    wait_for_vm_up
    vm_ssh 'bash -s' <<'REMOTE_CLEANUP'
set +e
sudo systemctl set-default graphical.target
sudo systemctl disable --now sos-agent.target
sudo systemctl stop sos-session.service
sudo systemctl enable seatd.service
sudo systemctl start seatd.service
sudo systemctl start gdm.service
sudo rm -f -- \
  /etc/systemd/system/sos-session.service \
  /etc/systemd/system/sos-session.target \
  /etc/systemd/system/sos-agent-authoring.service \
  /etc/systemd/system/sos-agent.service \
  /etc/systemd/system/sos-agent.target
sudo rm -r -- \
  /usr/local/libexec/sos \
  /usr/local/libexec/sos-agent \
  /usr/share/sos \
  /usr/share/doc/sos \
  /etc/sos \
  /var/lib/sos \
  /var/lib/sos-agent
for vm_user in sos-agent sos-host sos-supervisor sos-provider sos-compositor; do
  sudo userdel "$vm_user" 2>/dev/null || true
done
sudo gpasswd -d sos sos-ipc >/dev/null 2>&1 || true
sudo groupdel sos-ipc 2>/dev/null || true
sudo systemctl daemon-reload
REMOTE_CLEANUP
  fi
  exit "$vm_status"
}
trap cleanup_boot_gate EXIT INT TERM

vm_preflight="$(vm_ssh 'bash -s' <<'REMOTE_PREFLIGHT'
set -euo pipefail
systemd-detect-virt --quiet
source /etc/os-release
[[ "${ID:-}" == debian && "${VERSION_ID:-}" == 13 ]]
[[ "$(systemctl get-default)" == graphical.target ]]
systemctl is-active --quiet gdm.service
systemctl is-active --quiet seatd.service
[[ "$(systemctl is-enabled seatd.service)" == enabled ]]
for path in \
  /usr/local/libexec/sos \
  /usr/local/libexec/sos-agent \
  /usr/share/sos \
  /usr/share/doc/sos \
  /etc/sos \
  /var/lib/sos \
  /var/lib/sos-agent \
  /etc/systemd/system/sos-session.service \
  /etc/systemd/system/sos-session.target \
  /etc/systemd/system/sos-agent-authoring.service \
  /etc/systemd/system/sos-agent.service \
  /etc/systemd/system/sos-agent.target; do
  [[ ! -e "$path" ]]
done
for vm_user in sos-agent sos-host sos-supervisor sos-provider sos-compositor; do
  ! id "$vm_user" >/dev/null 2>&1
done
! getent group sos-ipc >/dev/null
printf 'os=%s version=%s kernel=%s\n' "$ID" "$VERSION_ID" "$(uname -r)"
REMOTE_PREFLIGHT
)" || fail "reference VM preflight failed or found pre-existing SOS boot-session state"
printf 'Preparing disposable SOS boot session (%s).\n' "$vm_preflight"

vm_ssh_transport="ssh -p $vm_ssh_port -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
if [[ -f "$vm_ssh_key" ]]; then
  vm_ssh_transport+=" -i $vm_ssh_key"
fi
rsync -a --delete \
