fi

# Exercise lifecycle behavior while the packaged, PAM/logind-owned compositor
# owns the seat.  The ARM virt machine has no platform wake source, so switch
# away from the compositor VT (the same libseat pause/activation boundary), run
# Linux's userspace freeze/resume test, and switch back before the unsupported
# final platform power stage. Device hotplug is exercised independently below;
# QEMU virtio-net does not resume from the deeper `pm_test=devices` level.
vm_lifecycle_main_before="$(vm_ssh 'bash -s' <<'REMOTE_LIFECYCLE_SUSPEND'
set -euo pipefail
vm_mem_sleep_before=""
switch_vt() {
  sudo python3 - "$1" <<'PY'
import fcntl
import os
import struct
import sys

VT_ACTIVATE = 0x5606
VT_WAITACTIVE = 0x5607
fd = os.open("/dev/tty0", os.O_RDWR | os.O_CLOEXEC)
try:
    number = int(sys.argv[1])
    fcntl.ioctl(fd, VT_ACTIVATE, number)
    fcntl.ioctl(fd, VT_WAITACTIVE, number)
finally:
    os.close(fd)
PY
}
restore_lifecycle_state() {
  set +e
  sudo sh -c 'echo none > /sys/power/pm_test; echo on > /sys/class/drm/card0-Virtual-1/status; echo off > /sys/class/drm/card0-Virtual-2/status; echo change > /sys/class/drm/card0/uevent'
  if [[ -n "$vm_mem_sleep_before" ]]; then
    printf '%s\n' "$vm_mem_sleep_before" | sudo tee /sys/power/mem_sleep >/dev/null
  fi
  switch_vt 1
}
trap restore_lifecycle_state EXIT
for _ in {1..3000}; do
  if systemctl is-active --quiet sos-session.service \
    && sudo journalctl -b -t sos-linux-session --no-pager -n 240 \
      | grep 'linux_system_session_ready.*evidence=drm_page_flip' >/dev/null; then
    break
  fi
  sleep 0.02
done
systemctl is-active --quiet sos-session.service
vm_main_before="$(systemctl show sos-session.service -p MainPID --value)"
