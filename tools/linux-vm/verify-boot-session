fi
[[ "$(accessibility_call '{"method":"action","kind":"activate","target":"agent-overlay-bubble"}' | jq -r '.ok')" == true ]]
for _ in {1..500}; do
  if accessibility_call '{"method":"snapshot"}' \
    | jq -e 'any(.snapshot.nodes[]; .id == "panel-agent-prompt" and .editable)' >/dev/null; then
    break
  fi
  sleep 0.02
done
accessibility_call '{"method":"snapshot"}' \
  | jq -e 'any(.snapshot.nodes[]; .id == "panel-agent-prompt" and .editable)' >/dev/null
[[ "$(accessibility_call '{"method":"action","kind":"set_value","target":"panel-agent-prompt","value":"Make Stock calmer"}' | jq -r '.ok')" == true ]]
for _ in {1..500}; do
  if accessibility_call '{"method":"snapshot"}' \
    | jq -e 'any(.snapshot.nodes[]; .id == "panel-agent-prompt" and .value == "Make Stock calmer")' >/dev/null; then
    break
  fi
  sleep 0.02
done
accessibility_call '{"method":"snapshot"}' \
  | jq -e 'any(.snapshot.nodes[]; .id == "panel-agent-prompt" and .value == "Make Stock calmer")' >/dev/null
[[ "$(accessibility_call '{"method":"action","kind":"submit","target":"panel-agent-prompt"}' | jq -r '.ok')" == true ]]
for _ in {1..3000}; do
  vm_after_status="$(sudo -u sos-supervisor "$vm_bin_dir/sos-revision-supervisor" daemon-status \
    --root "$vm_revision_root")"
  vm_after_revision="$(jq -er '.active_revision' <<<"$vm_after_status")"
  [[ "$vm_after_revision" != "$vm_before_revision" ]] && break
  sleep 0.02
done
vm_after_status="$(sudo -u sos-supervisor "$vm_bin_dir/sos-revision-supervisor" daemon-status \
  --root "$vm_revision_root")"
vm_after_revision="$(jq -er '.active_revision' <<<"$vm_after_status")"
vm_after_host="$(jq -er '.host_pid' <<<"$vm_after_status")"
vm_after_graph="$(sudo -u sos-supervisor "$vm_bin_dir/sos-revision-supervisor" graph-status \
  --root "$vm_revision_root" --experience sos.stock.shell)"
[[ "$vm_after_revision" =~ ^[0-9a-f]{64}$ ]]
[[ "$vm_after_revision" != "$vm_before_revision" ]]
[[ "$vm_after_graph" =~ ^[0-9a-f]{64}$ ]]
[[ "$vm_after_host" == "$vm_before_host" ]]
vm_agent_pid="$(systemctl show sos-agent.service -p MainPID --value)"
vm_broker_pid="$(systemctl show sos-agent-authoring.service -p MainPID --value)"
[[ "$(ps -o user= -p "$vm_agent_pid" | xargs)" == sos-agent ]]
[[ "$(ps -o user= -p "$vm_broker_pid" | xargs)" == sos-supervisor ]]
for vm_tool in get_experience_context validate_experience submit_experience; do
  sudo journalctl -b -t sos-linux-session --no-pager \
    | grep "sos_agent_tool_started name=$vm_tool" >/dev/null
done
sudo journalctl -b -t sos-linux-session --no-pager \
  | grep "presented armed shell revision.*revision_id=\"$vm_after_graph\".*evidence=\"drm_page_flip\"" >/dev/null
for _ in {1..1000}; do
  if accessibility_call '{"method":"snapshot"}' \
    | jq -e 'any(.snapshot.nodes[]; .id == "agent-status" and .value == "Ready") and any(.snapshot.nodes[]; .label == "SOS message" and (.value | contains("candidate experience is active")))' >/dev/null; then
    break
  fi
  sleep 0.02
done
vm_agent_final_snapshot="$(accessibility_call '{"method":"snapshot"}')"
if ! jq -e 'any(.snapshot.nodes[]; .id == "agent-status" and .value == "Ready") and any(.snapshot.nodes[]; .label == "SOS message" and (.value | contains("candidate experience is active")))' \
  <<<"$vm_agent_final_snapshot" >/dev/null; then
  printf 'agent completion missing from semantic snapshot: %s\n' "$vm_agent_final_snapshot" >&2
  sudo journalctl -b -t sos-linux-session --no-pager \
