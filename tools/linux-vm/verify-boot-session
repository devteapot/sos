done
sudo sh -c 'umask 077; od -An -N32 -tx1 /dev/urandom | tr -d " \n" > /etc/sos/shell-token'
sudo chown root:root /etc/sos/shell-token
sudo chmod 0400 /etc/sos/shell-token
sudo sh -c 'umask 027; od -An -N32 -tx1 /dev/urandom | tr -d " \n" > /var/lib/sos/grant-review.capability'
sudo chown sos-compositor:sos-ipc /var/lib/sos/grant-review.capability
sudo chmod 0640 /var/lib/sos/grant-review.capability
sudo sh -c 'umask 027; od -An -N32 -tx1 /dev/urandom | tr -d " \n" > /var/lib/sos/appearance-write.capability'
sudo chown sos-compositor:sos-ipc /var/lib/sos/appearance-write.capability
sudo chmod 0640 /var/lib/sos/appearance-write.capability
sudo sh -c 'printf "%s\n" \
  "SOS_AGENT_PROVIDER=openai-codex" \
  "SOS_AGENT_MODEL=gpt-5.6-sol" \
  "SOS_AGENT_FAKE_SOURCE=/usr/share/sos/experiences/stock-agent-variant.luau" \
  > /etc/sos/agent.env'
sudo chown root:root /etc/sos/agent.env
sudo chmod 0444 /etc/sos/agent.env
sudo install -d -o sos-compositor -g sos-ipc -m 0750 /var/lib/sos
sudo install -d -o sos-supervisor -g sos-ipc -m 0750 /var/lib/sos/revisions
sudo install -d -o sos-supervisor -g sos-ipc -m 0750 /var/lib/sos/staging
sudo install -o sos-supervisor -g sos-ipc -m 0640 \
  "$vm_guest_root/experiences/default.luau" /var/lib/sos/staging/default.luau
sudo install -o sos-supervisor -g sos-ipc -m 0640 \
  "$vm_guest_root/experiences/default.package.json" /var/lib/sos/staging/default.package.json
sudo install -o sos-supervisor -g sos-ipc -m 0640 \
  "$vm_guest_root/experiences/stock-workspace.luau" \
  /var/lib/sos/staging/stock-workspace.luau
sudo install -o sos-supervisor -g sos-ipc -m 0640 \
  "$vm_guest_root/experiences/stock-workspace.package.json" \
  /var/lib/sos/staging/stock-workspace.package.json
sudo install -o sos-supervisor -g sos-ipc -m 0640 \
  "$vm_guest_root/experiences/modules/stock-theme.luau" /var/lib/sos/staging/stock-theme.luau
sudo install -o sos-supervisor -g sos-ipc -m 0640 \
  "$vm_guest_root/tests/fixtures/empty-state.json" /var/lib/sos/staging/empty-state.json
vm_workspace_revision="$(sudo -u sos-supervisor "$vm_bin_dir/sos-revision-supervisor" install-package \
  --root /var/lib/sos/revisions \
  --source /var/lib/sos/staging/stock-workspace.luau \
  --state /var/lib/sos/staging/empty-state.json \
  --schema 1 \
  --package /var/lib/sos/staging/stock-workspace.package.json \
  --asset stock.theme:luau:/var/lib/sos/staging/stock-theme.luau)"
sudo -u sos-supervisor grep -Eq \
  "\"revision_id\"[[:space:]]*:[[:space:]]*\"$vm_workspace_revision\"" \
  /var/lib/sos/staging/default.package.json
vm_revision="$(sudo -u sos-supervisor "$vm_bin_dir/sos-revision-supervisor" install-package \
  --root /var/lib/sos/revisions \
  --source /var/lib/sos/staging/default.luau \
  --state /var/lib/sos/staging/empty-state.json \
  --schema 1 \
  --package /var/lib/sos/staging/default.package.json \
  --asset stock.theme:luau:/var/lib/sos/staging/stock-theme.luau)"
sudo -u sos-supervisor "$vm_bin_dir/sos-revision-supervisor" bootstrap-graph \
  --root /var/lib/sos/revisions \
  --experience sos.stock.shell \
  --revision "$vm_revision" >/dev/null
sudo sh -c 'printf "%s\n" \
  "SOS_TRUSTED_STOCK_REVISION=$1" \
  "SOS_TRUSTED_STOCK_WORKSPACE_REVISION=$2" \
  > /var/lib/sos/trusted-revisions.env' \
  sh "$vm_revision" "$vm_workspace_revision"
sudo chown root:root /var/lib/sos/trusted-revisions.env
sudo chmod 0644 /var/lib/sos/trusted-revisions.env
sudo systemctl daemon-reload
sudo systemd-analyze verify \
  /etc/systemd/system/sos-session.service \
  /etc/systemd/system/sos-session.target \
  /etc/systemd/system/sos-agent-authoring.service \
  /etc/systemd/system/sos-agent.service \
  /etc/systemd/system/sos-agent.target
sudo systemctl enable sos-agent.target
sudo systemctl disable --now seatd.service
sudo systemctl set-default sos-session.target
printf 'boot_revision=%s api_version=4\n' "$vm_revision"
REMOTE_INSTALL

printf 'Rebooting into sos-session.target; SSH is used only as the test controller.\n'
vm_ssh 'sudo systemctl reboot' >/dev/null 2>&1 || true
wait_for_vm_down
wait_for_vm_up

if [[ "${SOS_BOOT_GATE_SKIP_AGENT:-0}" != 1 ]]; then
vm_agent_evidence="$(vm_ssh 'bash -s' <<'REMOTE_AGENT'
set -euo pipefail
vm_bin_dir=/usr/local/libexec/sos
vm_revision_root=/var/lib/sos/revisions
for _ in {1..3000}; do
  if systemctl is-active --quiet sos-session.service \
    && systemctl is-active --quiet sos-agent-authoring.service \
    && systemctl is-active --quiet sos-agent.service \
    && [[ -S /run/sos-agent/agent.sock ]] \
    && [[ -S /run/sos/accessibility.sock ]] \
    && [[ -S "$vm_revision_root/run/supervisor.sock" ]] \
    && sudo journalctl -b -t sos-linux-session --no-pager -n 240 \
      | grep 'linux_system_session_ready.*evidence=drm_page_flip' >/dev/null; then
    break
  fi
  sleep 0.02
done
systemctl is-active --quiet sos-session.service
systemctl is-active --quiet sos-agent-authoring.service
systemctl is-active --quiet sos-agent.service
[[ -S /run/sos-agent/agent.sock ]]
[[ -S /run/sos/accessibility.sock ]]
[[ -S "$vm_revision_root/run/supervisor.sock" ]]
accessibility_call() {
  python3 - /run/sos/accessibility.sock "$1" <<'PY'
import socket
import sys

client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
client.connect(sys.argv[1])
client.sendall(sys.argv[2].encode() + b"\n")
response = bytearray()
while not response.endswith(b"\n"):
    chunk = client.recv(65536)
    if not chunk:
        break
    response.extend(chunk)
sys.stdout.write(response.decode())
PY
}
vm_before_status="$(sudo -u sos-supervisor "$vm_bin_dir/sos-revision-supervisor" daemon-status \
  --root "$vm_revision_root")"
vm_before_revision="$(jq -er '.active_revision' <<<"$vm_before_status")"
vm_before_host="$(jq -er '.host_pid' <<<"$vm_before_status")"
vm_agent_snapshot="$(accessibility_call '{"method":"snapshot"}')"
if ! jq -e '.ok and any(.snapshot.nodes[]; .id == "agent-overlay-bubble" and .activate)' \
  <<<"$vm_agent_snapshot" >/dev/null; then
  printf 'agent launcher missing from semantic snapshot: %s\n' "$vm_agent_snapshot" >&2
