#!/usr/bin/env bash

set -euo pipefail

test_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d -t sos-agent-e2e.XXXXXX)"
test_revision_root="$test_root/revisions"
test_provider_socket="$test_root/provider.sock"
test_supervisor_socket="$test_revision_root/run/supervisor.sock"
test_authoring_socket="$test_root/authoring.sock"
test_agent_socket="$test_root/agent.sock"
test_authority_file="$test_root/authority.json"
test_grant_capability_file="$test_root/grant-review.capability"
test_empty_state="$test_repo_root/tests/fixtures/empty-state.json"
test_agent_package="$test_repo_root/services/sos-agent"
test_bin_root="$test_repo_root/target/debug"

test_provider_pid=""
test_supervisor_pid=""
test_broker_pid=""
test_agent_pid=""

cleanup() {
  local status="$?"
  trap - EXIT INT TERM
  if [[ "$status" -ne 0 ]]; then
    for test_log in provider.log supervisor.log authoring.log agent.log; do
      if [[ -s "$test_root/$test_log" ]]; then
        printf '%s\n' "==> $test_log" >&2
        sed -n '1,240p' "$test_root/$test_log" >&2
      fi
    done
  fi
  [[ -z "$test_agent_pid" ]] || kill "$test_agent_pid" 2>/dev/null || true
  [[ -z "$test_broker_pid" ]] || kill "$test_broker_pid" 2>/dev/null || true
  if [[ -n "$test_supervisor_pid" && -S "$test_supervisor_socket" ]]; then
    "$test_bin_root/sos-revision-supervisor" shutdown --root "$test_revision_root" \
      >/dev/null 2>&1 || true
  fi
  if [[ -n "$test_provider_pid" && -S "$test_provider_socket" ]]; then
    "$test_bin_root/sos-linux-session" shutdown --service-socket "$test_provider_socket" \
      >/dev/null 2>&1 || true
  fi
  for process_id in "$test_agent_pid" "$test_broker_pid" "$test_supervisor_pid" "$test_provider_pid"; do
    [[ -z "$process_id" ]] || wait "$process_id" 2>/dev/null || true
  done
  if [[ "$test_root" == /tmp/sos-agent-e2e.* ]]; then
    chmod -R u+w -- "$test_root" 2>/dev/null || true
    rm -r -- "$test_root"
  fi
  exit "$status"
}
trap cleanup EXIT INT TERM

wait_for_socket() {
  local socket_path="$1"
  local process_id="$2"
  local process_name="$3"
  for _ in {1..500}; do
    [[ -S "$socket_path" ]] && return
    kill -0 "$process_id" 2>/dev/null || {
      wait "$process_id" || true
      printf 'error: %s exited before creating %s\n' "$process_name" "$socket_path" >&2
      exit 1
    }
    sleep 0.01
  done
  printf 'error: %s did not create %s\n' "$process_name" "$socket_path" >&2
  exit 1
}

printf '==> building deterministic SOS + Pi e2e gate\n'
(
  cd "$test_repo_root"
  cargo build --locked \
    -p revision-supervisor --bin sos-revision-supervisor --bin supervisor-test-host \
    -p provider-state-service --bin sos-provider-state-service \
    -p sos-linux-session --bin sos-linux-session --bin sos-agent-authoring
)
(
  cd "$test_agent_package"
  npm ci --ignore-scripts
  npm run build
)

mkdir -p "$test_revision_root"
test_workspace_revision="$("$test_bin_root/sos-revision-supervisor" install-package \
  --root "$test_revision_root" \
  --source "$test_repo_root/experiences/stock-workspace.luau" \
  --state "$test_empty_state" \
  --schema 1 \
  --package "$test_repo_root/experiences/stock-workspace.package.json" \
  --asset "stock.theme:luau:$test_repo_root/experiences/modules/stock-theme.luau")"
grep -Eq "\"revision_id\"[[:space:]]*:[[:space:]]*\"$test_workspace_revision\"" \
  "$test_repo_root/experiences/default.package.json"
test_initial_revision="$("$test_bin_root/sos-revision-supervisor" install-package \
  --root "$test_revision_root" \
  --source "$test_repo_root/experiences/default.luau" \
  --state "$test_empty_state" \
  --schema 1 \
  --package "$test_repo_root/experiences/default.package.json" \
  --asset "stock.theme:luau:$test_repo_root/experiences/modules/stock-theme.luau")"
"$test_bin_root/sos-revision-supervisor" bootstrap-graph \
  --root "$test_revision_root" \
  --experience sos.stock.shell \
  --revision "$test_initial_revision" >/dev/null

printf '%064d' 0 >"$test_grant_capability_file"
chmod 0600 "$test_grant_capability_file"
"$test_bin_root/sos-provider-state-service" \
  --socket "$test_provider_socket" \
  --grant-capability-file "$test_grant_capability_file" \
  --state-file "$test_authority_file" >"$test_root/provider.log" 2>&1 &
test_provider_pid=$!
wait_for_socket "$test_provider_socket" "$test_provider_pid" "provider authority"
"$test_bin_root/sos-linux-session" bootstrap-graph \
  --root "$test_revision_root" \
  --experience sos.stock.shell \
  --service-socket "$test_provider_socket" >/dev/null
"$test_bin_root/sos-linux-session" review-graph-grants \
  --root "$test_revision_root" \
  --experience sos.stock.shell \
  --revision "$test_initial_revision" \
  --service-socket "$test_provider_socket" \
  --capability-file "$test_grant_capability_file" >/dev/null
"$test_bin_root/sos-linux-session" review-grants \
  --root "$test_revision_root" \
  --revision "$test_workspace_revision" \
  --service-socket "$test_provider_socket" \
  --capability-file "$test_grant_capability_file" >/dev/null

"$test_bin_root/sos-revision-supervisor" serve \
  --root "$test_revision_root" \
  --host-executable "$test_bin_root/supervisor-test-host" \
  --service-socket "$test_provider_socket" \
  --root-experience sos.stock.shell \
  --timeout-ms 5000 >"$test_root/supervisor.log" 2>&1 &
test_supervisor_pid=$!
wait_for_socket "$test_supervisor_socket" "$test_supervisor_pid" "revision supervisor"

"$test_bin_root/sos-agent-authoring" \
  --root "$test_revision_root" \
  --service-socket "$test_provider_socket" \
  --supervisor-socket "$test_supervisor_socket" \
  --listen-socket "$test_authoring_socket" \
  --agent-user "$(id -un)" \
  --timeout-ms 5000 >"$test_root/authoring.log" 2>&1 &
test_broker_pid=$!
wait_for_socket "$test_authoring_socket" "$test_broker_pid" "authoring broker"

node "$test_agent_package/dist/agent-runner.cjs" serve \
  --socket "$test_agent_socket" \
  --authoring-socket "$test_authoring_socket" \
  --api-doc "$test_repo_root/docs/experience-api.md" \
  --example "$test_repo_root/experiences/default.luau" \
  --fake-source "$test_repo_root/tests/fixtures/stock-authoring-v4.luau" \
  >"$test_root/agent.log" 2>&1 &
test_agent_pid=$!
wait_for_socket "$test_agent_socket" "$test_agent_pid" "Pi agent"

printf '==> prompting Pi faux provider through the public agent socket\n'
node "$test_agent_package/dist/agent-runner.cjs" prompt \
  --socket "$test_agent_socket" \
  --request "Turn this into a compact timeline"

test_status="$("$test_bin_root/sos-revision-supervisor" daemon-status --root "$test_revision_root")"
test_active_revision="$(printf '%s' "$test_status" | sed -n 's/.*"active_revision":"\([0-9a-f]*\)".*/\1/p')"
[[ -n "$test_active_revision" ]]
[[ "$test_active_revision" != "$test_initial_revision" ]]

printf 'linux_agent_e2e_complete initial_revision=%s active_revision=%s\n' \
  "$test_initial_revision" "$test_active_revision"
