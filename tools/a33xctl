  grep -F 'ro.build.version.incremental' "$product_contract" >/dev/null && \
    grep -F '"ro.sos.build_variant"' "$product_contract" >/dev/null && \
    grep -F '"core1-dev-credential"' "$product_contract" >/dev/null && \
    grep -F '"ro.sos.dev_credential"' "$product_contract" >/dev/null && \
    grep -F '"ro.build.type"' "$product_contract" >/dev/null && \
    grep -F '"ro.debuggable"' "$product_contract" >/dev/null && \
    grep -F 'expected: "0"' "$product_contract" >/dev/null || \
    fail "Core development endpoint lacks its exact runtime product gates"
  ! grep -F 'property_is("ro.debuggable", "1")' \
