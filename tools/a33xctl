    "$properties" "$file_contexts" "$system_ext_policy" "$authority" \
    "$authority_init_rc" \
    "$bootstrap" "$bootstrap_package" "$stock_theme" \
    "$system_ui" "$launcher"; do
    [[ -f "$artifact" ]] || fail "SOS Core shadow-stage artifact missing: $artifact"
    stat --printf='%n %s bytes\n' "$artifact"
    sha256sum "$artifact"
  done
  [[ ! -e "$target_files/SYSTEM_EXT/priv-app/SosShell/SosShell.apk" ]] || \
    fail "SOS Core must not package the Android Activity shell"
  file "$probe" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS Core surface probe is not AArch64"
  file "$host" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS Core native host is not AArch64"
  file "$host_runtime" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS Core GPUI runtime is not AArch64"
  strings "$host_runtime" | grep -F \
    'SOS experience window is live frame_padding=none' >/dev/null || \
    fail "SOS Core GPUI runtime still reserves Android-style frame bands"
  grep -F 'libgui.so' <(readelf -d "$probe") >/dev/null || \
    fail "SOS Core surface probe does not link the native SurfaceComposer client"
  grep -F 'libgui.so' <(readelf -d "$host") >/dev/null || \
    fail "SOS Core host does not link the native SurfaceComposer client"
  strings "$host" | grep -F 'native_supervisor_ready child=' >/dev/null || \
    fail "SOS Core host does not contain the fixed native supervisor"
  strings "$host" | grep -F 'fixed_recovery_ready child_status=' >/dev/null || \
    fail "SOS Core host does not contain the fixed native recovery surface"
  strings "$host" | grep -F 'native_fault_injected child=' >/dev/null || \
    fail "SOS Core host does not contain the physical fault-injection gate"
  strings "$host" | grep -F 'native_core_deferred reason=user_ce_locked' >/dev/null || \
    fail "SOS Core host does not preserve Android's trusted pre-unlock boundary"
  strings "$host" | grep -F \
    'fixed_recovery_keys_unavailable action=android' >/dev/null || \
    fail "SOS Core fixed recovery does not fail safely when hardware keys are unavailable"
  strings "$host" | grep -F 'fixed_recovery_key_grab_failed error=' >/dev/null || \
    fail "SOS Core fixed recovery does not exclusively acquire its volume keys"
  readelf -Ws "$host_runtime" | grep -F ' sos_core_main' >/dev/null || \
    fail "SOS Core GPUI runtime does not export sos_core_main"
  readelf -Ws "$host_runtime" | awk \
    '$8 == "android_main" && $7 != "UND" { found = 1 } END { exit !found }' || \
    fail "SOS Core GPUI runtime cannot satisfy NativeActivity glue at load time"
  strings "$host_runtime" | grep -F \
    'core_input_ready device=sec_touchscreen mode=exclusive protocol=mt-slot+btn_touch' >/dev/null || \
    fail "SOS Core GPUI runtime does not own the Samsung touchscreen with BTN_TOUCH fallback"
  strings "$host_runtime" | grep -F 'core_input_tsp_enabled path=' >/dev/null || \
    fail "SOS Core GPUI runtime omitted Samsung TSP enable"
  strings "$host_runtime" | grep -F \
    'core_input_ready device=gpio_keys mode=exclusive' >/dev/null || \
    fail "SOS Core GPUI runtime does not exclusively own its volume keys"
  strings "$host_runtime" | grep -F \
    'core_input_ready device=sec-pmic-key mode=observe owner=android-power' >/dev/null || \
    fail "SOS Core GPUI runtime does not preserve Android display-power ownership"
  grep -Fx '    disabled' "$init_rc" >/dev/null || \
    fail "SOS Core surface probe must remain manually started"
  grep -Fx '    gentle_kill' "$init_rc" >/dev/null || \
    fail "SOS Core surface probe must receive SIGTERM before forced cleanup"
  grep -Fx 'on property:debug.sos.core.surface_probe=1' "$init_rc" >/dev/null || \
    fail "SOS Core surface probe is missing its manual start trigger"
  grep -Fx 'on property:debug.sos.core.surface_probe=0' "$init_rc" >/dev/null || \
    fail "SOS Core surface probe is missing its manual stop trigger"
  grep -Fx '    disabled' "$host_init_rc" >/dev/null || \
    fail "SOS Core GPUI host must remain manually started in Core shadow"
  grep -Fx '    gentle_kill' "$host_init_rc" >/dev/null || \
    fail "SOS Core GPUI host must receive SIGTERM before forced cleanup"
  grep -Fx 'on property:debug.sos.core.host=1' "$host_init_rc" >/dev/null || \
    fail "SOS Core GPUI host is missing its manual start trigger"
  grep -Fx 'on property:debug.sos.core.host=0' "$host_init_rc" >/dev/null || \
    fail "SOS Core GPUI host is missing its manual stop trigger"
  grep -Fx 'ro.sos.authority=on-device' "$properties"
  grep -Fx 'ro.sos.profile=core' "$properties"
  grep -Fx 'ro.sos.ui_owner=android-shadow' "$properties"
  cmp -s "$bootstrap" "$SOS_ROOT/experiences/mobile.luau" || \
    fail "SOS Core shadow bootstrap differs from the Stock Mobile source"
  cmp -s "$bootstrap_package" "$SOS_ROOT/experiences/mobile.package.json" || \
    fail "SOS Core v4 manifest differs from the repository source"
  cmp -s "$stock_theme" "$SOS_ROOT/experiences/modules/mobile-theme.luau" || \
    fail "SOS Core Stock Mobile theme differs from the repository source"
  [[ ! -e "$target_files/SYSTEM_EXT/etc/sos/default.luau" && \
    ! -e "$target_files/SYSTEM_EXT/etc/sos/default.package.json" && \
    ! -e "$target_files/SYSTEM_EXT/etc/sos/modules/stock-theme.luau" ]] || \
    fail "SOS Core shadow retained the Linux Stock Shell bootstrap"
  check_android_stock_mobile "$bootstrap" "$bootstrap_package" "$stock_theme"
  check_android_composition_authority "$authority" "$authority_init_rc"
  grep -Fx 'ro.sos.revision_format=4' "$properties"
  grep -Fx 'ro.sos.experience_api=4' "$properties"
  grep -E '^ro\.system_ext\.build\.version\.incremental=sos\.shadow\.[0-9a-f]{12}\.[0-9a-f]{12}$' \
    "$properties" || fail "SOS Core build does not carry a content-derived fingerprint"
  grep -Fx \
    '/system_ext/bin/sos-core-surface-probe      u:object_r:sos_core_surface_probe_exec:s0' \
    "$file_contexts"
  grep -Fx \
    '/system_ext/bin/sos-core-host               u:object_r:sos_core_host_exec:s0' \
    "$file_contexts"
  grep -F \
    '(genfscon sysfs "/devices/platform/11a70000.scsc_wifibt/net"' \
    "$system_ext_policy" >/dev/null || \
    fail "SOS Core policy does not narrowly label the physical Wi-Fi net subtree"
  info "SOS Core GPUI shadow-stage target-files gate passed; Android recovery UI is intentionally retained"
}

inspect_core_stage() {
  [[ "$#" -eq 1 ]] || fail "internal usage: inspect_core_stage <core0b|core1>"
  local stage="$1" target_product expected_stage expected_owner expected_lifecycle bridge no_zygote
  case "$stage" in
    core0b)
      target_product=lineage_sos_core0b_a33x
      expected_stage=0b
      expected_owner=native-sos-headless-framework
      expected_lifecycle=legacy
      bridge=present
      no_zygote=false
      ;;
    core1)
      target_product=lineage_sos_core1_a33x
      expected_stage=1
      expected_owner=native-sos-no-zygote
      expected_lifecycle=active
      bridge=absent
      no_zygote=true
      ;;
    *) fail "unsupported SOS Core stage: $stage" ;;
  esac

  inspect_rom "$target_product"
  local target_files="$LINEAGE_ROOT/out/target/product/a33x/obj/PACKAGING/target_files_intermediates/${target_product}-target_files"
  local host="$target_files/SYSTEM_EXT/bin/sos-core-host"
  local host_runtime="$target_files/SYSTEM_EXT/lib64/libsos_core_experience.so"
  local host_init_rc="$target_files/SYSTEM_EXT/etc/init/sos-core-host.rc"
  local properties="$target_files/SYSTEM_EXT/etc/build.prop"
  local authority="$target_files/SYSTEM_EXT/bin/sos-authority"
  local authority_init_rc="$target_files/SYSTEM_EXT/etc/init/sos-authority.rc"
  local node="$target_files/SYSTEM_EXT/bin/sos-node"
  local agent_runner="$target_files/SYSTEM_EXT/etc/sos-agent/agent-runner.cjs"
  local agent_api="$target_files/SYSTEM_EXT/etc/sos-agent/experience-api.md"
  local agent_example_primary="$target_files/SYSTEM_EXT/etc/sos-agent/example-primary.luau"
  local bootstrap="$target_files/SYSTEM_EXT/etc/sos/mobile.luau"
  local bootstrap_package="$target_files/SYSTEM_EXT/etc/sos/mobile.package.json"
  local stock_theme="$target_files/SYSTEM_EXT/etc/sos/modules/mobile-theme.luau"
  local system_ext_policy="$target_files/SYSTEM_EXT/etc/selinux/system_ext_sepolicy.cil"
  local bridge_apk="$target_files/SYSTEM_EXT/priv-app/SosFrameworkBridge/SosFrameworkBridge.apk"
  local core_platform="$target_files/SYSTEM_EXT/bin/sos-core-platform"
  local core_platform_rc="$target_files/SYSTEM_EXT/etc/init/sos-core-platform.rc"
  local core_app_manifest="$target_files/SYSTEM_EXT/etc/sos/core-apps.json"
  local marker="$target_files/SYSTEM_EXT/bin/sos-ui-removal-marker"
  local compat_marker="$target_files/SYSTEM_EXT/bin/sos-compat-ui-removal-marker"
  local artifact
  for artifact in \
    "$host" "$host_runtime" "$host_init_rc" "$properties" "$authority" \
    "$authority_init_rc" \
    "$node" "$agent_runner" "$agent_api" "$agent_example_primary" \
    "$bootstrap" "$bootstrap_package" "$stock_theme" \
    "$system_ext_policy"; do
    [[ -f "$artifact" ]] || fail "SOS $stage artifact missing: $artifact"
    stat --printf='%n %s bytes\n' "$artifact"
    sha256sum "$artifact"
  done
  [[ ! -e "$target_files/SYSTEM_EXT/priv-app/SosShell/SosShell.apk" ]] || \
    fail "SOS Core must not package the Android Activity shell"
  file "$host" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS $stage native host is not AArch64"
  file "$host_runtime" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS $stage GPUI runtime is not AArch64"
  strings "$host_runtime" | grep -F \
    'SOS experience window is live frame_padding=none' >/dev/null || \
    fail "SOS $stage GPUI runtime still reserves Android-style frame bands"
  check_android_v4_system_controls "$host_runtime"
  readelf -Ws "$host_runtime" | grep -F ' sos_core_main' >/dev/null || \
    fail "SOS $stage GPUI runtime does not export sos_core_main"
  strings "$host_runtime" | grep -F \
    'core_input_ready device=sec_touchscreen mode=exclusive protocol=mt-slot+btn_touch' >/dev/null || \
    fail "SOS $stage GPUI runtime omitted Samsung BTN_TOUCH fallback"
  strings "$host_runtime" | grep -F 'core_input_tsp_enabled path=' >/dev/null || \
    fail "SOS $stage GPUI runtime omitted Samsung TSP enable"
  strings "$host_runtime" | grep -F 'core_input_tsp_cycled device=' >/dev/null || \
    fail "SOS $stage GPUI runtime omitted Samsung TSP open/close start"
  strings "$host_runtime" | grep -F 'core_native_software_keyboard node=' >/dev/null || \
    fail "SOS $stage GPUI runtime omitted the Core software keyboard"
  file "$authority" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS $stage revision authority is not AArch64"
  strings "$authority" | grep -F 'core_revision=' >/dev/null || \
    fail "SOS $stage authority omitted its Core-local listener"
  strings "$authority" | grep -F 'core_provider=' >/dev/null || \
    fail "SOS $stage authority omitted its Core-local provider listener"
  strings "$authority" | grep -F '/data/misc/sos/provider.sock' >/dev/null || \
    fail "SOS $stage authority omitted the Core-local provider socket path"
  strings "$authority" | grep -F '/data/misc/sos/revision.sock' >/dev/null || \
    fail "SOS $stage authority omitted the Core-local revision socket path"
  strings "$host_runtime" | grep -F '/data/misc/sos/provider.sock' >/dev/null || \
    fail "SOS $stage GPUI provider still depends on Android loopback networking"
  strings "$host_runtime" | grep -F '/data/misc/sos/revision.sock' >/dev/null || \
    fail "SOS $stage GPUI runtime still depends on Android loopback networking"
  strings "$host_runtime" | grep -F \
    '/system_ext/etc/sos-agent/agent-runner.cjs' >/dev/null || \
    fail "SOS $stage GPUI runtime omitted the shared Pi runner boundary"
  strings "$host_runtime" | grep -F -- '--jitless' >/dev/null || \
    fail "SOS $stage GPUI runtime does not disable Pi runner executable memory"
  check_core_runtime_model_contract "$host_runtime"
  for agent_marker in \
    'android_agent_effect_dispatch action=' \
    'android_agent_thread_start provider=' \
    'android_agent_request_start provider=' \
    'android_agent_child_start pid=' \
    'android_agent_child_exit code=' \
    'android_agent_child_response type=' \
    'android_agent_failure stage='; do
    strings "$host_runtime" | grep -F "$agent_marker" >/dev/null || \
      fail "SOS $stage GPUI runtime omitted sanitized agent lifecycle marker: $agent_marker"
  done
  for agent_marker in \
    'android_agent_action_sequence_verified provider=' \
    'android_agent_action_verified ordinal=' \
    'android_agent_candidate_validation_ack request_id=' \
    'android_agent_activation_stage_ack request_id=' \
    'android_agent_activation_commit request_id='; do
    strings "$host_runtime" | grep -F "$agent_marker" >/dev/null || \
      fail "SOS $stage GPUI runtime omitted authoritative agent evidence marker: $agent_marker"
  done
  strings "$host_runtime" | grep -F \
    'core_agent_credential_ceremony state=opened provider=openrouter model=' >/dev/null || \
    fail "SOS $stage GPUI runtime omitted the trusted native credential ceremony"
  strings "$host_runtime" | grep -F \
    'android_agent_pi_response provider=' >/dev/null || \
    fail "SOS $stage GPUI runtime omitted response model evidence"
  cmp -s "$agent_runner" "$SOS_ROOT/services/sos-agent/dist/agent-runner.cjs" || \
    fail "SOS $stage packaged Pi runner differs from the shared built bundle"
  cmp -s "$agent_api" "$SOS_ROOT/docs/experience-api.md" || \
    fail "SOS $stage packaged Pi API document differs from repository source"
  cmp -s "$agent_example_primary" "$SOS_ROOT/experiences/mobile.luau" || \
    fail "SOS $stage packaged Pi primary example differs from repository source"
  [[ ! -e "$target_files/SYSTEM_EXT/etc/sos-agent/example-secondary.luau" ]] || \
    fail "SOS $stage retained a secondary Pi example"
  [[ ! -e "$target_files/SYSTEM_EXT/etc/sos/default.luau" && \
    ! -e "$target_files/SYSTEM_EXT/etc/sos/default.package.json" && \
    ! -e "$target_files/SYSTEM_EXT/etc/sos/modules/stock-theme.luau" ]] || \
    fail "SOS $stage retained the Linux Stock Shell bootstrap"
  cmp -s "$bootstrap" "$SOS_ROOT/experiences/mobile.luau" || \
    fail "SOS $stage bootstrap differs from the Stock Mobile source"
  cmp -s "$bootstrap_package" "$SOS_ROOT/experiences/mobile.package.json" || \
    fail "SOS $stage packaged v4 manifest differs from repository source"
  cmp -s "$stock_theme" "$SOS_ROOT/experiences/modules/mobile-theme.luau" || \
    fail "SOS $stage packaged Stock Mobile theme differs from repository source"
  check_android_stock_mobile "$bootstrap" "$bootstrap_package" "$stock_theme"
  check_android_composition_authority "$authority" "$authority_init_rc"
  [[ ! -e "$target_files/SYSTEM_EXT/etc/sos-agent/android-runner.cjs" ]] || \
    fail "SOS $stage retained the superseded Android-only Pi runner"
  grep -F '(allow sos_core_host sos_node_exec (file (' "$system_ext_policy" | \
    grep -F 'execute_no_trans' >/dev/null || \
    fail "SOS $stage Core host cannot execute the shared Pi runner"
  grep -F '(allow sos_core_host sos_authority (unix_stream_socket (connectto)))' \
    "$system_ext_policy" >/dev/null || \
    fail "SOS $stage policy cannot connect Core to the revision authority"
  strings "$host" | grep -F 'native_supervisor_ready child=' >/dev/null || \
    fail "SOS $stage host omitted its native watchdog"
  strings "$host" | grep -F 'fixed_recovery_ready child_status=' >/dev/null || \
    fail "SOS $stage host omitted its fixed recovery surface"
  strings "$host" | grep -F 'native_recovery_chord action=reboot,recovery' >/dev/null || \
    fail "SOS $stage host omitted its framework-independent Recovery chord"
  grep -Fx "ro.sos.core.stage=$expected_stage" "$properties"
  grep -Fx "ro.sos.ui_owner=$expected_owner" "$properties"
  grep -Fx "ro.sos.lifecycle=$expected_lifecycle" "$properties"
  grep -Fx 'ro.sos.profile=core' "$properties"
  grep -Fx 'ro.sos.disable_user_apk_install=true' "$properties"
  grep -Fx 'ro.sos.revision_format=4' "$properties"
  grep -Fx 'ro.sos.experience_api=4' "$properties"
  unzip -p "$target_files/SYSTEM/framework/services.jar" 'classes*.dex' | strings | \
    grep -F 'SOS Core product policy prevents user APK installation' >/dev/null || \
    fail "SOS $stage framework does not enforce the Core APK-install policy"
  grep -E "^ro\\.system_ext\\.build\\.version\\.incremental=sos\\.${stage}\\.[0-9a-f]{12}\\.[0-9a-f]{12}$" \
    "$properties" || fail "SOS $stage build lacks a content-derived fingerprint"

  grep -Fx 'ro.sos.core.autostart=preunlock' "$properties"
  grep -Fx \
    'on property:init.svc.surfaceflinger=running && property:ro.sos.core.autostart=preunlock' \
    "$host_init_rc" >/dev/null || fail "SOS $stage lacks native pre-unlock startup"

  grep -Fx 'ro.sos.block_android_activities=true' "$properties" || \
    fail "SOS $stage does not block Android Activity rendering"
  unzip -p "$target_files/SYSTEM/framework/services.jar" 'classes*.dex' | strings | \
    grep -F 'SOS Core product policy blocked Android Activity start:' >/dev/null || \
    fail "SOS $stage framework omitted the Android Activity-start policy"

  if [[ "$stage" == core0b ]]; then
    unzip -p "$target_files/SYSTEM/framework/services.jar" 'classes*.dex' | strings | \
      grep -F 'SOS Core headless boot: no HOME Activity; completing boot directly' >/dev/null || \
      fail "Core 0B framework omitted its non-rendering boot-completion path"
  fi

  local system_ui="$target_files/SYSTEM_EXT/priv-app/SystemUI/SystemUI.apk"
  local launcher="$target_files/SYSTEM_EXT/priv-app/Launcher3QuickStep/Launcher3QuickStep.apk"
  [[ ! -e "$system_ui" && ! -e "$launcher" ]] || \
    fail "SOS $stage still packages SystemUI or Launcher3"
  [[ -f "$marker" ]] || fail "SOS $stage UI removal marker is missing"
  [[ ! -e "$compat_marker" ]] || \
    fail "SOS $stage packaged the Compat UI-removal marker"
  file "$marker" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS $stage UI removal marker is not an AArch64 executable"
  for removed in \
    AccessibilityMenu Aperture ApertureLensLauncher AudioFX AvatarPicker \
    Backgrounds BackupRestoreConfirmation BasicDreams Camelot CaptivePortalLogin \
    CertInstaller Contacts CredentialManager Dialer DocumentsUI EmergencyInfo \
    DeviceAsWebcam DeviceDiagnostics DownloadProviderUi \
    DynamicSystemInstallationService EasterEgg Etar ExactCalculator Gallery2 \
    Glimpse HTMLViewer IntentResolver Jelly LatinIME \
    Launcher3QuickStep LineageParts LineageSetupWizard LiveWallpapersPicker \
    ManagedProvisioning PhotoTable PrintSpooler Profiles \
    QuickAccessWallet Recorder SamsungDAP-custom SamsungDoze Seedvault Settings \
    SettingsIntelligence SimAppDialog SimpleSettingsConfig SoundPicker SpeakerFX \
    Stk StorageManager SystemUI ThemePicker ThemesStub Twelve Updater VpnDialogs \
    messaging; do
    ! find "$target_files" -type f -name "${removed}.apk" -print -quit | grep -q . || \
      fail "SOS $stage still packages Android UI APK $removed"
  done

  if [[ "$bridge" == present ]]; then
    [[ -f "$bridge_apk" ]] || fail "SOS $stage headless framework bridge is missing"
    local bridge_manifest
    bridge_manifest="$(container out/host/linux-x86/bin/aapt2 dump xmltree \
      --file AndroidManifest.xml "$bridge_apk")"
    grep -F 'package="dev.sos.frameworkbridge"' <<<"$bridge_manifest" >/dev/null || \
      fail "SOS $stage packaged the wrong framework bridge"
    ! grep -F 'E: activity' <<<"$bridge_manifest" >/dev/null || \
      fail "SOS $stage framework bridge must not render an Activity"
    grep -F '=".SosProviderNotificationListenerService"' \
      <<<"$bridge_manifest" >/dev/null || \
      fail "SOS $stage framework bridge omitted its attention provider service"
    grep -F '="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"' \
      <<<"$bridge_manifest" >/dev/null || \
      fail "SOS $stage attention provider lacks its system binding boundary"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'framework_provider_snapshot_failed' >/dev/null || \
      fail "SOS $stage framework bridge omitted the typed provider snapshot path"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'audio_set_volume' >/dev/null || \
      fail "SOS $stage framework bridge omitted provider action capabilities"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'framework_bridge_mode=credential-only' >/dev/null || \
      fail "SOS $stage bridge omitted its non-Compat lifecycle gate"
    strings "$host" | grep -F \
      'trusted_lock_ready bridge=headless-framework credential=pending' >/dev/null || \
      fail "SOS $stage host does not resolve credentials before drawing controls"
    strings "$host" | grep -F 'framework_bridge_probe result=ready credential_type=' >/dev/null || \
      fail "SOS $stage host omitted its non-secret framework bridge probe"
    grep -Fx 'on property:debug.sos.core.bridge_probe=1' "$host_init_rc" >/dev/null || \
      fail "SOS $stage omitted its physical bridge-test trigger"
  else
    [[ ! -e "$bridge_apk" ]] || fail "Core 1 cannot retain an APK framework bridge"
    for artifact in "$core_platform" "$core_platform_rc" "$core_app_manifest"; do
      [[ -f "$artifact" ]] || fail "Core 1 native provider artifact missing: $artifact"
      stat --printf='%n %s bytes\n' "$artifact"
      sha256sum "$artifact"
    done
    file "$core_platform" | grep -F 'ARM aarch64' >/dev/null || \
      fail "Core 1 platform provider adapter is not AArch64"
    strings "$core_platform" | grep -F 'sos_core_platform' >/dev/null || \
      fail "Core 1 platform adapter omitted its typed Unix-socket boundary"
    strings "$core_platform" | grep -F 'android.hardware.health-V4-ndk.so' >/dev/null || \
      fail "Core 1 platform adapter omitted the stable native health-HAL client"
    strings "$core_platform" | grep -F 'audio_set_volume' >/dev/null || \
      fail "Core 1 platform adapter omitted native audio actions"
    strings "$core_platform" | grep -F 'android.hardware.wifi.supplicant-V4-ndk.so' >/dev/null || \
      fail "Core 1 platform adapter omitted the stable Supplicant AIDL client"
    strings "$core_platform" | grep -F 'attention_acknowledge' >/dev/null || \
      fail "Core 1 platform adapter omitted native attention actions"
    strings "$core_platform" | grep -F \
      'core_platform_response_send_failed error=' >/dev/null || \
      fail "Core 1 platform adapter omitted peer-close-safe response handling"
    strings "$core_platform" | grep -F 'core_platform_snapshot_ms' >/dev/null || \
      fail "Core 1 platform adapter omitted snapshot timing logs"
    strings "$core_platform" | grep -F 'core_platform_audio_services_absent' >/dev/null || \
      fail "Core 1 platform adapter omitted audio service fail-fast"
    strings "$core_platform" | grep -F 'core_platform_audio_probe_timeout' >/dev/null || \
      fail "Core 1 platform adapter omitted bounded audio probe timeout"
    grep -Fx 'on post-fs-data && property:ro.sos.providers=core-native' \
      "$core_platform_rc" >/dev/null || \
      fail "Core 1 does not conditionally start the native Wi-Fi owner"
    grep -Fx '    start wpa_supplicant' "$core_platform_rc" >/dev/null || \
      fail "Core 1 native provider does not start stable Supplicant service"
    python3 -c 'import json,sys; value=json.load(open(sys.argv[1])); assert value.get("version") == 1 and isinstance(value.get("apps"), list)' \
      "$core_app_manifest" || fail "Core 1 native application manifest is invalid"
    grep -Fx 'ro.sos.providers=core-native' "$properties" >/dev/null || \
      fail "Core 1 authority does not select the native provider adapter"
    grep -F '(allow sos_authority sos_core_platform (unix_stream_socket (connectto)))' \
      "$system_ext_policy" >/dev/null || \
      fail "Core 1 authority cannot connect to the native provider adapter"
    local core_platform_parent_policy
    core_platform_parent_policy="$(
      grep -E '^\(allow sos_core_platform sos_authority_data_file ' \
        "$system_ext_policy" || true
    )"
    [[ "$core_platform_parent_policy" == \
      '(allow sos_core_platform sos_authority_data_file (dir (search)))' ]] || \
      fail "Core 1 platform parent traversal is missing or broader than dir search"
    local vendor_policy="$target_files/VENDOR/etc/selinux/vendor_sepolicy.cil"
    [[ -f "$vendor_policy" ]] || fail "Core 1 vendor sepolicy is missing"
    grep -F 'sysfs_touchscreen_writable' "$vendor_policy" | grep -F 'sos_core_host' >/dev/null || \
      fail "Core 1 host cannot enable the Samsung TSP sysfs node"
    grep -Fx '    chown system system /sys/class/sec/tsp/enabled' \
      "$target_files/VENDOR/etc/init/init.s5e8825.rc" >/dev/null || \
      fail "Core 1 vendor init does not chown Samsung tsp/enabled to system"
    grep -Fx '    chmod 0660 /sys/class/sec/tsp/enabled' \
      "$target_files/VENDOR/etc/init/init.s5e8825.rc" >/dev/null || \
      fail "Core 1 vendor init does not make Samsung tsp/enabled writable by system"
    ! grep -Eq '^\(allow sos_core_platform sysfs_battery(info)? ' "$system_ext_policy" || \
      fail "Core 1 bypasses the native health HAL with vendor battery sysfs access"
    ! grep -Eq '^\(allow sos_core_platform (wpa_socket|hal_wifi_supplicant_default) ' \
      "$system_ext_policy" || \
      fail "Core 1 bypasses stable Supplicant AIDL with a vendor control socket"
  fi

  if [[ "$no_zygote" == true ]]; then
    local no_zygote_rc="$target_files/SYSTEM/etc/init/hw/init.no_zygote.rc"
    [[ -f "$no_zygote_rc" ]] || fail "Core 1 no-Zygote init selection is missing"
    ! grep -Eq '^[[:space:]]*service[[:space:]]+zygote' "$no_zygote_rc" || \
      fail "Core 1 no-Zygote init file unexpectedly starts Zygote"
    grep -RhsFx 'ro.zygote=no_zygote' \
      "$target_files/VENDOR/build.prop" "$target_files/VENDOR/etc" 2>/dev/null | grep -Fx \
      'ro.zygote=no_zygote' >/dev/null || fail "Core 1 does not select init.no_zygote.rc"
    strings "$host" | grep -F \
      'core1_experience_start ce_available=false native_synthetic_password=false' >/dev/null || \
      fail "Core 1 must start the DE-hosted experience without faking CE unlock"
    strings "$host" | grep -F 'core1_locked_surface_ready native_synthetic_password=false' >/dev/null || \
      fail "Core 1 must expose the native-unlock blocker instead of faking CE unlock"
  fi
  info "SOS $stage target-files gate passed"
}

inspect_core0b() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl inspect-core0b"
  inspect_core_stage core0b
}

inspect_core1() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl inspect-core1"
  inspect_core_stage core1
  local host_runtime="$LINEAGE_ROOT/out/target/product/a33x/obj/PACKAGING/target_files_intermediates/lineage_${LINEAGE_SOS_CORE1_DEVICE}-target_files/SYSTEM_EXT/lib64/libsos_core_experience.so"
  ! readelf -Ws "$host_runtime" | grep -F \
    ' sos_core_provider_acceptance_probe' >/dev/null || \
    fail "Core 1 release inspection rejects the non-shipping provider probe"
}

inspect_core1_provider_probe() {
  [[ "$#" -eq 0 ]] || \
    fail "usage: ./tools/a33xctl inspect-core1-provider-probe"
  inspect_core_stage core1
  local target_files="$LINEAGE_ROOT/out/target/product/a33x/obj/PACKAGING/target_files_intermediates/lineage_${LINEAGE_SOS_CORE1_DEVICE}-target_files"
  local host="$target_files/SYSTEM_EXT/bin/sos-core-host"
  local host_init_rc="$target_files/SYSTEM_EXT/etc/init/sos-core-host.rc"
  local host_runtime="$target_files/SYSTEM_EXT/lib64/libsos_core_experience.so"
  readelf -Ws "$host_runtime" | grep -F \
    ' sos_core_provider_acceptance_probe' >/dev/null || \
    fail "Core 1 provider probe export is missing"
  local probe_marker
  for probe_marker in \
    'core_provider_probe case=' \
    'core_provider_probe contract=authority-json-line timeout_ms=' \
    snapshot security unavailable audio-restore wifi-restore; do
    strings "$host_runtime" | grep -F "$probe_marker" >/dev/null || \
      fail "Core 1 provider probe omitted marker: $probe_marker"
  done
  strings "$host" | grep -F \
    'core_provider_probe_invocation status=complete' >/dev/null || \
    fail "Core 1 host omitted its trusted provider-probe invocation"
  grep -Fx 'on property:debug.sos.core.bridge_probe=1' \
    "$host_init_rc" >/dev/null || \
    fail "Core 1 provider probe omitted its existing trusted init trigger"
  [[ ! -e "$target_files/SYSTEM_EXT/bin/sos-core-provider-probe" ]] || \
    fail "Core 1 provider probe must not add a separately packaged executable"
  info "SOS Core 1 non-shipping provider probe gate passed"
}

validate_device_identity() {
  [[ "$#" -eq 2 ]] || fail "internal usage: validate_device_identity <serial> <revision>"
  [[ "$1" =~ ^[A-Za-z0-9._:-]+$ ]] || fail "invalid device serial: $1"
  [[ "$2" =~ ^[A-Za-z0-9._:+-]+$ ]] || fail "invalid expected revision: $2"
}

restart_v4_authority() {
  [[ "$#" -eq 4 && "$1" == --serial && "$3" == --expected-revision ]] || \
    fail "usage: ./tools/a33xctl restart-v4-authority --serial SERIAL --expected-revision REVISION"
  local serial="$2" expected_revision="$4" revision build_type profile host_process
  local old_authority new_authority old_host new_host service recovery_snapshot audit_ready=0
  validate_device_identity "$serial" "$expected_revision"
  revision="$(device_property "$serial" ro.build.version.incremental)"
  build_type="$(device_property "$serial" ro.build.type)"
  profile="$(device_property "$serial" ro.sos.profile)"
  [[ "$revision" == "$expected_revision" ]] || \
    fail "authority recovery revision mismatch: expected $expected_revision, found $revision"
  [[ "$build_type" == userdebug || "$build_type" == eng ]] || \
    fail "authority recovery probe is available only on a userdebug or eng physical gate product"
  case "$profile" in
    compat) host_process=dev.sos.experience ;;
    core) host_process=sos-core-host ;;
    *) fail "authority recovery does not support SOS profile: $profile" ;;
  esac
  old_authority="$(adb_readonly "$serial" shell pidof sos-authority 2>/dev/null | tr -d '\r\n' || true)"
  old_host="$(adb_readonly "$serial" shell pidof "$host_process" 2>/dev/null | \
    tr -d '\r' | tr ' ' '\n' | sed '/^$/d' | sort -n | paste -sd ' ' - || true)"
  [[ "$old_authority" =~ ^[0-9]+$ ]] || fail "SOS authority is not live before recovery"
  if [[ "$profile" == compat ]]; then
    [[ "$old_host" =~ ^[0-9]+$ ]] || fail "SOS HOME is not live before authority recovery"
  else
    [[ "$old_host" =~ ^[0-9]+\ [0-9]+$ ]] || \
      fail "Core supervisor and child are not both live before authority recovery"
  fi

  adb_readonly "$serial" shell setprop sys.sos.authority_recovery_probe 1
  recovery_snapshot="$(mktemp /tmp/sos-authority-recovery-audit.XXXXXX)"
  new_authority=''
  for _ in {1..100}; do
    new_authority="$(adb_readonly "$serial" shell pidof sos-authority 2>/dev/null | tr -d '\r\n' || true)"
    service="$(device_property "$serial" init.svc.sos_authority)"
    if [[ "$new_authority" =~ ^[0-9]+$ && "$new_authority" != "$old_authority" && \
      "$service" == running ]]; then
      if capture_authority_audit_snapshot "$serial" "$recovery_snapshot" \
        >/dev/null 2>&1; then
        audit_ready=1
        break
      fi
    fi
    sleep 0.1
  done
  if [[ ! "$new_authority" =~ ^[0-9]+$ || "$new_authority" == "$old_authority" || \
    "$audit_ready" != 1 ]]; then
    rm -f -- "$recovery_snapshot"
    fail "init did not recover an audit-ready authority after the bounded probe"
  fi
  rm -f -- "$recovery_snapshot"
  new_host="$(adb_readonly "$serial" shell pidof "$host_process" 2>/dev/null | \
    tr -d '\r' | tr ' ' '\n' | sed '/^$/d' | sort -n | paste -sd ' ' - || true)"
  [[ "$new_host" == "$old_host" ]] || \
    fail "authority recovery replaced the SOS host process"
  [[ "$(device_property "$serial" sys.sos.authority_recovery_probe)" == 0 ]] || \
    fail "authority recovery probe did not reset after one use"
  printf 'v4_authority_recovery=PASS\nserial=%s\nrevision=%s\nbuild_type=%s\nprofile=%s\n' \
    "$serial" "$revision" "$build_type" "$profile"
  printf 'authority_pid_before=%s\nauthority_pid_after=%s\nhost_process=%s\nhost_pids=%s\n' \
    "$old_authority" "$new_authority" "$host_process" "$new_host"
}

adb_readonly() {
  [[ "$#" -ge 2 ]] || fail "internal usage: adb_readonly <serial> <arguments...>"
  local serial="$1" adb_binary="${A33XCTL_ADB:-adb}"
  shift
  require_command "$adb_binary"
  "$adb_binary" -s "$serial" "$@"
}

capture_authority_audit_snapshot() {
  [[ "$#" -eq 2 ]] || \
    fail "internal usage: capture_authority_audit_snapshot <serial> <output>"
  local serial="$1" output="$2"
  (
    set -euo pipefail
    local nc_binary="${A33XCTL_NC:-nc}" port response
    require_command "$nc_binary"
    require_command timeout
    response="$(mktemp "$(dirname "$output")/.authority-audit.XXXXXX")"
    port="$(adb_readonly "$serial" forward tcp:0 tcp:47778 | tr -d '\r\n')"
    [[ "$port" =~ ^[0-9]+$ && "$port" -ge 1024 && "$port" -le 65535 ]] || \
      fail "adb returned an invalid authority-forward port: $port"
    trap 'adb_readonly "$serial" forward --remove "tcp:$port" >/dev/null 2>&1 || true; rm -f -- "$response"' EXIT
    printf '%s\n' '{"action":"audit_snapshot","request_id":9100}' | \
      timeout 15s "$nc_binary" --no-shutdown 127.0.0.1 "$port" >"$response"
    [[ "$(stat -c %s "$response")" -le 100663296 ]] || \
      fail "authority audit response exceeded its size limit"
    jq -e '
      .request_id == 9100 and .ok == true and
      (.audit_snapshot | type == "object") and
      (.audit_snapshot.format_version == 1)
    ' "$response" >/dev/null || fail "authority returned an invalid audit snapshot"
    jq -S '.audit_snapshot' "$response" >"$output"
  )
}

device_property() {
  [[ "$#" -eq 2 ]] || fail "internal usage: device_property <serial> <property>"
  adb_readonly "$1" shell getprop "$2" | tr -d '\r\n'
}

inspect_core1_readiness() {
  [[ "$#" -eq 4 && "$1" == --serial && "$3" == --expected-revision ]] || \
    fail "usage: ./tools/a33xctl inspect-core1-readiness --serial SERIAL --expected-revision REVISION"
  local serial="$2" expected_revision="$4"
  validate_device_identity "$serial" "$expected_revision"

  local revision stage lifecycle profile providers ui_owner zygote enforcing
  revision="$(device_property "$serial" ro.build.version.incremental)"
  stage="$(device_property "$serial" ro.sos.core.stage)"
  lifecycle="$(device_property "$serial" ro.sos.lifecycle)"
  profile="$(device_property "$serial" ro.sos.profile)"
  providers="$(device_property "$serial" ro.sos.providers)"
  ui_owner="$(device_property "$serial" ro.sos.ui_owner)"
  zygote="$(device_property "$serial" ro.zygote)"
  enforcing="$(adb_readonly "$serial" shell getenforce | tr -d '\r\n')"

  [[ "$revision" == "$expected_revision" ]] || \
    fail "Core 1 revision mismatch: expected $expected_revision, found $revision"
  [[ "$stage" == 1 && "$lifecycle" == active && "$profile" == core ]] || \
    fail "device does not report the active Core 1 product"
  [[ "$providers" == core-native && "$ui_owner" == native-sos-no-zygote ]] || \
    fail "device does not report Core 1 native ownership"
  [[ "$zygote" == no_zygote ]] || fail "Core 1 unexpectedly enables Zygote"
  [[ "$enforcing" == Enforcing ]] || fail "Core 1 SELinux is not Enforcing"

  local surfaces host_pids authority_pid platform_pid host_service authority_service platform_service
  surfaces="$(adb_readonly "$serial" shell dumpsys SurfaceFlinger --list)"
  grep -F 'SOS Core Experience' <<<"$surfaces" >/dev/null || \
    fail "SOS Core Experience surface is not present"
  host_pids="$(adb_readonly "$serial" shell pidof sos-core-host 2>/dev/null | tr -d '\r' || true)"
  authority_pid="$(adb_readonly "$serial" shell pidof sos-authority 2>/dev/null | tr -d '\r' || true)"
  platform_pid="$(adb_readonly "$serial" shell pidof sos-core-platform 2>/dev/null | tr -d '\r' || true)"
  [[ "$host_pids" =~ ^[0-9]+[[:space:]]+[0-9]+([[:space:]]+[0-9]+)*$ ]] || \
    fail "Core 1 supervisor and experience child are not both live"
  [[ "$authority_pid" =~ ^[0-9]+$ ]] || fail "SOS authority is not live"
  [[ "$platform_pid" =~ ^[0-9]+$ ]] || fail "SOS platform adapter is not live"
  host_service="$(device_property "$serial" init.svc.sos_core_host)"
  authority_service="$(device_property "$serial" init.svc.sos_authority)"
  platform_service="$(device_property "$serial" init.svc.sos_core_platform)"
  [[ "$host_service" == running && "$authority_service" == running && \
    "$platform_service" == running ]] || fail "a required Core 1 init service is not running"

  local logs current_lifecycle_logs relevant_avc relevant_crash avc filtered_avc=''
  logs="$(adb_readonly "$serial" logcat -d -b all -v threadtime)"
  current_lifecycle_logs="$(awk '
    /core1_experience_start ce_available=false/ { seen = 1; retained = "" }
    seen { retained = retained $0 ORS }
    END { printf "%s", retained }
  ' <<<"$logs")"
  grep -F 'core1_experience_start ce_available=false native_synthetic_password=false' \
    <<<"$current_lifecycle_logs" >/dev/null || fail "current Core 1 lifecycle marker is absent"
  grep -F 'SOS experience window is live frame_padding=none' \
    <<<"$current_lifecycle_logs" >/dev/null || fail "current SOS Core Experience runtime-ready marker is absent"
  relevant_crash="$(grep -Ei \
    '(native_gpui_failed|android_authority_fatal|system_revision_activation_failed|Fatal signal.*sos|SIGABRT.*sos|sos.*SIGABRT)' \
    <<<"$current_lifecycle_logs" || true)"
  [[ -z "$relevant_crash" ]] || fail "relevant Core 1 crash marker is present after lifecycle start"
  relevant_avc="$(grep -Ei 'avc:[[:space:]]*denied' <<<"$current_lifecycle_logs" | \
    grep -E 'scontext=u:r:(sos_core_host|sos_core_platform|sos_authority):s0' || true)"
  # The native loader's known top-level /data directory probe is non-blocking;
  # all other enforcing SOS-domain denials remain readiness failures.
  while IFS= read -r avc; do
    [[ -n "$avc" ]] || continue
    if [[ "$avc" == *'scontext=u:r:sos_core_host:s0'* && \
      "$avc" == *'{ search }'* && "$avc" == *'name="data"'* ]]; then
      continue
    fi
    filtered_avc+="$avc"$'\n'
  done <<<"$relevant_avc"
  relevant_avc="${filtered_avc%$'\n'}"
  [[ -z "$relevant_avc" ]] || fail "relevant enforcing Core 1 AVC is present after lifecycle start"

  printf 'core1_readiness=PASS\nserial=%s\nrevision=%s\nsurface=SOS Core Experience\n' \
    "$serial" "$revision"
  printf 'supervisor_experience_pids=%s\nauthority_pid=%s\nplatform_pid=%s\n' \
    "$host_pids" "$authority_pid" "$platform_pid"
  printf 'native_lifecycle=PASS\nrelevant_crash=absent\nrelevant_enforcing_avc=absent\n'
  info "Core 1 readiness inspection passed without Android boot-complete predicates"
}

validate_v4_composition_product() {
  [[ "$#" -eq 1 ]] || fail "internal usage: validate_v4_composition_product PRODUCT"
  case "$1" in
    compat1|core1) ;;
    *) fail "v4 composition product must be compat1 or core1" ;;
  esac
}

v4_composition_stage_previous() {
  [[ "$#" -eq 1 ]] || fail "internal usage: v4_composition_stage_previous STAGE"
  case "$1" in
    stock) printf '\n' ;;
    dashboard) printf 'stock\n' ;;
    appearance) printf 'dashboard\n' ;;
    child-failure) printf 'appearance\n' ;;
    child-timeout) printf 'child-failure\n' ;;
    recovered) printf 'child-timeout\n' ;;
    ime-accessibility) printf 'recovered\n' ;;
    host-restart) printf 'ime-accessibility\n' ;;
    authority-restart) printf 'host-restart\n' ;;
    authored) printf 'authority-restart\n' ;;
    rollback) printf 'authored\n' ;;
    *) fail "unknown v4 composition stage: $1" ;;
  esac
}

v4_campaign_json_value() {
  [[ "$#" -eq 2 ]] || fail "internal usage: v4_campaign_json_value FILE FIELD"
  jq -er --arg field "$2" '.[$field] | strings' "$1"
}

write_v4_stage_properties() {
  [[ "$#" -eq 2 ]] || fail "internal usage: write_v4_stage_properties SERIAL OUTPUT"
  local serial="$1" output="$2" property value
  : >"$output"
  for property in \
    ro.build.version.incremental \
    ro.sos.experience_api \
    ro.sos.revision_format \
    ro.sos.profile \
    ro.sos.ui_owner \
    ro.sos.core.stage \
    ro.sos.compat.stage \
    ro.sos.providers \
    ro.zygote \
    sys.boot_completed \
    init.svc.sos_authority \
    init.svc.sos_core_host \
    init.svc.sos_core_platform; do
    value="$(device_property "$serial" "$property")"
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || \
      fail "device property contains a line break: $property"
    printf '%s=%s\n' "$property" "$value" >>"$output"
  done
}

host_monotonic_ns() {
  [[ "$#" -eq 0 ]] || fail "internal usage: host_monotonic_ns"
  awk '{ printf "%.0f\n", $1 * 1000000000 }' /proc/uptime
}

capture_v4_composition_stage() {
  [[ "$#" -eq 12 && "$1" == --product && "$3" == --serial && \
    "$5" == --expected-revision && "$7" == --artifact && \
    "${9}" == --root && "${11}" == --stage ]] || \
    fail "usage: ./tools/a33xctl capture-v4-composition-stage --product compat1|core1 --serial SERIAL --expected-revision REVISION --artifact OTA --root DIR --stage STAGE"
  local product="$2" serial="$4" expected_revision="$6" artifact="$8"
  local evidence_root="${10}" stage="${12}" previous campaign_file stage_root final_stage_root
  local artifact_bytes artifact_sha started_ns finished_ns enforcing
  local authority_pid home_pid core_host_pids platform_pid
  validate_v4_composition_product "$product"
  validate_device_identity "$serial" "$expected_revision"
  previous="$(v4_composition_stage_previous "$stage")"
  require_command jq
  require_command sha256sum
  require_command stat
  artifact="$(realpath -e "$artifact")"
  [[ -f "$artifact" ]] || fail "v4 composition artifact is not a file: $artifact"
  artifact_bytes="$(stat -c %s "$artifact")"
  artifact_sha="$(sha256sum "$artifact" | awk '{print $1}')"

  if [[ ! -e "$evidence_root" ]]; then
    [[ "$stage" == stock ]] || fail "the stock stage must initialize a v4 composition campaign"
    mkdir -m 0700 -- "$evidence_root"
    evidence_root="$(realpath -e "$evidence_root")"
    mkdir -m 0700 -- "$evidence_root/stages"
    jq -n \
      --arg product "$product" \
      --arg serial "$serial" \
      --arg expected_revision "$expected_revision" \
      --arg artifact "$artifact" \
      --arg artifact_sha256 "$artifact_sha" \
      --argjson artifact_bytes "$artifact_bytes" \
      '{format_version: 1, product: $product, serial: $serial,
        expected_revision: $expected_revision, artifact: $artifact,
        artifact_bytes: $artifact_bytes, artifact_sha256: $artifact_sha256}' \
      >"$evidence_root/campaign.json"
  else
    evidence_root="$(realpath -e "$evidence_root")"
  fi
  campaign_file="$evidence_root/campaign.json"
  [[ -f "$campaign_file" ]] || fail "v4 composition campaign metadata is missing"
  [[ "$(v4_campaign_json_value "$campaign_file" product)" == "$product" ]] || \
    fail "v4 composition product changed during the campaign"
  [[ "$(v4_campaign_json_value "$campaign_file" serial)" == "$serial" ]] || \
    fail "v4 composition serial changed during the campaign"
  [[ "$(v4_campaign_json_value "$campaign_file" expected_revision)" == "$expected_revision" ]] || \
    fail "v4 composition revision changed during the campaign"
  [[ "$(v4_campaign_json_value "$campaign_file" artifact)" == "$artifact" ]] || \
    fail "v4 composition artifact path changed during the campaign"
  [[ "$(v4_campaign_json_value "$campaign_file" artifact_sha256)" == "$artifact_sha" ]] || \
    fail "v4 composition artifact content changed during the campaign"
  [[ "$(jq -er '.artifact_bytes | numbers' "$campaign_file")" == "$artifact_bytes" ]] || \
    fail "v4 composition artifact size changed during the campaign"
  if [[ -n "$previous" ]]; then
    [[ -d "$evidence_root/stages/$previous" ]] || \
      fail "v4 composition stage $stage requires completed stage $previous"
  fi
  final_stage_root="$evidence_root/stages/$stage"
  [[ ! -e "$final_stage_root" ]] || fail "v4 composition stage already exists: $stage"
  stage_root="$(mktemp -d "$evidence_root/stages/.$stage.capture.XXXXXX")"
  chmod 0700 -- "$stage_root"
  A33XCTL_CAPTURE_TEMP_ROOT="$stage_root"
  trap 'if [[ -n "${A33XCTL_CAPTURE_TEMP_ROOT:-}" ]]; then
    rm -rf -- "$A33XCTL_CAPTURE_TEMP_ROOT"
  fi' EXIT

  export A33XCTL_CAPTURE_STAGE="$stage"
  export A33XCTL_CAPTURE_PRODUCT="$product"
  export A33XCTL_CAPTURE_REVISION="$expected_revision"
  started_ns="$(host_monotonic_ns)"
  write_v4_stage_properties "$serial" "$stage_root/properties.env"
  enforcing="$(adb_readonly "$serial" shell getenforce | tr -d '\r\n')"
  printf 'selinux=%s\n' "$enforcing" >"$stage_root/security.env"
  adb_readonly "$serial" shell ps -AZ >"$stage_root/processes.txt"
  adb_readonly "$serial" shell dumpsys SurfaceFlinger --list >"$stage_root/surfaces.txt"
  adb_readonly "$serial" logcat -d -b all -v threadtime >"$stage_root/logcat.txt"
  capture_authority_audit_snapshot "$serial" "$stage_root/composition.json"
  adb_readonly "$serial" exec-out screencap -p >"$stage_root/screen.png"
  adb_readonly "$serial" shell cat /proc/meminfo >"$stage_root/meminfo.txt"
  authority_pid="$(adb_readonly "$serial" shell pidof sos-authority | tr -d '\r\n')"
  if [[ "$product" == compat1 ]]; then
    home_pid="$(adb_readonly "$serial" shell pidof dev.sos.experience | tr -d '\r\n')"
    printf 'authority_pid=%s\nhome_pid=%s\n' "$authority_pid" "$home_pid" \
      >"$stage_root/pids.env"
    adb_readonly "$serial" shell dumpsys meminfo dev.sos.experience \
      >"$stage_root/runtime-memory.txt"
    local accessibility_remote="/data/local/tmp/sos-v4-$stage-accessibility.xml"
    adb_readonly "$serial" shell uiautomator dump "$accessibility_remote" >/dev/null
    adb_readonly "$serial" shell cat "$accessibility_remote" \
      >"$stage_root/accessibility.xml"
    adb_readonly "$serial" shell rm -f "$accessibility_remote"
  else
    core_host_pids="$(adb_readonly "$serial" shell pidof sos-core-host | \
      tr -d '\r' | tr ' ' '\n' | sed '/^$/d' | sort -n | paste -sd ' ' -)"
    platform_pid="$(adb_readonly "$serial" shell pidof sos-core-platform | tr -d '\r\n')"
    printf 'authority_pid=%s\ncore_host_pids=%s\nplatform_pid=%s\n' \
      "$authority_pid" "$core_host_pids" "$platform_pid" >"$stage_root/pids.env"
    : >"$stage_root/runtime-memory.txt"
    local core_pid
    for core_pid in $core_host_pids; do
      printf 'pid=%s\n' "$core_pid" >>"$stage_root/runtime-memory.txt"
      adb_readonly "$serial" shell cat "/proc/$core_pid/status" \
        >>"$stage_root/runtime-memory.txt"
    done
    inspect_core1_readiness --serial "$serial" --expected-revision "$expected_revision" \
      >"$stage_root/readiness.txt"
  fi
  finished_ns="$(host_monotonic_ns)"
  printf 'stage=%s\nproduct=%s\nserial=%s\nrevision=%s\nartifact_sha256=%s\n' \
    "$stage" "$product" "$serial" "$expected_revision" "$artifact_sha" \
    >"$stage_root/stage.env"
  printf 'started_ns=%s\nfinished_ns=%s\nduration_ns=%s\n' \
    "$started_ns" "$finished_ns" "$((finished_ns - started_ns))" \
    >>"$stage_root/stage.env"
  mv -- "$stage_root" "$final_stage_root"
  A33XCTL_CAPTURE_TEMP_ROOT=
  trap - EXIT
  stage_root="$final_stage_root"
  unset A33XCTL_CAPTURE_STAGE A33XCTL_CAPTURE_PRODUCT A33XCTL_CAPTURE_REVISION \
    A33XCTL_CAPTURE_TEMP_ROOT
  printf 'v4_composition_stage=CAPTURED\nproduct=%s\nserial=%s\nrevision=%s\nstage=%s\nroot=%s\n' \
    "$product" "$serial" "$expected_revision" "$stage" "$evidence_root"
}

v4_stage_property() {
  [[ "$#" -eq 2 ]] || fail "internal usage: v4_stage_property FILE PROPERTY"
  awk -F= -v property="$2" '$1 == property { sub(/^[^=]*=/, ""); print; found = 1; exit }
    END { if (!found) exit 1 }' "$1"
}

v4_stage_pid() {
  [[ "$#" -eq 2 ]] || fail "internal usage: v4_stage_pid FILE FIELD"
  v4_stage_property "$1" "$2"
}

require_v4_log_pattern() {
  [[ "$#" -eq 3 ]] || fail "internal usage: require_v4_log_pattern LOG PATTERN MESSAGE"
  grep -Eq "$2" "$1" || fail "$3"
}

audit_v4_stage_common() {
  [[ "$#" -eq 5 ]] || fail "internal usage: audit_v4_stage_common ROOT STAGE PRODUCT SERIAL REVISION"
  local evidence_root="$1" stage="$2" product="$3" serial="$4" expected_revision="$5"
  local stage_root="$evidence_root/stages/$stage" png_magic
  for required in properties.env security.env processes.txt surfaces.txt logcat.txt \
    composition.json screen.png meminfo.txt runtime-memory.txt pids.env stage.env; do
    [[ -s "$stage_root/$required" ]] || fail "v4 composition stage $stage lacks $required"
  done
  jq -e . "$stage_root/composition.json" >/dev/null || \
    fail "v4 composition stage $stage has invalid authority JSON"
  [[ "$(v4_stage_property "$stage_root/properties.env" ro.build.version.incremental)" == "$expected_revision" ]] || \
    fail "v4 composition stage $stage has the wrong product revision"
  [[ "$(v4_stage_property "$stage_root/stage.env" stage)" == "$stage" && \
    "$(v4_stage_property "$stage_root/stage.env" product)" == "$product" && \
    "$(v4_stage_property "$stage_root/stage.env" serial)" == "$serial" && \
    "$(v4_stage_property "$stage_root/stage.env" revision)" == "$expected_revision" && \
    "$(v4_stage_property "$stage_root/stage.env" artifact_sha256)" == \
      "$(v4_campaign_json_value "$evidence_root/campaign.json" artifact_sha256)" ]] || \
    fail "v4 composition stage $stage identity is not bound to its campaign"
  [[ "$(v4_stage_property "$stage_root/properties.env" ro.sos.experience_api)" == 4 ]] || \
    fail "v4 composition stage $stage does not report Experience API v4"
  [[ "$(v4_stage_property "$stage_root/properties.env" ro.sos.revision_format)" == 4 ]] || \
    fail "v4 composition stage $stage does not report package format v4"
  grep -Fx 'selinux=Enforcing' "$stage_root/security.env" >/dev/null || \
    fail "v4 composition stage $stage is not SELinux Enforcing"
  png_magic="$(head -c 8 "$stage_root/screen.png" | od -An -tx1 | tr -d ' \n')"
  [[ "$png_magic" == 89504e470d0a1a0a ]] || \
    fail "v4 composition stage $stage screenshot is not PNG"
  grep -F 'sos-authority' "$stage_root/processes.txt" >/dev/null || \
    fail "v4 composition stage $stage lacks the authority process"
  if grep -Eiq '(Fatal signal.*sos|ANR in dev\.sos|native_gpui_failed|android_authority_fatal|system_revision_activation_failed)' \
    "$stage_root/logcat.txt"; then
    fail "v4 composition stage $stage contains a relevant crash or ANR"
  fi
  if [[ "$product" == compat1 ]]; then
    [[ "$(v4_stage_property "$stage_root/properties.env" ro.sos.profile)" == compat && \
      "$(v4_stage_property "$stage_root/properties.env" ro.sos.compat.stage)" == 1 && \
      "$(v4_stage_property "$stage_root/properties.env" ro.sos.ui_owner)" == native-sos-android-runtime && \
      "$(v4_stage_property "$stage_root/properties.env" sys.boot_completed)" == 1 ]] || \
      fail "v4 composition stage $stage is not ready Compat 1"
    grep -F 'dev.sos.experience' "$stage_root/processes.txt" >/dev/null || \
      fail "v4 composition stage $stage lacks the Compat HOME process"
    grep -Eq 'SosHomeActivity|dev\.sos\.experience' "$stage_root/surfaces.txt" || \
      fail "v4 composition stage $stage lacks the Compat HOME surface"
    [[ -s "$stage_root/accessibility.xml" ]] || \
      fail "v4 composition stage $stage lacks the Android accessibility tree"
    grep -F 'TOTAL PSS:' "$stage_root/runtime-memory.txt" >/dev/null || \
      fail "v4 composition stage $stage lacks Compat runtime memory evidence"
    if grep -Ei 'avc:[[:space:]]*denied.*scontext=u:r:(sos_authority|priv_app):s0' \
      "$stage_root/logcat.txt" >/dev/null; then
      fail "v4 composition stage $stage contains a relevant enforcing AVC"
    fi
  else
    [[ "$(v4_stage_property "$stage_root/properties.env" ro.sos.profile)" == core && \
      "$(v4_stage_property "$stage_root/properties.env" ro.sos.core.stage)" == 1 && \
      "$(v4_stage_property "$stage_root/properties.env" ro.sos.providers)" == core-native && \
      "$(v4_stage_property "$stage_root/properties.env" ro.sos.ui_owner)" == native-sos-no-zygote && \
      "$(v4_stage_property "$stage_root/properties.env" ro.zygote)" == no_zygote ]] || \
      fail "v4 composition stage $stage is not ready Core 1"
    grep -F 'sos-core-host' "$stage_root/processes.txt" >/dev/null || \
      fail "v4 composition stage $stage lacks the Core supervisor and child"
    grep -F 'SOS Core Experience' "$stage_root/surfaces.txt" >/dev/null || \
      fail "v4 composition stage $stage lacks the Core Experience surface"
    grep -Fx 'core1_readiness=PASS' "$stage_root/readiness.txt" >/dev/null || \
      fail "v4 composition stage $stage failed Core readiness"
    [[ "$(grep -c '^VmRSS:' "$stage_root/runtime-memory.txt")" -ge 2 ]] || \
      fail "v4 composition stage $stage lacks per-process Core runtime memory evidence"
  fi
  [[ "$(v4_campaign_json_value "$evidence_root/campaign.json" serial)" == "$serial" ]] || \
    fail "v4 composition serial changed while auditing stage $stage"
}

audit_v4_composition_campaign() {
  [[ "$#" -eq 2 && "$1" == --root ]] || \
    fail "usage: ./tools/a33xctl audit-v4-composition-campaign --root DIR"
  local evidence_root campaign_file product serial expected_revision artifact artifact_sha artifact_bytes stage final_log
  local control_label
  local stage_started stage_finished previous_finished=0 campaign_started campaign_finished
  local dashboard_generation appearance_generation runtime_ready_count failed_count recovered_count
  local original_stock_revision authored_stock_revision rollback_stock_revision
  local dashboard_authority host_authority restarted_authority authored_authority rollback_authority
  local dashboard_host restarted_host authority_stage_host authored_host rollback_host common_core_pids
  evidence_root="$(realpath -e "$2")"
  campaign_file="$evidence_root/campaign.json"
  [[ -f "$campaign_file" ]] || fail "v4 composition campaign metadata is missing"
  product="$(v4_campaign_json_value "$campaign_file" product)"
  serial="$(v4_campaign_json_value "$campaign_file" serial)"
  expected_revision="$(v4_campaign_json_value "$campaign_file" expected_revision)"
  artifact="$(v4_campaign_json_value "$campaign_file" artifact)"
  artifact_sha="$(v4_campaign_json_value "$campaign_file" artifact_sha256)"
  artifact_bytes="$(jq -er '.artifact_bytes | numbers' "$campaign_file")"
  validate_v4_composition_product "$product"
  [[ -f "$artifact" && "$(stat -c %s "$artifact")" == "$artifact_bytes" && \
    "$(sha256sum "$artifact" | awk '{print $1}')" == "$artifact_sha" ]] || \
    fail "v4 composition campaign artifact is missing or changed"
  for stage in stock dashboard appearance child-failure child-timeout recovered \
    ime-accessibility host-restart authority-restart authored rollback; do
    [[ -d "$evidence_root/stages/$stage" ]] || \
      fail "v4 composition campaign lacks stage $stage"
    audit_v4_stage_common "$evidence_root" "$stage" "$product" "$serial" "$expected_revision"
    stage_started="$(v4_stage_property "$evidence_root/stages/$stage/stage.env" started_ns)"
    stage_finished="$(v4_stage_property "$evidence_root/stages/$stage/stage.env" finished_ns)"
    [[ "$stage_started" =~ ^[0-9]+$ && "$stage_finished" =~ ^[0-9]+$ && \
      "$stage_started" -ge "$previous_finished" && "$stage_finished" -ge "$stage_started" ]] || \
      fail "v4 composition stage $stage has invalid or non-monotonic timing evidence"
    [[ "$stage" == stock ]] && campaign_started="$stage_started"
    previous_finished="$stage_finished"
    campaign_finished="$stage_finished"
  done

  jq -e '
    . as $root |
    $root.format_version == 1 and
    $root.presented_experience == "sos.example.dashboard" and
    (["sos.stock.mobile", "sos.example.agenda", "sos.example.media",
      "sos.example.dashboard", "sos.example.agenda-media-remix"]
      | all(. as $id | $root.states[$id] != null and $root.grants[$id] != null))
  ' "$evidence_root/stages/dashboard/composition.json" >/dev/null || \
    fail "Dashboard stage lacks independent v4 state and grant resources"
  jq -e '
    . as $root |
    ($root.grants | to_entries | all(.value.reviewed == true and .value.experience_id == .key)) and
    ($root.grants["sos.stock.mobile"].provider_capabilities | index("appearance_write") != null) and
    ($root.grants["sos.example.agenda"].provider_capabilities | length == 0) and
    ($root.grants["sos.example.dashboard"].provider_capabilities | length == 0) and
    ($root.grants["sos.example.media"].provider_capabilities | sort == ["music_control", "music_read"]) and
    ($root.grants["sos.example.dashboard"].data_flows | keys | sort == ["agenda", "media"])
  ' "$evidence_root/stages/recovered/composition.json" >/dev/null || \
    fail "v4 composition grants are missing, merged, or not independently reviewed"
  jq -e '
    .states["sos.example.agenda"].state.selected == "Design review" and
    .states["sos.example.dashboard"].state.opened == "Design review" and
    .states["sos.example.dashboard"].state.acceptance_pings >= 2 and
    ([.states[] | .revision_id] | unique | length >= 4)
  ' "$evidence_root/stages/recovered/composition.json" >/dev/null || \
    fail "child event, durable state, parent liveness, or Experience isolation evidence is missing"
  dashboard_generation="$(jq -er '.appearance.generation' \
    "$evidence_root/stages/dashboard/composition.json")"
  appearance_generation="$(jq -er '.appearance.generation' \
    "$evidence_root/stages/appearance/composition.json")"
  [[ "$dashboard_generation" =~ ^[0-9]+$ && "$appearance_generation" =~ ^[0-9]+$ && \
    "$appearance_generation" -gt "$dashboard_generation" ]] || \
    fail "appearance generation did not advance"
  cmp -s \
    <(jq -S -c '.states | with_entries(.value = .value.revision_id)' \
      "$evidence_root/stages/dashboard/composition.json") \
    <(jq -S -c '.states | with_entries(.value = .value.revision_id)' \
      "$evidence_root/stages/appearance/composition.json") || \
    fail "appearance propagation changed an Experience revision"
  cmp -s \
    <(jq -S -c '.states["sos.example.media"]' \
      "$evidence_root/stages/dashboard/composition.json") \
    <(jq -S -c '.states["sos.example.media"]' \
      "$evidence_root/stages/appearance/composition.json") || \
    fail "custom Media state changed during appearance propagation"
  for stage in host-restart authority-restart; do
    jq -e --argjson generation "$appearance_generation" '
      .presented_experience == "sos.example.dashboard" and
      .appearance.generation == $generation and
      .states["sos.example.agenda"].state.selected == "Design review" and
      .states["sos.example.dashboard"].state.opened == "Design review"
    ' "$evidence_root/stages/$stage/composition.json" >/dev/null || \
      fail "v4 graph, state, or appearance did not survive $stage"
  done
  original_stock_revision="$(jq -er '.states["sos.stock.mobile"].revision_id' \
    "$evidence_root/stages/dashboard/composition.json")"
  authored_stock_revision="$(jq -er '.states["sos.stock.mobile"].revision_id' \
    "$evidence_root/stages/authored/composition.json")"
  rollback_stock_revision="$(jq -er '.states["sos.stock.mobile"].revision_id' \
    "$evidence_root/stages/rollback/composition.json")"
  [[ "$original_stock_revision" != "$authored_stock_revision" && \
    "$rollback_stock_revision" == "$original_stock_revision" ]] || \
    fail "Stock did not activate and roll back between two v4 revisions"
  jq -s -e 'all(.[]; .presented_experience == null)' \
    "$evidence_root/stages/authored/composition.json" \
    "$evidence_root/stages/rollback/composition.json" >/dev/null || \
    fail "Stock authoring or rollback left another top-level Experience presented"

  final_log="$evidence_root/stages/rollback/logcat.txt"
  require_v4_log_pattern "$final_log" \
    'android_graph_runtime_ready .*root_experience=sos\.example\.dashboard instances=3' \
    "Dashboard did not start as a three-Instance graph"
  require_v4_log_pattern "$final_log" 'android_graph_presented .*confirmed=true' \
    "Dashboard lacks rendered-frame confirmation"
  if [[ "$product" == compat1 ]]; then
    for stage in open_first acceptance_update_fail acceptance_timeout; do
      require_v4_log_pattern "$final_log" \
        "android_reference_graph_event_dispatched experience_id=sos\\.example\\.agenda action=$stage" \
        "Agenda reference action $stage was not dispatched"
    done
    require_v4_log_pattern "$final_log" \
      'android_reference_graph_event_dispatched experience_id=sos\.example\.dashboard action=acceptance_ping' \
      "parent liveness action was not dispatched"
  else
    require_v4_log_pattern "$final_log" \
      'experience_action request_id=[0-9]+ action=open_first target=i-[^ ]+::agenda-open' \
      "Core Agenda open action did not cross the namespaced mount"
    require_v4_log_pattern "$final_log" \
      'experience_action request_id=[0-9]+ action=acceptance_update_fail target=i-[^ ]+::agenda-update-fail' \
      "Core Agenda update-failure action did not cross the namespaced mount"
    require_v4_log_pattern "$final_log" \
      'experience_action request_id=[0-9]+ action=acceptance_timeout target=i-[^ ]+::agenda-timeout' \
      "Core Agenda timeout action did not cross the namespaced mount"
    require_v4_log_pattern "$final_log" \
      'experience_action request_id=[0-9]+ action=acceptance_ping target=i-[^ ]+::dashboard-ping' \
      "Core parent liveness action did not reach Dashboard"
  fi
  require_v4_log_pattern "$final_log" \
    'android_graph_instance_failed .*experience_id=sos\.example\.agenda root_ready=true .*reference Agenda update failure' \
    "Agenda update failure was not contained"
  failed_count="$(grep -Ec 'android_graph_instance_failed .*experience_id=sos\.example\.agenda root_ready=true' "$final_log")"
  [[ "$failed_count" -ge 2 ]] || fail "Agenda timeout did not become a contained child failure"
  recovered_count="$(grep -Ec 'android_graph_instance_recovered .*experience_id=sos\.example\.agenda root_ready=true' "$final_log")"
  [[ "$recovered_count" -ge 2 ]] || fail "Agenda did not recover after both child failures"
  require_v4_log_pattern "$final_log" \
    "android_appearance_write_committed .*generation=$appearance_generation" \
    "authority appearance commit is missing"
  require_v4_log_pattern "$final_log" \
    "android_graph_refreshed .*appearance_generation=$appearance_generation failed_instances=0" \
    "appearance did not reach the healthy complete graph"
  runtime_ready_count="$(grep -Ec 'android_graph_runtime_ready .*root_experience=sos\.example\.dashboard instances=3' "$final_log")"
  [[ "$runtime_ready_count" -ge 2 ]] || \
    fail "host recovery did not restore Dashboard"
  require_v4_log_pattern "$final_log" 'android_system_control action=appearance_toggle' \
    "host-owned appearance control was not used"
  require_v4_log_pattern "$final_log" 'android_system_control action=dismiss_experience experience_id=sos\.example\.dashboard' \
    "host-owned Home control did not dismiss Dashboard"
  require_v4_log_pattern "$final_log" 'android_v4_candidate_staged graph_id=' \
    "Stock v4 authoring candidate was not staged"
  require_v4_log_pattern "$final_log" \
    'android_agent_activation_commit .*phase=committed authority=system-graph' \
    "Stock v4 authoring candidate lacks authority commit evidence"
  require_v4_log_pattern "$final_log" 'android_system_control action=rollback_graph' \
    "host-owned rollback control was not used"
  require_v4_log_pattern "$final_log" 'android_graph_rollback_presented graph_id=' \
    "v4 graph rollback lacks presentation evidence"
  require_v4_log_pattern "$final_log" 'accessibility_published bytes=[1-9][0-9]* semantics=[1-9][0-9]*' \
    "composed accessibility semantics were not published"
  require_v4_log_pattern "$final_log" 'scene_pointer phase=down' \
    "physical pointer down did not reach the namespaced scene"
  require_v4_log_pattern "$final_log" 'scene_pointer phase=up' \
    "physical pointer up did not reach the namespaced scene"

  dashboard_authority="$(v4_stage_pid "$evidence_root/stages/dashboard/pids.env" authority_pid)"
  host_authority="$(v4_stage_pid "$evidence_root/stages/host-restart/pids.env" authority_pid)"
  restarted_authority="$(v4_stage_pid "$evidence_root/stages/authority-restart/pids.env" authority_pid)"
  authored_authority="$(v4_stage_pid "$evidence_root/stages/authored/pids.env" authority_pid)"
  rollback_authority="$(v4_stage_pid "$evidence_root/stages/rollback/pids.env" authority_pid)"
  [[ "$dashboard_authority" =~ ^[0-9]+$ && "$host_authority" == "$dashboard_authority" && \
    "$host_authority" != "$restarted_authority" && \
    "$restarted_authority" == "$authored_authority" && \
    "$authored_authority" == "$rollback_authority" ]] || \
    fail "authority PID evidence does not isolate host and authority recovery"
  if [[ "$product" == compat1 ]]; then
    require_v4_log_pattern "$final_log" \
      'compat_ime_focus_transition .*to=i-[^ ]+::agenda-input .*lifecycle=active' \
      "Compat IME did not focus the namespaced mounted Agenda input"
    require_v4_log_pattern "$final_log" \
      'compat_ime_blur_resolved node_id=i-[^ ]+::agenda-input .*outcome=deactivate lifecycle=inactive' \
      "Compat mounted Agenda IME outside-blur routing is missing"
    require_v4_log_pattern "$final_log" \
      'GpuiPlatformView.*Accessibility tree updated: nodes=[1-9][0-9]*' \
      "Compat virtual accessibility tree did not reach Android"
    grep -F 'Dashboard' "$evidence_root/stages/dashboard/accessibility.xml" >/dev/null || \
      fail "Compat accessibility tree omits Dashboard"
    grep -F 'Open first agenda item' "$evidence_root/stages/dashboard/accessibility.xml" >/dev/null || \
      fail "Compat accessibility tree omits the namespaced Agenda action"
    grep -F 'Agenda child text input' "$evidence_root/stages/dashboard/accessibility.xml" >/dev/null || \
      fail "Compat accessibility tree omits the mounted Agenda text field"
    for control_label in 'Change system theme' 'Roll back Experience graph' 'Return to Stock'; do
      grep -F "$control_label" "$evidence_root/stages/dashboard/accessibility.xml" >/dev/null || \
        fail "Compat accessibility tree omits host control: $control_label"
    done
    grep -F "Today · appearance $appearance_generation" \
      "$evidence_root/stages/appearance/accessibility.xml" >/dev/null || \
      fail "Compat accessibility tree did not receive mounted appearance data"
    dashboard_host="$(v4_stage_pid "$evidence_root/stages/dashboard/pids.env" home_pid)"
    restarted_host="$(v4_stage_pid "$evidence_root/stages/host-restart/pids.env" home_pid)"
    authority_stage_host="$(v4_stage_pid "$evidence_root/stages/authority-restart/pids.env" home_pid)"
    authored_host="$(v4_stage_pid "$evidence_root/stages/authored/pids.env" home_pid)"
    rollback_host="$(v4_stage_pid "$evidence_root/stages/rollback/pids.env" home_pid)"
    [[ "$dashboard_host" =~ ^[0-9]+$ && "$restarted_host" =~ ^[0-9]+$ && \
      "$dashboard_host" != "$restarted_host" && "$restarted_host" == "$authority_stage_host" && \
      "$authority_stage_host" == "$authored_host" && "$authored_host" == "$rollback_host" ]] || \
      fail "Compat HOME PID evidence does not isolate host recovery"
  else
    require_v4_log_pattern "$final_log" 'core_input_touch action=down' \
      "Core physical touchscreen down is missing"
    require_v4_log_pattern "$final_log" 'core_input_touch action=up' \
      "Core physical touchscreen up is missing"
    require_v4_log_pattern "$final_log" \
      'core_native_software_keyboard node=i-[^ ]+::agenda-input visible=true' \
      "Core native IME did not open for the namespaced mounted Agenda input"
    require_v4_log_pattern "$final_log" \
      'core_native_software_keyboard node=i-[^ ]+::agenda-input visible=false' \
      "Core native IME did not close for the namespaced mounted Agenda input"
    dashboard_host="$(v4_stage_pid "$evidence_root/stages/dashboard/pids.env" core_host_pids)"
    restarted_host="$(v4_stage_pid "$evidence_root/stages/host-restart/pids.env" core_host_pids)"
    authority_stage_host="$(v4_stage_pid "$evidence_root/stages/authority-restart/pids.env" core_host_pids)"
    authored_host="$(v4_stage_pid "$evidence_root/stages/authored/pids.env" core_host_pids)"
    rollback_host="$(v4_stage_pid "$evidence_root/stages/rollback/pids.env" core_host_pids)"
    [[ "$dashboard_host" != "$restarted_host" && "$restarted_host" == "$authority_stage_host" && \
      "$authority_stage_host" == "$authored_host" && "$authored_host" == "$rollback_host" ]] || \
      fail "Core child PID evidence does not isolate host recovery"
    for stage in dashboard host-restart authority-restart authored rollback; do
      [[ "$(v4_stage_pid "$evidence_root/stages/$stage/pids.env" core_host_pids)" =~ \
        ^[0-9]+\ [0-9]+$ ]] || fail "Core stage $stage lacks two normalized host PIDs"
    done
    common_core_pids="$(comm -12 \
      <(tr ' ' '\n' <<<"$dashboard_host" | sed '/^$/d' | sort -u) \
      <(tr ' ' '\n' <<<"$restarted_host" | sed '/^$/d' | sort -u))"
    [[ -n "$common_core_pids" ]] || \
      fail "Core supervisor did not survive child recovery"
  fi

  printf 'v4_composition_campaign=PASS\nproduct=%s\nserial=%s\nrevision=%s\n' \
    "$product" "$serial" "$expected_revision" >"$evidence_root/verdict.txt"
  printf 'appearance_generation=%s\ncontained_failures=%s\nrecoveries=%s\n' \
    "$appearance_generation" "$failed_count" "$recovered_count" >>"$evidence_root/verdict.txt"
  printf 'campaign_elapsed_ns=%s\n' "$((campaign_finished - campaign_started))" \
    >>"$evidence_root/verdict.txt"
  evidence_manifest_generate --root "$evidence_root" --output "$evidence_root/manifest.tsv" >/dev/null
  evidence_manifest_verify --root "$evidence_root" --manifest "$evidence_root/manifest.tsv" >/dev/null
  cat "$evidence_root/verdict.txt"
  printf 'manifest=%s\n' "$evidence_root/manifest.tsv"
  info "v4 composition physical campaign passed with an independently verified manifest"
}

evidence_path_is_temporary() {
  [[ "$#" -eq 1 ]] || fail "internal usage: evidence_path_is_temporary <path>"
  case "${1##*/}" in
    .a33xctl-manifest.*|*.tmp|*.part|*.partial|*.swp|*~) return 0 ;;
    *) return 1 ;;
  esac
}

evidence_manifest_paths() {
  [[ "$#" -eq 2 ]] || fail "internal usage: evidence_manifest_paths <root> <manifest>"
  local evidence_root="$1" manifest="$2" path relative
  while IFS= read -r -d '' path; do
    [[ "$path" != "$manifest" ]] || continue
    [[ "$path" != *$'\t'* && "$path" != *$'\n'* ]] || \
      fail "evidence path contains a tab or newline"
    relative="$(realpath --relative-to="$evidence_root" "$path")"
    evidence_path_is_temporary "$relative" && continue
    printf '%s\0' "$path"
  done < <(find "$evidence_root" -type f -print0 | LC_ALL=C sort -z)
}

validate_evidence_paths() {
  [[ "$#" -eq 1 ]] || fail "internal usage: validate_evidence_paths <root>"
  local path
  while IFS= read -r -d '' path; do
    [[ "$path" != *$'\t'* && "$path" != *$'\n'* ]] || \
      fail "evidence path contains a tab or newline"
  done < <(find "$1" -type f -print0)
}

resolve_evidence_manifest() {
  [[ "$#" -eq 2 ]] || fail "internal usage: resolve_evidence_manifest <root> <manifest>"
  local evidence_root manifest
  evidence_root="$(realpath -e "$1")"
  [[ -d "$evidence_root" ]] || fail "evidence root is not a directory: $1"
  manifest="$(realpath -m "$2")"
  case "$manifest" in
    "$evidence_root"/*) ;;
    *) fail "evidence manifest must be inside its evidence root" ;;
  esac
  printf '%s\n%s\n' "$evidence_root" "$manifest"
}

evidence_manifest_generate() {
  [[ "$#" -eq 4 && "$1" == --root && "$3" == --output ]] || \
    fail "usage: ./tools/a33xctl evidence-manifest-generate --root DIR --output MANIFEST"
  require_command realpath
  require_command sha256sum
  local -a resolved
  mapfile -t resolved < <(resolve_evidence_manifest "$2" "$4")
  local evidence_root="${resolved[0]}" manifest="${resolved[1]}"
  local manifest_dir temporary path relative before after bytes sha count=0
  validate_evidence_paths "$evidence_root"
  manifest_dir="$(dirname "$manifest")"
  [[ -d "$manifest_dir" ]] || fail "manifest directory does not exist: $manifest_dir"
  temporary="$(mktemp "$manifest_dir/.a33xctl-manifest.XXXXXX")"
  trap 'rm -f -- "$temporary"' EXIT
  while IFS= read -r -d '' path; do
    relative="$(realpath --relative-to="$evidence_root" "$path")"
    before="$(stat --printf='%d:%i:%s:%y' "$path")"
    bytes="$(stat --printf='%s' "$path")"
    sha="$(sha256sum "$path" | cut -d' ' -f1)"
    after="$(stat --printf='%d:%i:%s:%y' "$path")"
    [[ "$before" == "$after" ]] || fail "evidence changed while hashing: $relative"
    printf '%s\t%s\t%s\n' "$relative" "$bytes" "$sha" >>"$temporary"
    count=$((count + 1))
  done < <(evidence_manifest_paths "$evidence_root" "$manifest")
  [[ "$count" -gt 0 ]] || fail "evidence root contains no finalized files"
  chmod 0644 "$temporary"
  mv -f -- "$temporary" "$manifest"
  trap - EXIT
  printf 'evidence_manifest=%s\nfiles=%s\n' "$manifest" "$count"
}

evidence_manifest_verify() {
  [[ "$#" -eq 4 && "$1" == --root && "$3" == --manifest ]] || \
    fail "usage: ./tools/a33xctl evidence-manifest-verify --root DIR --manifest MANIFEST"
  require_command realpath
  require_command sha256sum
  local -a resolved
  mapfile -t resolved < <(resolve_evidence_manifest "$2" "$4")
  local evidence_root="${resolved[0]}" manifest="${resolved[1]}"
  validate_evidence_paths "$evidence_root"
  [[ -f "$manifest" ]] || fail "evidence manifest is missing: $manifest"
  local path bytes sha extra absolute actual_bytes actual_sha previous='' count=0
  local expected_paths listed_paths
  expected_paths="$(while IFS= read -r -d '' absolute; do
    realpath --relative-to="$evidence_root" "$absolute"
  done < <(evidence_manifest_paths "$evidence_root" "$manifest"))"
  listed_paths="$(cut -f1 "$manifest")"
  [[ "$listed_paths" == "$expected_paths" ]] || \
    fail "evidence manifest paths are missing, extra, or not deterministically sorted"
  while IFS=$'\t' read -r path bytes sha extra || [[ -n "$path$bytes$sha$extra" ]]; do
    [[ -n "$path" && -z "$extra" && "$bytes" =~ ^[0-9]+$ && "$sha" =~ ^[0-9a-f]{64}$ ]] || \
      fail "malformed evidence manifest row"
    [[ "$path" != /* && "$path" != ../* && "$path" != */../* ]] || \
      fail "unsafe evidence manifest path: $path"
    [[ -z "$previous" || "$previous" < "$path" ]] || \
      fail "evidence manifest paths are duplicated or unsorted"
    absolute="$evidence_root/$path"
    [[ -f "$absolute" ]] || fail "manifested evidence file is missing: $path"
    actual_bytes="$(stat --printf='%s' "$absolute")"
    actual_sha="$(sha256sum "$absolute" | cut -d' ' -f1)"
    [[ "$actual_bytes" == "$bytes" && "$actual_sha" == "$sha" ]] || \
      fail "evidence identity mismatch: $path"
    previous="$path"
    count=$((count + 1))
  done <"$manifest"
  [[ "$count" -gt 0 ]] || fail "evidence manifest is empty"
  printf 'evidence_manifest_verified=PASS\nmanifest=%s\nfiles=%s\n' \
    "$manifest" "$count"
}

usage() {
  cat <<'EOF'
usage: ./tools/a33xctl <command>

commands:
  image             build the pinned Ubuntu 24.04 LineageOS host image
  doctor            validate host resources and container tooling
  install-host-usb-rules --group GROUP
                    install durable SM-A336B ADB/Recovery node access (requires root)
  init              initialize the separate LineageOS checkout
  sync              sync sources and record an immutable resolved manifest
  hydrate-lfs       fetch and verify the pinned ARM64 WebView LFS object
  apply-patches      apply the audited local a33x source backports
  stage-sos          stage ARM64 SOS product sources and prebuilts
  check-product-graph
                    verify profile marker selection and distinct install paths
  check-agent-runner-contract [BUNDLE]
                    verify the exact bundled OpenRouter assignment and request guard
  check-core-runtime-model-contract RUNTIME
                    verify Core's pinned model bytes and mismatch rejection boundary
  build-recovery    build only the a33x recovery image
  inspect-recovery  report size, SHA-256, file type, and AVB metadata
  build-rom         build the complete a33x LineageOS install package
  inspect-rom       verify and identify the package and boot-chain images
  build-compat0     build SOS-as-HOME with Android ceremonies retained
  build-compat1     build native SOS with the Android app runtime island
  build-compat      compatibility alias for build-compat1
  build-core-shadow build the manual native display/GPUI probe target
  build-core1       build the no-Zygote native locked/recovery target
  build-core1-provider-probe
                    build a non-shipping Core 1 provider-acceptance test OTA
  build-core        compatibility alias for build-core-shadow
  build-sos         compatibility alias for build-compat
  inspect-compat0   verify Compat 0 packaging and boot-chain graph
  inspect-compat1   verify native Compat, its system IME, and UI-package removal
  inspect-sos       compatibility alias for inspect-compat1
  inspect-core      verify Core Shadow and retained recovery UI
  inspect-core1     verify no-Zygote native-only packaging
  inspect-core1-provider-probe
                    verify the non-shipping trusted provider probe is present
  inspect-core1-readiness --serial SERIAL --expected-revision REVISION
                    read-only exact-product Core 1 readiness snapshot
  restart-v4-authority --serial SERIAL --expected-revision REVISION
                    restart only the authority through the userdebug recovery probe
  capture-v4-composition-stage --product compat1|core1 --serial SERIAL
                    --expected-revision REVISION --artifact OTA --root DIR --stage STAGE
                    capture one ordered physical v4 composition checkpoint
  audit-v4-composition-campaign --root DIR
                    judge all physical v4 checkpoints and seal their manifest
  evidence-manifest-generate --root DIR --output MANIFEST
                    atomically record finalized evidence path/size/SHA-256
  evidence-manifest-verify --root DIR --manifest MANIFEST
                    independently verify a finalized evidence manifest
legacy migration commands (not release-supported):
  build-core0b      require SOS_ENABLE_LEGACY_CORE0B_BUILD=1, then build Core 0B
  inspect-core0b    verify an intentional Core 0B comparison build
EOF
}

