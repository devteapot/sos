build_sos_profile() {
  [[ "$#" -ge 1 && "$#" -le 2 ]] || \
    fail "internal usage: build_sos_profile <compat0|compat1|shadow|core0b|core1> [provider-probe]"
  local profile="$1" runtime_variant="${2:-release}"
  local target_device staged_input_sha apk_flags
  local core_runtime_features=core-native
  case "$profile" in
    compat0)
      target_device="$LINEAGE_SOS_COMPAT0_DEVICE"
      apk_flags="--home"
      ;;
    compat1)
      target_device="$LINEAGE_SOS_COMPAT1_DEVICE"
      apk_flags="--home --compat"
      ;;
    shadow)
      target_device="$LINEAGE_SOS_CORE_SHADOW_DEVICE"
      apk_flags="--home"
      ;;
    core0b)
      target_device="$LINEAGE_SOS_CORE0B_DEVICE"
      apk_flags="--home"
      ;;
    core1)
      target_device="$LINEAGE_SOS_CORE1_DEVICE"
      apk_flags="--home"
      ;;
    *) fail "unsupported SOS profile: $profile" ;;
  esac
  if [[ "$runtime_variant" == provider-probe ]]; then
    [[ "$profile" == core1 ]] || \
      fail "the non-shipping provider probe is restricted to Core 1"
    core_runtime_features=core-native,core-provider-acceptance
    info "enabling the non-shipping Core 1 provider acceptance probe"
  elif [[ "$runtime_variant" != release ]]; then
    fail "unsupported SOS runtime variant: $runtime_variant"
  fi
  check_product_graph
  [[ -f "$LINEAGE_ROOT/build/envsetup.sh" ]] || fail "run init and sync first"
  hydrate_source_lfs
  apply_source_patches
  # shellcheck disable=SC2086 # apk_flags is a controlled internal option list.
  "$SOS_ROOT/tools/sosctl" m1-build --abi arm64-v8a $apk_flags
  info "building the standalone ARM64 Core GPUI runtime"
  (
    cd "$SOS_ROOT"
    cargo ndk --link-libcxx-shared -t arm64-v8a -P 31 build \
      -p sos-experience \
      --release \
      --locked \
      --no-default-features \
      --features "$core_runtime_features"
  )
  install -m 0644 \
    "$SOS_ROOT/target/aarch64-linux-android/release/libsos_experience.so" \
    "$SOS_ROOT/artifacts/libsos_core_experience.so"
  "$SOS_ROOT/tools/build-android-node"
  (
    cd "$SOS_ROOT/services/sos-agent"
    npm ci --ignore-scripts
    npm run build
  )
  info "building the ARM64 on-device SOS authority"
  (
    cd "$SOS_ROOT"
    cargo ndk -t arm64-v8a -P 31 build \
      -p android-system-authority \
      --bin sos-android-system-authority \
      --release \
      --locked
  )
  stage_sos
  local sos_revision build_number
  sos_revision="$(git -C "$SOS_ROOT" rev-parse --short=12 HEAD)"
  # Every product identity covers the complete staged SOS device tree and the
  # audited source patches. This avoids stale identities when a policy,
  # overlay, bridge, native host, product composition, or packaged prebuilt
  # changes.
  staged_input_sha="$({
    find "$LINEAGE_SOS_OVERLAY_DESTINATION" -type f -print0 | sort -z | \
      xargs -0 sha256sum
    find "$LINEAGE_PATCH_DIR" -maxdepth 1 -type f -name '*.patch' -print0 | \
      sort -z | xargs -0 sha256sum
  } | sha256sum | cut -d' ' -f1)"
  build_number="sos.${profile}.${sos_revision}.${staged_input_sha:0:12}"
  mkdir -p "$LINEAGE_CCACHE"
  # These images embed BUILD_NUMBER in AVB descriptors but Ninja does not track
  # that environment value as an input. Invalidate only the generated
  # boot-chain outputs and image metadata so a product/profile switch cannot
  # package a stale fingerprint into otherwise-current target files.
  rm -f -- \
    "$LINEAGE_ROOT/out/target/product/a33x/boot.img" \
    "$LINEAGE_ROOT/out/target/product/a33x/dtbo.img" \
    "$LINEAGE_ROOT/out/target/product/a33x/recovery.img" \
    "$LINEAGE_ROOT/out/target/product/a33x/vendor_boot.img" \
    "$LINEAGE_ROOT/out/target/product/a33x/vbmeta.img" \
    "$LINEAGE_ROOT/out/target/product/a33x/misc_info.txt"
  info "building SOS $profile target lineage_$target_device as $build_number"
  container env "BUILD_NUMBER=$build_number" bash -lc \
    "ccache -M '$LINEAGE_CCACHE_SIZE' && source build/envsetup.sh && breakfast '$target_device' && m -j'$LINEAGE_JOBS' bacon"
}

