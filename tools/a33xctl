  grep -F '#include "dev_credential_protocol_v1.h"' "$client" >/dev/null && \
    grep -F '/core_dev_credential_protocol_v1.rs' "$endpoint" >/dev/null && \
    grep -F '#define SOS_CORE_DEV_V1_REQUEST_HEADER_BYTES 8' "$protocol" >/dev/null && \
