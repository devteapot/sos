inspect_recovery() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl inspect-recovery"
  local image="$LINEAGE_ROOT/out/target/product/a33x/recovery.img"
  [[ -f "$image" ]] || fail "recovery image missing; run build-recovery first"
  [[ "$(stat --printf='%s' "$image")" == 100663296 ]] || \
    fail "recovery image does not match the live SM-A336B PIT size"
  stat --printf='recovery=%n\nbytes=%s\n' "$image"
  sha256sum "$image"
  file "$image"
  container bash -lc \
    "set -euo pipefail
     image='$image'
     inspect_dir=\$(mktemp -d /tmp/a33x-recovery-inspect.XXXXXX)
     trap 'rm -rf -- \"\$inspect_dir\"' EXIT
     out/host/linux-x86/bin/avbtool info_image --image \"\$image\"
     out/host/linux-x86/bin/avbtool verify_image \
       --image \"\$image\" \
       --key external/avb/test/data/testkey_rsa4096.pem
     out/host/linux-x86/bin/unpack_bootimg \
       --boot_img \"\$image\" --out \"\$inspect_dir\" >/dev/null
     out/host/linux-x86/bin/lz4 -dc \"\$inspect_dir/ramdisk\" | \
       cpio -it 2>/dev/null | grep -Fx init.recovery.s5e8825.rc
     out/host/linux-x86/bin/lz4 -dc \"\$inspect_dir/ramdisk\" | \
       cpio -i --to-stdout init.recovery.s5e8825.rc 2>/dev/null | \
       cmp - device/samsung/s5e8825-common/configs/init/init.s5e8825.recovery.rc
     printf 'recovery_device_init=VERIFIED\\n'"
}

inspect_rom() {
  [[ "$#" -le 1 ]] || fail "usage: ./tools/a33xctl inspect-rom [target-product]"
  local product_out="$LINEAGE_ROOT/out/target/product/a33x"
  local package package_name package_suffix bootstrap_dir target_files build_command
  local target_product="${1:-lineage_a33x}"
  case "$target_product" in
    lineage_a33x)
      package_suffix=a33x
      build_command=build-rom
      ;;
    lineage_sos_compat_a33x)
      package_suffix=sos_compat_a33x
      build_command=build-compat
      ;;
    lineage_sos_compat0_a33x)
      package_suffix=sos_compat0_a33x
      build_command=build-compat0
      ;;
    lineage_sos_core_a33x)
      package_suffix=sos_core_a33x
      build_command=build-core
      ;;
    lineage_sos_core0b_a33x)
      package_suffix=sos_core0b_a33x
      build_command=build-core0b
      ;;
    lineage_sos_core1_a33x)
      package_suffix=sos_core1_a33x
      build_command=build-core1
      ;;
    *) fail "unsupported a33x target product: $target_product" ;;
  esac
  package="$(find "$product_out" -maxdepth 1 -type f \
    -name "lineage-23.0-*-UNOFFICIAL-${package_suffix}.zip" -printf '%T@ %p\n' | \
    sort -nr | head -n 1 | cut -d' ' -f2-)"
  [[ -n "$package" && -f "$package" ]] || \
    fail "install package missing; run ./tools/a33xctl $build_command first"
  package_name="$(basename "$package" .zip)"
  bootstrap_dir="${SOS_SAMSUNG_WORK:-$HOME/sos-samsung-work}/lineage-a33x/${package_name}-bootstrap"
  target_files="$product_out/obj/PACKAGING/target_files_intermediates/${target_product}-target_files/IMAGES"
  [[ -d "$target_files" ]] || fail "target-files image directory missing"
  stat --printf='package=%n\nbytes=%s\n' "$package"
  sha256sum "$package"
  unzip -tq "$package"
  local entry
  for entry in \
    META-INF/com/google/android/update-binary \
    META-INF/com/google/android/updater-script \
    boot.img dtbo.img recovery.img vbmeta.img vendor_boot.img; do
    [[ "$(unzip -Z1 "$package" "$entry")" == "$entry" ]] || \
      fail "required install-package entry missing: $entry"
  done
  container python3 build/make/tools/releasetools/check_ota_package_signature.py \
    build/make/target/product/security/testkey.x509.pem "$package"

  mkdir -p "$bootstrap_dir"
  unzip -oq "$package" \
    boot.img dtbo.img recovery.img vbmeta.img vendor_boot.img \
    -d "$bootstrap_dir"
  printf 'bootstrap_dir=%s\n' "$bootstrap_dir"

  # Exact byte ceilings from the verified 48-entry SM-A336B live PIT.
  local -A partition_size=(
    [boot]=67108864
    [dtbo]=8388608
    [recovery]=100663296
    [vbmeta]=65536
    [vendor_boot]=33554432
  )
  local image image_bytes package_image
  for image in boot dtbo recovery vbmeta vendor_boot; do
    package_image="$bootstrap_dir/$image.img"
    [[ -f "$package_image" ]] || fail "$image.img missing from extracted install package"
    [[ -f "$target_files/$image.img" ]] || fail "$image.img missing from target-files images"
    cmp -s "$package_image" "$target_files/$image.img" || \
      fail "$image.img differs between the install package and target-files images"
    image_bytes="$(stat --printf='%s' "$package_image")"
    [[ "$image_bytes" -le "${partition_size[$image]}" ]] || \
      fail "$image.img is $image_bytes bytes, larger than the verified PIT ceiling ${partition_size[$image]}"
    stat --printf='%n %s bytes\n' "$package_image"
    printf 'PIT ceiling: %s bytes (pass)\n' "${partition_size[$image]}"
    sha256sum "$package_image"
    container bash -lc \
      "out/host/linux-x86/bin/avbtool info_image --image '$target_files/$image.img'"
    if [[ "$image" != vbmeta ]]; then
      container bash -lc \
        "out/host/linux-x86/bin/avbtool verify_image --image '$target_files/$image.img'"
    fi
  done
  container bash -lc \
    "cd '$target_files' && '$LINEAGE_ROOT/out/host/linux-x86/bin/avbtool' verify_image --image vbmeta.img"
  local expected_incremental actual_incremental
  expected_incremental="$(sed -n 's/^ro\.system_ext\.build\.version\.incremental=//p' \
    "$product_out/obj/PACKAGING/target_files_intermediates/${target_product}-target_files/SYSTEM_EXT/etc/build.prop")"
  [[ -n "$expected_incremental" ]] || fail "system_ext incremental is missing"
  for image in boot dtbo recovery vendor_boot odm product system system_ext vendor vendor_dlkm; do
    actual_incremental="$(container out/host/linux-x86/bin/avbtool info_image \
      --image "$target_files/$image.img" | \
      sed -n "s/.*fingerprint -> '.*\/\([^/:]*\):userdebug\/test-keys'.*/\1/p")"
    [[ "$actual_incremental" == "$expected_incremental" ]] || \
      fail "$image AVB incremental $actual_incremental differs from $expected_incremental"
  done
  container bash -lc \
    "set -euo pipefail
     image='$target_files/recovery.img'
     inspect_dir=\$(mktemp -d /tmp/a33x-package-recovery-inspect.XXXXXX)
     trap 'rm -rf -- \"\$inspect_dir\"' EXIT
     out/host/linux-x86/bin/unpack_bootimg \
       --boot_img \"\$image\" --out \"\$inspect_dir\" >/dev/null
     out/host/linux-x86/bin/lz4 -dc \"\$inspect_dir/ramdisk\" | \
       cpio -it 2>/dev/null | grep -Fx init.recovery.s5e8825.rc
     out/host/linux-x86/bin/lz4 -dc \"\$inspect_dir/ramdisk\" | \
       cpio -i --to-stdout init.recovery.s5e8825.rc 2>/dev/null | \
       cmp - device/samsung/s5e8825-common/configs/init/init.s5e8825.recovery.rc
     printf 'package_recovery_device_init=VERIFIED\\n'"
}

inspect_compat_profile() {
  [[ "$#" -eq 1 ]] || fail "internal usage: inspect_compat_profile <compat0|compat1>"
  local profile="$1" target_product expected_stage expected_owner build_profile
  case "$profile" in
    compat0)
      target_product=lineage_sos_compat0_a33x
      expected_stage=0
      expected_owner=android-ceremonies
      build_profile=compat0
      ;;
    compat1)
      target_product=lineage_sos_compat_a33x
      expected_stage=1
      expected_owner=native-sos-android-runtime
      build_profile=compat1
      ;;
    *) fail "unsupported SOS Compat profile: $profile" ;;
  esac
  inspect_rom "$target_product"
  local target_files="$LINEAGE_ROOT/out/target/product/a33x/obj/PACKAGING/target_files_intermediates/${target_product}-target_files"
  local apk="$target_files/SYSTEM_EXT/priv-app/SosShell/SosShell.apk"
  local authority="$target_files/SYSTEM_EXT/bin/sos-authority"
  local node="$target_files/SYSTEM_EXT/bin/sos-node"
  local node_cxx="$target_files/SYSTEM_EXT/lib64/libc++_shared.so"
  local agent_runner="$target_files/SYSTEM_EXT/etc/sos-agent/agent-runner.cjs"
  local agent_api="$target_files/SYSTEM_EXT/etc/sos-agent/experience-api.md"
  local agent_example_primary="$target_files/SYSTEM_EXT/etc/sos-agent/example-primary.luau"
  local bootstrap="$target_files/SYSTEM_EXT/etc/sos/mobile.luau"
  local bootstrap_package="$target_files/SYSTEM_EXT/etc/sos/mobile.package.json"
  local stock_theme="$target_files/SYSTEM_EXT/etc/sos/modules/mobile-theme.luau"
  local init_rc="$target_files/SYSTEM_EXT/etc/init/sos-authority.rc"
  local properties="$target_files/SYSTEM_EXT/etc/build.prop"
  local seapp_contexts="$target_files/SYSTEM_EXT/etc/selinux/system_ext_seapp_contexts"
  local file_contexts="$target_files/SYSTEM_EXT/etc/selinux/system_ext_file_contexts"
  local property_contexts="$target_files/SYSTEM_EXT/etc/selinux/system_ext_property_contexts"
  local system_ext_policy="$target_files/SYSTEM_EXT/etc/selinux/system_ext_sepolicy.cil"
  local privapp_permissions="$target_files/SYSTEM_EXT/etc/permissions/privapp-permissions-sos.xml"
  local latin_ime_apk="$target_files/PRODUCT/app/LatinIME/LatinIME.apk"
  local artifact
  for artifact in \
    "$apk" "$authority" "$node" "$node_cxx" "$agent_runner" "$agent_api" \
    "$agent_example_primary" "$bootstrap" \
    "$bootstrap_package" "$stock_theme" "$init_rc" "$properties" \
    "$seapp_contexts" "$file_contexts" "$property_contexts" \
    "$system_ext_policy" "$privapp_permissions"; do
    [[ -f "$artifact" ]] || fail "SOS target-files artifact missing: $artifact"
    stat --printf='%n %s bytes\n' "$artifact"
    sha256sum "$artifact"
  done
  grep -Fx \
    'sys.sos.authority_recovery_probe u:object_r:sos_authority_recovery_probe_prop:s0 exact bool' \
    "$property_contexts" >/dev/null || \
    fail "SOS authority recovery probe property has the wrong installed label or type"
  grep -F \
    '(allow shell sos_authority_recovery_probe_prop (property_service (set)))' \
    "$system_ext_policy" >/dev/null || \
    fail "SOS userdebug policy omitted the bounded authority recovery permission"
  unzip -tq "$apk"
  [[ "$(unzip -Z1 "$apk" | sed -n 's|^lib/\([^/]*\)/.*|\1|p' | sort -u)" == arm64-v8a ]] || \
    fail "packaged SOS APK is not ARM64-only"
  unzip -Z1 "$apk" | grep -Fx lib/arm64-v8a/libsos_experience.so >/dev/null || \
    fail "packaged SOS APK does not contain its ARM64 experience library"
  local manifest_dump
  manifest_dump="$(container out/host/linux-x86/bin/aapt2 dump xmltree \
    --file AndroidManifest.xml "$apk")"
  grep -F 'package="dev.sos.experience"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS APK has the wrong application ID"
  grep -F '="dev.sos.experience.SosHomeActivity"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS APK is missing its HOME activity alias"
  grep -F '="android.intent.category.HOME"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS APK is not HOME-enabled"
  grep -E ':priority\([^)]*\)=1000$' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS HOME must retain priority 1000 over Launcher3 fallback"
  grep -E ':versionCode\([^)]*\)=2$' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS APK does not carry the cache-invalidating version bump"
  if grep -F ':debuggable' <<<"$manifest_dump" | grep -Fv '=false' >/dev/null; then
    fail "packaged SOS APK must not be debuggable"
  fi
  grep -F ':allowBackup' <<<"$manifest_dump" | grep -F '=false' >/dev/null || \
    fail "packaged SOS APK must disable application backup"
  grep -F '="android.permission.FOREGROUND_SERVICE"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS APK omitted foreground-service permission"
  grep -F '="android.permission.FOREGROUND_SERVICE_DATA_SYNC"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS APK omitted data-sync foreground-service permission"
  grep -F '="dev.gpui.mobile.GpuiAgentService"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS APK omitted the native Pi foreground service"
  grep -F ':foregroundServiceType' <<<"$manifest_dump" | grep -F '=0x00000001' >/dev/null || \
    fail "packaged SOS Pi service must declare the dataSync foreground type"
  grep -F '="android.permission.MANAGE_ROLE_HOLDERS"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS HOME cannot enforce the HOME role"
  grep -F '<permission name="android.permission.STATUS_BAR" />' \
    "$privapp_permissions" >/dev/null || \
    fail "packaged SOS Compat omitted its STATUS_BAR privapp allowlist"
  grep -F '="dev.gpui.mobile.SosBootReceiver"' <<<"$manifest_dump" >/dev/null || \
    fail "packaged SOS HOME omitted its boot-time ownership policy"
  if [[ "$profile" == compat0 ]]; then
    [[ -f "$latin_ime_apk" ]] || \
      fail "SOS Compat 0 lost its retained Android keyboard"
  fi
  if [[ "$profile" == compat1 ]]; then
    for component in \
      dev.gpui.mobile.SosCompatChromeService \
      dev.gpui.mobile.SosAttentionListenerService \
      dev.gpui.mobile.SosSystemAttentionReceiver; do
      grep -F "=\"$component\"" <<<"$manifest_dump" >/dev/null || \
        fail "SOS Compat 1 component missing: $component"
    done
    grep -F '="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"' \
      <<<"$manifest_dump" >/dev/null || \
      fail "SOS Compat 1 attention broker lacks its system binding boundary"
    grep -F '="android.permission.SYSTEM_APPLICATION_OVERLAY"' \
      <<<"$manifest_dump" >/dev/null || \
      fail "SOS Compat 1 chrome cannot remain visible over protected Activities"
    grep -F '="dev.sos.permission.REPORT_HOME_HEARTBEAT"' \
      <<<"$manifest_dump" >/dev/null || \
      fail "SOS Compat 1 omitted its signed HOME-health boundary"
    grep -F '="dev.sos.permission.REPORT_ADB_CONSENT"' \
      <<<"$manifest_dump" >/dev/null || \
      fail "SOS Compat 1 HOME omitted its signed ADB-consent result boundary"
    grep -F '="android.permission.HIDE_OVERLAY_WINDOWS"' \
      <<<"$manifest_dump" >/dev/null || \
      fail "SOS Compat 1 ADB consent surface cannot suppress untrusted overlays"
    local home_adb_consent_activity
    home_adb_consent_activity="$(grep -F -A12 \
      '="dev.gpui.mobile.SosAdbConfirmationActivity"' <<<"$manifest_dump")"
    [[ -n "$home_adb_consent_activity" ]] || \
      fail "SOS Compat 1 HOME omitted its ADB consent surface"
    grep -F ':enabled' <<<"$home_adb_consent_activity" | grep -F '=true' >/dev/null || \
      fail "SOS Compat 1 ADB consent surface is disabled"
    grep -F ':directBootAware' <<<"$home_adb_consent_activity" | grep -F '=true' >/dev/null || \
      fail "SOS Compat 1 ADB consent surface is not direct-boot-aware"
    grep -F ':exported' <<<"$home_adb_consent_activity" | grep -F '=true' >/dev/null || \
      fail "SOS Compat 1 ADB consent surface cannot be reached by system_server"
    grep -F '="android.permission.MANAGE_DEBUGGING"' \
      <<<"$home_adb_consent_activity" >/dev/null || \
      fail "SOS Compat 1 ADB consent surface lacks its system_server boundary"
    grep -F 'E: queries' <<<"$manifest_dump" >/dev/null || \
      fail "SOS Compat 1 omitted its launcher-only package visibility query"
    grep -F -A8 'E: queries' <<<"$manifest_dump" | \
      grep -F '="android.intent.category.LAUNCHER"' >/dev/null || \
      fail "SOS Compat 1 package query is not scoped to launcher Activities"
    grep -F ':persistent' <<<"$manifest_dump" | grep -F '=false' >/dev/null || \
      fail "native Compat NativeActivity process must be restartable"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'sos_window_mode=full-frame decor_fits_system_windows=false' >/dev/null || \
      fail "native Compat HOME omitted full-frame inset ownership"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'Ldev/gpui/mobile/SosWindowPolicy;' >/dev/null || \
      fail "native Compat omitted its shared full-frame window policy"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'Ldev/gpui/mobile/SosFixedActivity;' >/dev/null || \
      fail "native Compat fixed Java surfaces can drift from HOME window lifecycle"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'Ldev/gpui/mobile/SosVisibleIdentity;' >/dev/null || \
      fail "native Compat omitted its SOS-owned visible identity policy"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'sos://mobile/navigate/' >/dev/null || \
      fail "native Compat controls cannot navigate the Stock Mobile launcher"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'compat_chrome_visibility=hidden owner=stock-mobile' >/dev/null || \
      fail "native Compat chrome can cover the Stock Mobile owner"
    if unzip -p "$apk" 'classes*.dex' | strings | \
      grep -E 'SosCompatWorkspaceActivity|SosAttentionActivity' >/dev/null; then
      fail "native Compat retained a Java-owned launcher or attention screen"
    fi
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'transition_reveal=atomic controls=back,apps,attention,exit' >/dev/null || \
      fail "native Compat chrome can expose a partially rendered transition frame"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'owner_visibility=guarded' >/dev/null || \
      fail "native Compat chrome reveal is not guarded by the current surface owner"
    local ime_bridge_marker
    for ime_bridge_marker in \
      'ime_activate focus_requested=' \
      'ime_input_connection_created active=' \
      'ime_show_requested reason=' \
      'legacy_accepted=' \
      'controller_requested=' \
      'anchor_contract=in_window_nonzero_alpha_noninteractive' \
      'attached=' \
      'token=' \
      'shown=' \
      'alpha=' \
      'laid_out=' \
      'view_focused=' \
      'window_focused=' \
      'size=' \
      'visible_bounds=' \
      'imm_active='; do
      unzip -p "$apk" 'classes*.dex' | strings | \
        grep -F "$ime_bridge_marker" >/dev/null || \
        fail "native Compat HOME omitted IME bridge diagnostic: $ime_bridge_marker"
    done
    for semantic_marker in \
      'compat_semantic_input_focus action=click' \
      'compat_app_action action=back ime_precedence=platform_key_dispatch'; do
      unzip -p "$apk" 'classes*.dex' | strings | grep -F "$semantic_marker" >/dev/null || \
        fail "native Compat HOME omitted input marker: $semantic_marker"
    done
    if unzip -p "$apk" 'classes*.dex' | strings | \
      grep -F 'Android executes the selected app' >/dev/null; then
      fail "native Compat workspace retains Android-owned presentation copy"
    fi
    local disabled_ceremony
    for disabled_ceremony in \
      dev.gpui.mobile.GpuiPickerActivity \
      dev.gpui.mobile.GpuiPermissionActivity \
      dev.gpui.mobile.GpuiAuthActivity; do
      grep -F -A2 "=\"$disabled_ceremony\"" <<<"$manifest_dump" | \
        grep -F ':enabled' | grep -F '=false' >/dev/null || \
        fail "native Compat Android ceremony remains enabled: $disabled_ceremony"
    done
    local framework_overlay="$target_files/PRODUCT/overlay/SosCompat1FrameworkOverlay.apk"
    [[ -f "$framework_overlay" ]] || \
      fail "SOS Compat 1 framework overlay is missing"
    [[ ! -e "$target_files/PRODUCT/overlay/SosCompat1SystemUiOverlay.apk" ]] || \
      fail "native Compat must not depend on a SystemUI presentation overlay"

    local host="$target_files/SYSTEM_EXT/bin/sos-core-host"
    local host_runtime="$target_files/SYSTEM_EXT/lib64/libsos_core_experience.so"
    local host_init_rc="$target_files/SYSTEM_EXT/etc/init/sos-core-host.rc"
    local bridge_apk="$target_files/SYSTEM_EXT/priv-app/SosFrameworkBridge/SosFrameworkBridge.apk"
    local marker="$target_files/SYSTEM_EXT/bin/sos-compat-ui-removal-marker"
    local core_marker="$target_files/SYSTEM_EXT/bin/sos-ui-removal-marker"
    local services_jar="$target_files/SYSTEM/framework/services.jar"
    local system_ext_policy="$target_files/SYSTEM_EXT/etc/selinux/system_ext_sepolicy.cil"
    for artifact in \
      "$host" "$host_runtime" "$host_init_rc" "$bridge_apk" "$framework_overlay" "$marker" \
      "$latin_ime_apk" \
      "$services_jar" "$system_ext_policy"; do
      [[ -f "$artifact" ]] || fail "native Compat artifact missing: $artifact"
      stat --printf='%n %s bytes\n' "$artifact"
      sha256sum "$artifact"
    done
    local bridge_manifest_dump
    bridge_manifest_dump="$(container out/host/linux-x86/bin/aapt2 dump xmltree \
      --file AndroidManifest.xml "$bridge_apk")"
    grep -F 'package="dev.sos.frameworkbridge"' <<<"$bridge_manifest_dump" >/dev/null || \
      fail "SOS framework bridge has the wrong application ID"
    grep -F '="android.permission.INTERNET"' <<<"$bridge_manifest_dump" >/dev/null || \
      fail "SOS framework bridge omitted the system UID socket-create permission"
    file "$host" | grep -F 'ARM aarch64' >/dev/null || \
      fail "native Compat host is not AArch64"
    file "$host_runtime" | grep -F 'ARM aarch64' >/dev/null || \
      fail "native Compat GPUI runtime is not AArch64"
    strings "$host_runtime" | grep -F \
      'SOS experience window is live frame_padding=none' >/dev/null || \
      fail "native Compat GPUI runtime still reserves Android-style frame bands"
    check_android_v4_system_controls "$host_runtime"
    file "$marker" | grep -F 'ARM aarch64' >/dev/null || \
      fail "native Compat UI-removal marker is not AArch64"
    [[ ! -e "$core_marker" ]] || \
      fail "native Compat packaged the Core UI-removal marker"
    strings "$host" | grep -F \
      'native_compat_handoff target=sos-home android_system_ui=false' >/dev/null || \
      fail "native Compat host omitted its post-unlock SOS HOME handoff"
    strings "$host" | grep -F \
      'trusted_lock_ready bridge=headless-framework credential=pending' >/dev/null || \
      fail "native Compat host does not resolve credentials before drawing controls"
    strings "$host" | grep -F \
      'native_compat_control_ready transport=local_socket peer=system' >/dev/null || \
      fail "native Compat host omitted its runtime lock control boundary"
    strings "$host" | grep -F \
      'native_runtime_unlock_complete credential=' >/dev/null || \
      fail "native Compat host omitted its runtime re-lock completion"
    strings "$host" | grep -F \
      'framework_bridge_status ready=true credential_type=' >/dev/null || \
      fail "native Compat host still conflates credential NONE with bridge readiness"
    strings "$host" | grep -F \
      'native_compat_home_failed action=restart-home' >/dev/null || \
      fail "native Compat host omitted post-handoff HOME restart"
    strings "$host" | grep -F \
      'native_compat_home_restart_failed action=fixed-recovery' >/dev/null || \
      fail "native Compat host omitted failed-restart fixed recovery"
    grep -Fx \
      'on property:init.svc.surfaceflinger=running && property:ro.sos.core.autostart=preunlock' \
      "$host_init_rc" >/dev/null || fail "native Compat does not start before unlock"
    grep -Fx 'ro.sos.core.autostart=preunlock' "$properties"
    grep -Fx 'ro.sos.core.stage=compat' "$properties"
    grep -Fx 'ro.sos.block_android_system_activities=true' "$properties"
    ! grep -Fx 'ro.sos.block_android_activities=true' "$properties" >/dev/null || \
      fail "native Compat must allow selected Android application Activities"
    unzip -p "$services_jar" 'classes*.dex' | strings | \
      grep -F 'SOS Compat blocked Android system Activity:' >/dev/null || \
      fail "native Compat framework omitted its Android system-Activity block"
    unzip -p "$services_jar" 'classes*.dex' | strings | \
      grep -F 'dev.sos.experience' >/dev/null || \
      fail "native Compat framework membrane blocks SOS HOME system surfaces"
    unzip -p "$services_jar" 'classes*.dex' | strings | \
      grep -F 'SOS Compat blocked redirected Android system Activity:' >/dev/null || \
      fail "native Compat framework omitted its post-redirection Activity block"
    unzip -p "$services_jar" 'classes*.dex' | strings | \
      grep -F 'SOS Compat suppressed Android crash dialog for' >/dev/null || \
      fail "native Compat framework omitted its Android crash-dialog block"
    unzip -p "$services_jar" 'classes*.dex' | strings | \
      grep -F 'SOS Compat suppressed Android ANR dialog for' >/dev/null || \
      fail "native Compat framework omitted its Android ANR-dialog block"
    unzip -p "$services_jar" 'classes*.dex' | strings | \
      grep -F 'SOS Compat silenced Android system window type=' >/dev/null || \
      fail "native Compat framework omitted its system-window presentation membrane"

    local latin_ime_manifest latin_ime_service
    latin_ime_manifest="$(container out/host/linux-x86/bin/aapt2 dump xmltree \
      --file AndroidManifest.xml "$latin_ime_apk")"
    grep -F 'package="com.android.inputmethod.latin"' \
      <<<"$latin_ime_manifest" >/dev/null || \
      fail "native Compat packaged the wrong system IME"
    grep -F ':directBootAware' <<<"$latin_ime_manifest" | grep -F '=true' >/dev/null || \
      fail "native Compat system IME is not direct-boot-aware"
    ! grep -F ':sharedUserId' <<<"$latin_ime_manifest" >/dev/null || \
      fail "native Compat system IME must retain its application UID boundary"
    latin_ime_service="$(grep -F -A8 \
      '="com.android.inputmethod.latin.LatinIME"' <<<"$latin_ime_manifest")"
    [[ -n "$latin_ime_service" ]] || \
      fail "native Compat system IME service is missing"
    grep -F '="android.permission.BIND_INPUT_METHOD"' \
      <<<"$latin_ime_service" >/dev/null || \
      fail "native Compat system IME service lacks BIND_INPUT_METHOD"
    grep -F ':exported' <<<"$latin_ime_service" | grep -F '=true' >/dev/null || \
      fail "native Compat system IME service is not exported"
    grep -F '="android.view.InputMethod"' <<<"$latin_ime_service" >/dev/null || \
      fail "native Compat system IME service lacks its InputMethod action"

    local bridge_manifest
    bridge_manifest="$(container out/host/linux-x86/bin/aapt2 dump xmltree \
      --file AndroidManifest.xml "$bridge_apk")"
    grep -F 'package="dev.sos.frameworkbridge"' <<<"$bridge_manifest" >/dev/null || \
      fail "native Compat packaged the wrong framework bridge"
    [[ "$(grep -Fc 'E: activity' <<<"$bridge_manifest")" == 0 ]] || \
      fail "native Compat framework bridge must remain headless"
    grep -F '="dev.sos.permission.REPORT_ADB_CONSENT"' \
      <<<"$bridge_manifest" >/dev/null || \
      fail "native Compat framework bridge omitted its signed ADB-consent permission"
    local adb_consent_receiver
    adb_consent_receiver="$(grep -F -A12 \
      '=".SosAdbConsentReceiver"' <<<"$bridge_manifest")"
    [[ -n "$adb_consent_receiver" ]] || \
      fail "native Compat framework bridge omitted its ADB consent receiver"
    grep -F ':directBootAware' <<<"$adb_consent_receiver" | grep -F '=true' >/dev/null || \
      fail "native Compat ADB consent receiver is not direct-boot-aware"
    grep -F ':exported' <<<"$adb_consent_receiver" | grep -F '=true' >/dev/null || \
      fail "native Compat ADB consent receiver cannot receive the HOME result"
    grep -F '="dev.sos.permission.REPORT_ADB_CONSENT"' \
      <<<"$adb_consent_receiver" >/dev/null || \
      fail "native Compat ADB consent receiver lacks its signature boundary"
    grep -F '="android.permission.MANAGE_DEBUGGING"' <<<"$bridge_manifest" >/dev/null || \
      fail "native Compat framework bridge cannot answer the ADB service"
    grep -F '<permission name="android.permission.MANAGE_DEBUGGING" />' \
      "$privapp_permissions" >/dev/null || \
      fail "native Compat omitted the bridge MANAGE_DEBUGGING privapp allowlist"
    grep -F '="dev.sos.permission.REPORT_HOME_HEARTBEAT"' \
      <<<"$bridge_manifest" >/dev/null || \
      fail "native Compat framework bridge omitted its signature heartbeat permission"
    grep -F '=".SosProviderNotificationListenerService"' \
      <<<"$bridge_manifest" >/dev/null || \
      fail "native Compat framework bridge omitted its attention provider service"
    grep -F '="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"' \
      <<<"$bridge_manifest" >/dev/null || \
      fail "native Compat attention provider lacks its system binding boundary"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'framework_provider_snapshot_failed' >/dev/null || \
      fail "native Compat framework bridge omitted the typed provider snapshot path"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'audio_set_volume' >/dev/null || \
      fail "native Compat framework bridge omitted provider action capabilities"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'native_control_acknowledged command=' >/dev/null || \
      fail "native Compat framework bridge omitted acknowledged screen-off control"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'home-heartbeat-missing' >/dev/null || \
      fail "native Compat framework bridge omitted live HOME supervision"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'framework_bridge_home_start result=accepted' >/dev/null || \
      fail "native Compat framework bridge omitted bounded HOME restart"
    unzip -p "$bridge_apk" 'classes*.dex' | strings | \
      grep -F 'framework_bridge_home_start result=user-locked' >/dev/null || \
      fail "native Compat framework bridge can initialize HOME before CE unlock"
    for consent_marker in \
      'framework_adb_consent action=' \
      'allow-once' \
      'always-allow' \
      'deny'; do
      unzip -p "$bridge_apk" 'classes*.dex' | strings | \
        grep -F "$consent_marker" >/dev/null || \
        fail "native Compat ADB consent receiver omitted marker: $consent_marker"
    done
    for consent_marker in \
      'sos_adb_confirmation state=shown owner=true renderer=sos-home' \
      'Allow once' \
      'Always allow this computer' \
      'Deny connection' \
      'dev.sos.action.ADB_CONSENT_RESULT'; do
      unzip -p "$apk" 'classes*.dex' | strings | \
        grep -F "$consent_marker" >/dev/null || \
        fail "SOS HOME ADB consent surface omitted marker: $consent_marker"
    done
    local framework_overlay_resources
    framework_overlay_resources="$(container out/host/linux-x86/bin/aapt2 dump resources \
      "$framework_overlay")"
    for overlay_resource in \
      config_customAdbPublicKeyConfirmationComponent \
      config_customAdbPublicKeyConfirmationSecondaryUserComponent; do
      grep -F "$overlay_resource" <<<"$framework_overlay_resources" >/dev/null || \
        fail "native Compat framework overlay omitted ADB consent binding: $overlay_resource"
    done
    unzip -p "$framework_overlay" resources.arsc | strings | \
      grep -F 'dev.sos.experience/dev.gpui.mobile.SosAdbConfirmationActivity' >/dev/null || \
      fail "native Compat framework overlay points ADB consent outside SOS"
    unzip -p "$apk" 'classes*.dex' | strings | \
      grep -Fx 'deepseek/deepseek-v4-flash-0731' >/dev/null || \
      fail "Compat HOME omitted the pinned OpenRouter campaign model"
    if unzip -p "$apk" 'classes*.dex' | strings | \
      grep -Fx 'deepseek/deepseek-v4-flash' >/dev/null; then
      fail "Compat HOME retained the older OpenRouter model ID"
    fi
    for agent_marker in \
      'android_agent_bridge_request_start provider=' \
      'android_agent_child_start executable=sos-node' \
      'android_agent_child_exit code=' \
      'android_agent_child_cleanup category=' \
      'android_agent_child_response type=' \
      'android_agent_failure stage='; do
      unzip -p "$apk" 'classes*.dex' | strings | grep -F "$agent_marker" >/dev/null || \
        fail "Compat HOME omitted sanitized agent lifecycle marker: $agent_marker"
    done
    for agent_marker in \
      'android_agent_effect_dispatch action=' \
      'android_agent_thread_start provider=' \
      'android_agent_request_start provider=' \
      'android_agent_pi_response provider=' \
      'android_agent_failure stage='; do
      strings "$host_runtime" | grep -F "$agent_marker" >/dev/null || \
        fail "native Compat runtime omitted agent lifecycle marker: $agent_marker"
    done
    local native_evidence_marker
    for native_evidence_marker in \
      'android_agent_action_sequence_verified provider=' \
      'android_agent_action_verified ordinal=' \
      'android_agent_candidate_validation_ack request_id=' \
      'android_agent_activation_stage_ack request_id=' \
      'android_agent_activation_commit request_id='; do
      unzip -p "$apk" lib/arm64-v8a/libsos_experience.so | strings | \
        grep -F "$native_evidence_marker" >/dev/null || \
        fail "Compat HOME omitted authoritative agent evidence marker: $native_evidence_marker"
      strings "$host_runtime" | grep -F "$native_evidence_marker" >/dev/null || \
        fail "native Compat runtime omitted authoritative agent evidence marker: $native_evidence_marker"
    done
    for native_evidence_marker in \
      'compat_ime_focus_transition from=' \
      'compat_ime_blur_resolved node_id='; do
      unzip -p "$apk" lib/arm64-v8a/libsos_experience.so | strings | \
        grep -F "$native_evidence_marker" >/dev/null || \
        fail "Compat HOME omitted focus lifecycle marker: $native_evidence_marker"
    done
    ! grep -F '(allow sos_authority sysfs_battery' "$system_ext_policy" >/dev/null || \
      fail "native Compat authority bypasses Android's vendor health boundary"

    for removed in \
      AccessibilityMenu Aperture ApertureLensLauncher AudioFX AvatarPicker \
      Backgrounds BackupRestoreConfirmation BasicDreams Camelot CaptivePortalLogin \
      CertInstaller Contacts CredentialManager DeskClock Dialer DocumentsUI EmergencyInfo \
      DeviceAsWebcam DeviceDiagnostics DownloadProviderUi \
      DynamicSystemInstallationService EasterEgg Etar ExactCalculator Gallery2 \
      Glimpse HTMLViewer IntentResolver Jelly \
      Launcher3QuickStep LineageParts LineageSetupWizard LiveWallpapersPicker \
      ManagedProvisioning PhotoTable PrintSpooler Profiles \
      QuickAccessWallet Recorder SamsungDAP-custom SamsungDoze Seedvault Settings \
      SettingsIntelligence SimAppDialog SimpleSettingsConfig SoundPicker SpeakerFX \
      Stk StorageManager SystemUI ThemePicker ThemesStub Twelve Updater VpnDialogs \
      messaging; do
      ! find "$target_files" -type f -name "${removed}.apk" -print -quit | grep -q . || \
        fail "native Compat still packages Android UI APK $removed"
    done
  fi
  file "$authority" | grep -F 'ARM aarch64' >/dev/null || \
    fail "packaged SOS authority is not AArch64"
  file "$node" | grep -F 'ARM aarch64' >/dev/null || \
    fail "packaged SOS Node is not AArch64"
  file "$node_cxx" | grep -F 'ARM aarch64' >/dev/null || \
    fail "packaged SOS Node libc++ runtime is not AArch64"
  cmp -s "$authority" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/arm64/sos-android-system-authority" || \
    fail "packaged SOS authority differs from the staged ARM64 binary"
  cmp -s "$node" "$SOS_ROOT/artifacts/sos-node-android-arm64" || \
    fail "packaged SOS Node differs from the built ARM64 binary"
  cmp -s "$node_cxx" "$SOS_ROOT/artifacts/sos-node-libc++_shared.so" || \
    fail "packaged SOS Node libc++ runtime differs from the pinned NDK binary"
  cmp -s "$agent_runner" "$SOS_ROOT/services/sos-agent/dist/agent-runner.cjs" || \
    fail "packaged shared Pi runner differs from the built bundle"
  check_agent_runner_contract "$agent_runner"
  cmp -s "$agent_api" "$SOS_ROOT/docs/experience-api.md" || \
    fail "packaged Android Pi API document differs from repository source"
  cmp -s "$agent_example_primary" "$SOS_ROOT/experiences/mobile.luau" || \
    fail "packaged Android Pi primary example differs from repository source"
  [[ ! -e "$target_files/SYSTEM_EXT/etc/sos-agent/example-secondary.luau" ]] || \
    fail "packaged Android product retained a secondary Pi example"
  [[ ! -e "$target_files/SYSTEM_EXT/etc/sos/default.luau" && \
    ! -e "$target_files/SYSTEM_EXT/etc/sos/default.package.json" && \
    ! -e "$target_files/SYSTEM_EXT/etc/sos/modules/stock-theme.luau" ]] || \
    fail "packaged Android product retained the Linux Stock Shell bootstrap"
  cmp -s "$bootstrap" "$SOS_ROOT/experiences/mobile.luau" || \
    fail "packaged SOS bootstrap differs from the repository source"
  cmp -s "$bootstrap_package" "$SOS_ROOT/experiences/mobile.package.json" || \
    fail "packaged SOS v4 manifest differs from the repository source"
  cmp -s "$stock_theme" "$SOS_ROOT/experiences/modules/mobile-theme.luau" || \
    fail "packaged SOS Stock Mobile theme differs from the repository source"
  check_android_stock_mobile "$bootstrap" "$bootstrap_package" "$stock_theme"
  check_android_composition_authority "$authority" "$init_rc"
  grep -Fx 'ro.sos.authority=on-device' "$properties"
  grep -Fx 'ro.sos.home=dev.sos.experience' "$properties"
  grep -E "^ro\\.system_ext\\.build\\.version\\.incremental=sos\\.${build_profile}\\.[0-9a-f]{12}\\.[0-9a-f]{12}$" \
    "$properties" || fail "SOS build does not carry a unique package-cache fingerprint"
  grep -Fx 'ro.sos.profile=compat' "$properties"
  grep -Fx "ro.sos.compat.stage=$expected_stage" "$properties"
  grep -Fx "ro.sos.ui_owner=$expected_owner" "$properties"
  grep -Fx 'ro.sos.revision_format=4' "$properties"
  grep -Fx 'ro.sos.experience_api=4' "$properties"
  grep -Fx \
    'user=_app isPrivApp=true seinfo=platform name=dev.sos.experience domain=priv_app type=privapp_data_file levelFrom=all' \
    "$seapp_contexts"
  grep -Fx \
    '/system_ext/bin/sos-authority               u:object_r:sos_authority_exec:s0' \
    "$file_contexts"
  grep -Fx \
    '/system_ext/bin/sos-node                    u:object_r:sos_node_exec:s0' \
    "$file_contexts"
  grep -Fx \
    '/data/misc/sos(/.*)?                         u:object_r:sos_authority_data_file:s0' \
    "$file_contexts"
  info "SOS ${profile} ARM64 target-files gate passed"
}

inspect_compat0() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl inspect-compat0"
  inspect_compat_profile compat0
}

inspect_compat1() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl inspect-compat1"
  inspect_compat_profile compat1
}

inspect_sos() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl inspect-sos"
  inspect_compat1
}

inspect_core() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl inspect-core"
  inspect_rom lineage_sos_core_a33x
  local target_files="$LINEAGE_ROOT/out/target/product/a33x/obj/PACKAGING/target_files_intermediates/lineage_sos_core_a33x-target_files"
  local probe="$target_files/SYSTEM_EXT/bin/sos-core-surface-probe"
