#!/usr/bin/env bash

set -euo pipefail

SOS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LINEAGE_ROOT="${SOS_LINEAGE_ROOT:-$HOME/dev/lineage-a33x}"
LINEAGE_IMAGE="${SOS_LINEAGE_BUILD_IMAGE:-localhost/sos-lineage-build:ubuntu-24.04}"
LINEAGE_MANIFEST="https://github.com/LineageOS/android.git"
LINEAGE_MANIFEST_REV="2a46cce5dff3a9a3ab98b3c25a7564084b34cd1f"
LINEAGE_LOCAL_MANIFEST="$SOS_ROOT/aosp/manifests/a33x-lineage-23.0.xml"
LINEAGE_PATCH_DIR="$SOS_ROOT/aosp/patches/a33x-lineage-23.0"
LINEAGE_SOS_COMPAT0_DEVICE="sos_compat0_a33x"
LINEAGE_SOS_COMPAT1_DEVICE="sos_compat_a33x"
LINEAGE_SOS_CORE_SHADOW_DEVICE="sos_core_a33x"
LINEAGE_SOS_CORE0B_DEVICE="sos_core0b_a33x"
LINEAGE_SOS_CORE1_DEVICE="sos_core1_a33x"
LINEAGE_SOS_OVERLAY_SOURCE="$SOS_ROOT/aosp/device/sos/a33x"
LINEAGE_SOS_OVERLAY_DESTINATION="$LINEAGE_ROOT/device/sos/a33x"
LINEAGE_JOBS="${SOS_LINEAGE_JOBS:-8}"
LINEAGE_SYNC_JOBS="${SOS_LINEAGE_SYNC_JOBS:-8}"
LINEAGE_CCACHE="${SOS_LINEAGE_CCACHE:-$HOME/dev/.cache/lineage-a33x-ccache}"
LINEAGE_CCACHE_SIZE="${SOS_LINEAGE_CCACHE_SIZE:-50G}"

info() {
  printf '==> %s\n' "$*"
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

check_agent_runner_contract() {
  [[ "$#" -le 1 ]] || \
    fail "usage: ./tools/a33xctl check-agent-runner-contract [BUNDLE]"
  local runner="${1:-$SOS_ROOT/services/sos-agent/dist/agent-runner.cjs}"
  local exact_assignment='var PINNED_OPENROUTER_MODEL = "deepseek/deepseek-v4-flash-0731";'
  local bare_assignment='var PINNED_OPENROUTER_MODEL = "deepseek/deepseek-v4-flash";'
  local assignment_count
  [[ -f "$runner" ]] || fail "shared Pi runner bundle is missing: $runner"
  assignment_count="$(grep -Ec '^var PINNED_OPENROUTER_MODEL = "[^"]+";$' "$runner" || true)"
  [[ "$assignment_count" == 1 ]] || \
    fail "shared Pi runner must contain exactly one pinned OpenRouter assignment"
  ! grep -Fqx "$bare_assignment" "$runner" || \
    fail "shared Pi runner assigns the older bare OpenRouter model"
  grep -Fqx "$exact_assignment" "$runner" || \
    fail "shared Pi runner does not assign the exact 0731 OpenRouter model"
  grep -F \
    'decoded.provider === "openrouter" && decoded.model !== PINNED_OPENROUTER_MODEL' \
    "$runner" >/dev/null || \
    fail "shared Pi runner omitted exact OpenRouter request enforcement"
  info "shared Pi runner exact OpenRouter assignment and request guard passed"
}

check_core_runtime_model_contract() {
  [[ "$#" -eq 1 ]] || \
    fail "usage: ./tools/a33xctl check-core-runtime-model-contract RUNTIME"
  local runtime="$1"
  [[ -f "$runtime" ]] || fail "Core runtime is missing: $runtime"
  grep -aF 'deepseek/deepseek-v4-flash-0731' "$runtime" >/dev/null || \
    fail "Core runtime omitted the pinned OpenRouter campaign model bytes"
  grep -aF 'Pi returned a response for the wrong model.' "$runtime" >/dev/null || \
    fail "Core runtime omitted its response-model rejection boundary"
  info "Core runtime pinned model bytes and mismatch rejection passed"
}

check_android_composition_authority() {
  [[ "$#" -eq 2 ]] || \
    fail "usage: check_android_composition_authority AUTHORITY INIT_RC"
  local authority="$1" init_rc="$2" marker
  grep -F -- '--install-reference-composition' "$init_rc" >/dev/null || \
    fail "SOS authority does not install the signed reference composition"
  grep -F -- '--bootstrap-source /system_ext/etc/sos/mobile.luau' "$init_rc" >/dev/null || \
    fail "SOS authority does not boot the Stock Mobile source"
  grep -F -- '--bootstrap-package /system_ext/etc/sos/mobile.package.json' "$init_rc" >/dev/null || \
    fail "SOS authority does not boot the Stock Mobile package"
  grep -F -- '--bootstrap-asset mobile.theme luau /system_ext/etc/sos/modules/mobile-theme.luau' \
    "$init_rc" >/dev/null || fail "SOS authority does not bind the Stock Mobile theme"
  grep -Fx 'on property:sys.sos.authority_recovery_probe=1' "$init_rc" >/dev/null || \
    fail "SOS authority omitted its userdebug-only physical recovery trigger"
  grep -F '    restart sos_authority' "$init_rc" >/dev/null || \
    fail "SOS authority recovery trigger does not restart only the authority"
  grep -F '    setprop sys.sos.authority_recovery_probe 0' "$init_rc" >/dev/null || \
    fail "SOS authority recovery trigger is not one-shot"
  readelf -d "$authority" | grep -F 'Shared library: [liblog.so]' >/dev/null || \
    fail "SOS authority cannot publish fatal startup failures to Android logd"
  grep -aF 'android_system_authority_failed error=' "$authority" >/dev/null || \
    fail "SOS authority omitted its fatal startup marker"
  grep -aF 'install reference composition failed: ' "$authority" >/dev/null || \
    fail "SOS authority omitted its reference-install startup boundary"
  for marker in \
    'raw socket step=socket(AF_INET, SOCK_STREAM)' \
    'raw socket step=setsockopt(SO_REUSEADDR)' \
    'raw socket step=bind' \
    'raw socket step=listen'; do
    grep -aF "$marker" "$authority" >/dev/null || \
      fail "SOS authority omitted raw listener diagnostic boundary: $marker"
  done
  grep -aF 'sos.stock.mobile' "$authority" >/dev/null || \
    fail "SOS authority omitted the reserved Stock Mobile identity"
  for marker in \
    sos.example.agenda \
    sos.example.media \
    sos.example.dashboard \
    sos.example.agenda-media-remix; do
    grep -aF "$marker" "$authority" >/dev/null || \
      fail "SOS authority omitted reference Experience $marker"
  done
  info "SOS authority signed reference composition markers passed"
}

check_android_stock_mobile() {
  [[ "$#" -eq 3 ]] || \
    fail "usage: check_android_stock_mobile SOURCE PACKAGE THEME"
  local source="$1" package="$2" theme="$3" marker
  jq -e '
    .format_version == 4 and
    .experience_id == "sos.stock.mobile" and
    .role == "shell" and
    .contract.exports.main.viewport.min_width == 320 and
    .contract.exports.main.viewport.min_height == 480 and
    (.provider_capabilities | index("appearance_write") != null)
  ' "$package" >/dev/null || fail "Android Stock Mobile package contract is invalid"
  grep -F 'require("mobile.theme")' "$source" >/dev/null || \
    fail "Android Stock Mobile source omitted its revision-local theme"
  for marker in \
    'stock-mobile-root' \
    'mobile-top-bar' \
    'mobile-bottom-navigation' \
    'mobile-app-launcher' \
    'experience_present_'; do
    grep -F "$marker" "$source" >/dev/null || \
      fail "Android Stock Mobile source omitted phone-native marker: $marker"
  done
  ! grep -F 'kind = "window_space"' "$source" >/dev/null || \
    fail "Android Stock Mobile source contains the desktop window-space primitive"
  grep -F 'touch = {' "$theme" >/dev/null || \
    fail "Android Stock Mobile theme omitted touch geometry"
  info "Android Stock Mobile identity and phone-native source contract passed"
}

check_android_v4_system_controls() {
  [[ "$#" -eq 1 ]] || fail "usage: check_android_v4_system_controls RUNTIME"
  local runtime="$1" marker
  for marker in \
    'android_system_control action=appearance_toggle' \
    'android_system_control action=dismiss_experience experience_id=' \
    'android_system_control action=rollback_graph' \
    'Change system theme' \
    'Roll back Experience graph' \
    'Return to Stock'; do
    grep -aF "$marker" "$runtime" >/dev/null || \
      fail "Android v4 runtime omitted host-owned system control: $marker"
  done
  info "Android v4 host-owned system controls passed"
}

soong_module_block() {
  [[ "$#" -eq 2 ]] || fail "internal usage: soong_module_block <type> <name>"
  local module_type="$1" module_name="$2"
  awk -v module_type="$module_type" -v module_name="$module_name" '
    $0 == module_type " {" {
      in_block = 1
      block = $0 ORS
      next
    }
    in_block {
      block = block $0 ORS
      if ($0 == "}") {
        if (index(block, "name: \"" module_name "\"") != 0) {
          printf "%s", block
          exit
        }
        in_block = 0
        block = ""
      }
    }
  ' "$SOS_ROOT/aosp/device/sos/a33x/Android.bp"
}

check_product_graph() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl check-product-graph"
  local device_dir="$SOS_ROOT/aosp/device/sos/a33x"
  local defaults_block core_block compat_block core_overrides profile_file
  defaults_block="$(soong_module_block cc_defaults sos-ui-removal-marker-defaults)"
  core_block="$(soong_module_block cc_binary sos-ui-removal-marker)"
  compat_block="$(soong_module_block cc_binary sos-compat-ui-removal-marker)"
  [[ -n "$defaults_block" && -n "$core_block" && -n "$compat_block" ]] || \
    fail "SOS UI-removal marker modules are incomplete"
  [[ "$defaults_block" != *'"LatinIME"'* ]] || \
    fail "shared UI-removal defaults must retain LatinIME for Compat"
  [[ "$core_block" == *'"LatinIME"'* ]] || \
    fail "Core UI-removal marker must override LatinIME"
  core_overrides="$(awk '
    /overrides: \[/ { in_overrides = 1; next }
    in_overrides && /\],/ { exit }
    in_overrides {
      gsub(/[",[:space:]]/, "")
      if (length != 0) print
    }
  ' <<<"$core_block")"
  [[ "$core_overrides" == LatinIME ]] || \
    fail "Core and Compat UI-removal sets must differ only by LatinIME"
  [[ "$compat_block" != *'overrides:'* ]] || \
    fail "Compat UI-removal marker must use only the shared override set"
  [[ "$core_block" != *'stem:'* && "$compat_block" != *'stem:'* ]] || \
    fail "Compat and Core UI-removal markers must have distinct installed filenames"

  profile_file="$device_dir/lineage_sos_compat_a33x.mk"
  grep -F '    sos-compat-ui-removal-marker' "$profile_file" >/dev/null || \
    fail "Compat 1 does not select its UI-removal marker"
  ! grep -F '    sos-ui-removal-marker' "$profile_file" >/dev/null || \
    fail "Compat 1 must not select the Core UI-removal marker"
  for profile_file in \
    "$device_dir/lineage_sos_core0b_a33x.mk" \
    "$device_dir/lineage_sos_core1_a33x.mk"; do
    grep -F '    sos-ui-removal-marker' "$profile_file" >/dev/null || \
      fail "$(basename "$profile_file") does not select the Core UI-removal marker"
    ! grep -F '    sos-compat-ui-removal-marker' "$profile_file" >/dev/null || \
      fail "$(basename "$profile_file") must not select the Compat UI-removal marker"
  done
  for profile_file in \
    "$device_dir/lineage_sos_compat0_a33x.mk" \
    "$device_dir/sos_native_host_common.mk"; do
    ! grep -F 'sos-ui-removal-marker' "$profile_file" >/dev/null || \
      fail "$(basename "$profile_file") must not select a profile UI-removal marker"
    ! grep -F 'sos-compat-ui-removal-marker' "$profile_file" >/dev/null || \
      fail "$(basename "$profile_file") must not select a profile UI-removal marker"
  done
  info "SOS product graph marker split passed"
}

container() {
  require_command podman
  podman run --rm \
    --security-opt label=disable \
    --pids-limit=-1 \
    --network host \
    --volume "$HOME/dev:$HOME/dev" \
    --workdir "$LINEAGE_ROOT" \
    --env "HOME=$HOME" \
    --env "USER=${USER:-$(id -un)}" \
    --env "USE_CCACHE=1" \
    --env "CCACHE_EXEC=/usr/bin/ccache" \
    --env "CCACHE_DIR=$LINEAGE_CCACHE" \
    "$LINEAGE_IMAGE" \
    "$@"
}

image() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl image"
  require_command podman
  info "building reproducible LineageOS host image $LINEAGE_IMAGE"
  podman build --tag "$LINEAGE_IMAGE" --file "$SOS_ROOT/tools/a33x/Containerfile" \
    "$SOS_ROOT/tools/a33x"
}

doctor() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl doctor"
  require_command podman
  [[ "$(uname -m)" == "x86_64" ]] || fail "LineageOS host must be x86-64"
  local available_kb memory_kb
  available_kb="$(df --output=avail -k "$HOME/dev" | tail -n 1 | tr -d ' ')"
  [[ "$available_kb" =~ ^[0-9]+$ && "$available_kb" -ge 314572800 ]] || \
    fail "a33x checkout/build needs at least 300 GiB free below $HOME/dev"
  memory_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
  [[ "$memory_kb" =~ ^[0-9]+$ && "$memory_kb" -ge 60000000 ]] || \
    fail "a33x build needs at least 60 GB RAM"
  podman image exists "$LINEAGE_IMAGE" || fail "run ./tools/a33xctl image first"
  container repo version
  info "a33x build-host gate passed"
  printf '    root:       %s\n' "$LINEAGE_ROOT"
  printf '    manifest:   %s\n' "$LINEAGE_MANIFEST_REV"
  printf '    jobs:       %s\n' "$LINEAGE_JOBS"
  printf '    sync jobs:  %s\n' "$LINEAGE_SYNC_JOBS"
  printf '    disk free:  %s kB\n' "$available_kb"
  printf '    memory:     %s kB\n' "$memory_kb"
}

install_host_usb_rules() {
  [[ "$#" -eq 2 && "$1" == --group ]] || \
    fail "usage: sudo ./tools/a33xctl install-host-usb-rules --group GROUP"
  [[ "$EUID" -eq 0 ]] || \
    fail "host USB rule installation requires root; rerun through sudo"
  require_command getent
  require_command install
  require_command sed
  require_command udevadm
  local usb_group="$2"
  [[ "$usb_group" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]] || \
    fail "invalid host USB group: $usb_group"
  getent group "$usb_group" >/dev/null || fail "host USB group does not exist: $usb_group"
  local template="$SOS_ROOT/tools/a33x/70-sos-a33x-usb.rules.in"
  local destination=/etc/udev/rules.d/70-sos-a33x-usb.rules
  local temporary
  [[ -f "$template" ]] || fail "host USB rule template is missing: $template"
  temporary="$(mktemp /tmp/70-sos-a33x-usb.rules.XXXXXX)"
  trap 'rm -f -- "$temporary"' EXIT
  sed "s/@SOS_USB_GROUP@/$usb_group/g" "$template" >"$temporary"
  install -o root -g root -m 0644 "$temporary" "$destination"
  udevadm control --reload-rules
  udevadm trigger --action=change --subsystem-match=usb
  udevadm settle
  trap - EXIT
  rm -f -- "$temporary"
  printf 'host_usb_rules=INSTALLED\npath=%s\ngroup=%s\n' "$destination" "$usb_group"
}

init() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl init"
  [[ ! -e "$LINEAGE_ROOT/.repo" ]] || fail "$LINEAGE_ROOT is already initialized"
  mkdir -p "$LINEAGE_ROOT"
  info "initializing pinned LineageOS manifest $LINEAGE_MANIFEST_REV"
  container repo init \
    --partial-clone \
    --no-use-superproject \
    --current-branch \
    --no-tags \
    --manifest-url "$LINEAGE_MANIFEST" \
    --manifest-branch "$LINEAGE_MANIFEST_REV"
  mkdir -p "$LINEAGE_ROOT/.repo/local_manifests"
  install -m 0644 "$LINEAGE_LOCAL_MANIFEST" \
    "$LINEAGE_ROOT/.repo/local_manifests/a33x-lineage-23.0.xml"
}

sync_source() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl sync"
  [[ -d "$LINEAGE_ROOT/.repo" ]] || fail "run ./tools/a33xctl init first"
  info "syncing pinned a33x LineageOS source graph"
  container repo sync \
    -c \
    --no-tags \
    --no-clone-bundle \
    --no-interleaved \
    --jobs-network="$LINEAGE_SYNC_JOBS" \
    --jobs-checkout=1 \
    --fail-fast
  container repo manifest -r -o .repo/sos-a33x-resolved-manifest.xml
  sha256sum "$LINEAGE_ROOT/.repo/sos-a33x-resolved-manifest.xml"
  hydrate_source_lfs
  apply_source_patches
}

hydrate_source_lfs() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl hydrate-lfs"
  local project="$LINEAGE_ROOT/external/chromium-webview/prebuilt/arm64"
  local artifact="$project/webview.apk"
  local expected_bytes=265525351
  local expected_sha256=68fa550b7a76e39f0382308d93b235c0623d032c0aa6c4a56fc02eedfdbe6342
  [[ -d "$project" ]] || fail "ARM64 WebView checkout missing; run init and sync first"

  if [[ ! -f "$artifact" ]] || \
      [[ "$(stat --printf='%s' "$artifact")" != "$expected_bytes" ]] || \
      [[ "$(sha256sum "$artifact" | cut -d' ' -f1)" != "$expected_sha256" ]]; then
    info "hydrating pinned ARM64 WebView Git-LFS object"
    container git -C "$project" lfs pull --include=webview.apk --exclude=
  fi

  [[ -f "$artifact" ]] || fail "ARM64 WebView artifact missing after Git-LFS pull"
  [[ "$(stat --printf='%s' "$artifact")" == "$expected_bytes" ]] || \
    fail "ARM64 WebView artifact has unexpected size"
  [[ "$(sha256sum "$artifact" | cut -d' ' -f1)" == "$expected_sha256" ]] || \
    fail "ARM64 WebView artifact failed SHA-256 verification"
  info "ARM64 WebView Git-LFS gate passed"
}

apply_source_patches() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl apply-patches"
  local -a projects=(
    device/samsung/s5e8825-common
    vendor/samsung/s5e8825-common
    device/samsung/s5e8825-common
    frameworks/base
    device/samsung/s5e8825-common
    device/samsung/s5e8825-common
    device/samsung/s5e8825-common
  )
  local -a patches=(
    0001-s5e8825-fix-epicoperator-symbol.patch
    0002-s5e8825-match-libsec-ril-protobuf-soname.patch
    0003-s5e8825-package-recovery-init.patch
    0004-frameworks-base-enforce-sos-core-install-policy.patch
    0005-s5e8825-select-no-zygote-for-sos-core1.patch
    0006-s5e8825-allow-sos-core-tsp-enable.patch
    0007-s5e8825-chown-tsp-enabled.patch
  )
  local index project patch
  for index in "${!patches[@]}"; do
    project="$LINEAGE_ROOT/${projects[$index]}"
    patch="$LINEAGE_PATCH_DIR/${patches[$index]}"
    [[ -d "$project/.git" || -f "$project/.git" ]] || \
      fail "source checkout missing: ${projects[$index]}"
    [[ -f "$patch" ]] || fail "required source patch missing: $patch"

    if git -C "$project" apply --reverse --check "$patch" 2>/dev/null; then
      info "source patch already applied: $(basename "$patch")"
    elif git -C "$project" apply --check "$patch"; then
      git -C "$project" apply "$patch"
      info "applied source patch: $(basename "$patch")"
    else
      fail "source patch cannot be applied cleanly: $patch"
    fi
  done
}

stage_sos() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/a33xctl stage-sos"
  local apk="$SOS_ROOT/artifacts/sos-experience.apk"
  local core_runtime="$SOS_ROOT/artifacts/libsos_core_experience.so"
  local authority="$SOS_ROOT/target/aarch64-linux-android/release/sos-android-system-authority"
  local node="$SOS_ROOT/artifacts/sos-node-android-arm64"
  local node_cxx="$SOS_ROOT/artifacts/sos-node-libc++_shared.so"
  local agent_runner="$SOS_ROOT/services/sos-agent/dist/agent-runner.cjs"
  local agent_api="$SOS_ROOT/docs/experience-api.md"
  local agent_example_primary="$SOS_ROOT/experiences/mobile.luau"
  local bootstrap="$SOS_ROOT/experiences/mobile.luau"
  local bootstrap_package="$SOS_ROOT/experiences/mobile.package.json"
  local stock_theme="$SOS_ROOT/experiences/modules/mobile-theme.luau"
  [[ -f "$LINEAGE_ROOT/build/envsetup.sh" ]] || fail "run init and sync first"
  [[ -f "$apk" ]] || \
    fail "ARM64 SOS APK missing; run ./tools/sosctl m1-build --abi arm64-v8a --home"
  [[ -f "$core_runtime" ]] || \
    fail "ARM64 Core GPUI runtime missing; run ./tools/a33xctl build-core"
  [[ -x "$authority" ]] || fail "ARM64 SOS authority binary missing"
  [[ -x "$node" ]] || fail "Android ARM64 Node missing; run ./tools/build-android-node"
  [[ -f "$node_cxx" ]] || fail "Android Node libc++ runtime missing; run ./tools/build-android-node"
  [[ -f "$agent_runner" ]] || fail "shared Pi runner missing; run npm run build in services/sos-agent"
  [[ -f "$agent_api" && -f "$agent_example_primary" ]] || \
    fail "Android Pi prompt documents are missing"
  [[ -f "$bootstrap" && -f "$bootstrap_package" && -f "$stock_theme" ]] || \
    fail "SOS v4 bootstrap package is incomplete"
  [[ "$LINEAGE_SOS_OVERLAY_DESTINATION" == "$LINEAGE_ROOT/device/sos/a33x" ]] || \
    fail "refusing to stage outside the managed a33x SOS destination"
  unzip -Z1 "$apk" | grep -Fx lib/arm64-v8a/libsos_experience.so >/dev/null || \
    fail "SOS APK does not contain the ARM64 experience library"
  file "$authority" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS authority is not an AArch64 ELF"
  file "$core_runtime" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS Core GPUI runtime is not an AArch64 ELF"
  file "$node" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS Node is not an AArch64 ELF"
  file "$node_cxx" | grep -F 'ARM aarch64' >/dev/null || \
    fail "SOS Node libc++ runtime is not an AArch64 ELF"

  info "staging the ARM64 SOS product in $LINEAGE_SOS_OVERLAY_DESTINATION"
  mkdir -p "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/arm64" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/sos-agent"
  # Content checks catch same-size source edits; omitting source timestamps
  # ensures Ninja sees every transferred overlay file as newer than a cached
  # object instead of silently packaging stale native code.
  rsync -a --checksum --no-times --delete \
    --exclude prebuilts \
    "$LINEAGE_SOS_OVERLAY_SOURCE/" "$LINEAGE_SOS_OVERLAY_DESTINATION/"
  install -m 0644 "$apk" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/SosShell.apk"
  install -m 0644 "$core_runtime" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/arm64/libsos_core_experience.so"
  install -m 0755 "$authority" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/arm64/sos-android-system-authority"
  install -m 0755 "$node" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/arm64/sos-node"
  install -m 0644 "$node_cxx" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/arm64/libc++_shared.so"
  rm -f -- "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/sos-agent/android-runner.cjs"
  install -m 0644 "$agent_runner" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/sos-agent/agent-runner.cjs"
  install -m 0644 "$agent_api" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/sos-agent/experience-api.md"
  install -m 0644 "$agent_example_primary" \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/sos-agent/example-primary.luau"
  rm -f -- \
    "$LINEAGE_SOS_OVERLAY_DESTINATION/prebuilts/sos-agent/example-secondary.luau" \
