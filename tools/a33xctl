  core_dev_transport+='-- \'
  local obsolete_core_dev_transport='exec''-out /system_ext/bin/sos-core-dev-credential'
  local ordinary_runner_module dev_runner_module

  ordinary_runner_module="$(soong_module_block prebuilt_etc sos-agent-runner)"
  dev_runner_module="$(soong_module_block prebuilt_etc sos-agent-runner-core-dev)"

  grep -Fx 'core-dev-credential = ["core-native"]' "$cargo" >/dev/null || \
    fail "Core development credential endpoint lacks its dedicated feature"
  ! grep -E '^core-native = \[[^]]*core-dev-credential' "$cargo" >/dev/null || \
