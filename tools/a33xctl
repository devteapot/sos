      '^allow sos_core_dev_credential (shell:fd use;|adbd:fd use;|adbd:unix_stream_socket \{ read write \};|shell:fifo_file \{ getattr read write \};|self:unix_stream_socket create_socket_perms;|sos_core_host:unix_stream_socket connectto;)$' || true
