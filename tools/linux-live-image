#!/usr/bin/env bash

set -euo pipefail
umask 077

live_image_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
live_image_identity_path=/usr/share/doc/sos/image-identity.env
live_image_offline_source=/usr/share/sos/experiences/daily-flow.luau
live_image_harness=/usr/local/libexec/sos/linux-hardware-gate

live_image_fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

live_image_usage() {
  printf '%s\n' \
    'usage:' \
    '  tools/linux-live-image doctor' \
    '  tools/linux-live-image format-identity [identity fields...]' \
    '  tools/linux-live-image write-offline-user-state --home-root DIR' \
    '  tools/linux-live-image check-rootfs --root DIR' \
    '  tools/linux-live-image bake --source-iso ISO --output-dir DIR'
}

live_image_require_command() {
  command -v "$1" >/dev/null 2>&1 || live_image_fail "required command not found: $1"
}

live_image_metadata_value() {
  local file="$1" key="$2"
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

live_image_target() {
  printf '%s%s\n' "$live_image_rootfs" "$1"
}

live_image_runtime_packages() {
  printf '%s\n' \
    nodejs \
    libseat \
    libinput \
    libinput-utils \
    mesa-libgbm \
    libxkbcommon \
    libxkbcommon-x11 \
    vulkan-loader \
    mesa-dri-drivers \
    mesa-vulkan-drivers \
    pipewire-libs \
    alsa-lib \
    fontconfig \
    libgit2 \
    glib2 \
    sqlite \
    openssl \
    libzstd \
    jq \
    python3 \
    pciutils
}

live_image_parse_root_option() {
  live_image_rootfs=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --root|--home-root)
        [[ "$#" -ge 2 ]] || live_image_fail "$1 requires a directory"
        live_image_rootfs="$(realpath -m -- "$2")"
        shift 2
        ;;
      *) live_image_fail "unexpected option: $1" ;;
    esac
  done
  [[ -n "$live_image_rootfs" ]] || live_image_fail "--root or --home-root is required"
}

live_image_doctor() {
  [[ "$#" -eq 0 ]] || live_image_fail "doctor accepts no options"
  local command
  for command in cargo git install node npm pkg-config python3 realpath rustc sha256sum stat sudo; do
    live_image_require_command "$command"
  done
  local missing=()
  for command in xorriso unsquashfs mksquashfs file findmnt; do
    command -v "$command" >/dev/null 2>&1 || missing+=("$command")
  done
  for command in dump.erofs fsck.erofs mkfs.erofs; do
    command -v "$command" >/dev/null 2>&1 || missing+=("$command")
  done
  local host_id="unknown"
  if [[ -r /etc/os-release ]]; then
    # shellcheck source=/dev/null
    source /etc/os-release
    host_id="${ID:-unknown}"
  fi
  printf 'linux_live_image_doctor host=%s arch=%s rust=%s node=%s\n' \
    "$host_id" "$(uname -m)" "$(rustc --version | tr ' ' '_')" "$(node --version)"
  if [[ "$host_id" != fedora ]]; then
    printf 'linux_live_image_doctor_note bake requires a Fedora x86_64 host; this host can only check identity and rootfs layout\n'
  fi
  if [[ "${#missing[@]}" -ne 0 ]]; then
    printf 'linux_live_image_doctor_missing %s\n' "${missing[*]}"
  fi
  printf 'linux_live_image_runtime_packages %s\n' "$(live_image_runtime_packages | tr '\n' ' ')"
  printf 'linux_live_image_doctor=PASS\n'
}

live_image_format_identity() {
  local source_revision="" source_dirty=false agent_mode=offline
  local image_format=fedora-workstation-live-remix
  local base_iso_filename="" base_iso_bytes="" base_iso_sha256=""
  local payload_relpath="" payload_bytes="" payload_sha256=""
  local container_format="" baked_at_utc=""
  local output_iso_filename="" output_iso_bytes="" output_iso_sha256=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --source-revision) source_revision="$2"; shift 2 ;;
      --source-dirty) source_dirty="$2"; shift 2 ;;
      --agent-mode) agent_mode="$2"; shift 2 ;;
      --image-format) image_format="$2"; shift 2 ;;
      --base-iso-filename) base_iso_filename="$2"; shift 2 ;;
      --base-iso-bytes) base_iso_bytes="$2"; shift 2 ;;
      --base-iso-sha256) base_iso_sha256="$2"; shift 2 ;;
      --payload-relpath) payload_relpath="$2"; shift 2 ;;
      --payload-bytes) payload_bytes="$2"; shift 2 ;;
      --payload-sha256) payload_sha256="$2"; shift 2 ;;
      --container-format) container_format="$2"; shift 2 ;;
      --baked-at-utc) baked_at_utc="$2"; shift 2 ;;
      --output-iso-filename) output_iso_filename="$2"; shift 2 ;;
      --output-iso-bytes) output_iso_bytes="$2"; shift 2 ;;
      --output-iso-sha256) output_iso_sha256="$2"; shift 2 ;;
      *) live_image_fail "unexpected identity field: $1" ;;
    esac
  done
  [[ -n "$source_revision" && -n "$base_iso_filename" && -n "$base_iso_bytes" && -n "$base_iso_sha256" ]] || \
    live_image_fail "format-identity requires source revision and base ISO identity"
  [[ -n "$payload_relpath" && -n "$container_format" ]] || \
    live_image_fail "format-identity requires payload path and container format"
  [[ "$agent_mode" == offline ]] || live_image_fail "live images bake the offline agent only"
  [[ "$source_dirty" == false ]] || live_image_fail "live images require a clean source revision"
  case "$container_format" in
    squashfs-rootfs-img|flat-squashfs|erofs) ;;
    *) live_image_fail "unsupported container format: $container_format" ;;
  esac
  [[ -n "$baked_at_utc" ]] || baked_at_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s\n' \
    'image_kind=live-boot' \
    'image_label=live-boot' \
    'campaign_class=live-boot' \
    'not_installed_product=true' \
    "image_format=$image_format" \
    "container_format=$container_format" \
    "source_revision=$source_revision" \
    "source_dirty=$source_dirty" \
    "agent_mode=$agent_mode" \
    "base_iso_filename=$base_iso_filename" \
    "base_iso_bytes=$base_iso_bytes" \
    "base_iso_sha256=$base_iso_sha256" \
    "payload_relpath=$payload_relpath"
  if [[ -n "$payload_bytes" || -n "$payload_sha256" ]]; then
    [[ -n "$payload_bytes" && -n "$payload_sha256" ]] || \
      live_image_fail "payload identity requires both bytes and sha256"
    printf '%s\n' \
      "payload_bytes=$payload_bytes" \
      "payload_sha256=$payload_sha256"
  fi
  if [[ -n "$output_iso_filename" ]]; then
    [[ -n "$output_iso_bytes" && -n "$output_iso_sha256" ]] || \
      live_image_fail "output ISO identity requires filename, bytes, and sha256"
    printf '%s\n' \
      "output_iso_filename=$output_iso_filename" \
      "output_iso_bytes=$output_iso_bytes" \
      "output_iso_sha256=$output_iso_sha256"
  fi
  printf 'baked_at_utc=%s\n' "$baked_at_utc"
}

live_image_write_offline_user_state() {
  live_image_parse_root_option "$@"
  local state="$live_image_rootfs/.local/state/sos"
  install -d -m 0700 \
    "$live_image_rootfs/.local" \
    "$live_image_rootfs/.local/state" \
    "$state" \
    "$state/agent"
  printf '{}\n' >"$state/output.json"
  printf '%s\n' \
    'SOS_AGENT_PROVIDER=openai-codex' \
    'SOS_AGENT_MODEL=faux' \
    "SOS_AGENT_FAKE_SOURCE=$live_image_offline_source" >"$state/agent/config.env"
  chmod 0600 "$state/output.json" "$state/agent/config.env"
  printf 'linux_live_image_offline_user_state home_root=%s\n' "$live_image_rootfs"
}

live_image_symlink_basename() {
  local link="$1" target=""
  if [[ -L "$link" ]]; then
    target="$(readlink -- "$link")"
  fi
  printf '%s\n' "$(basename "${target:-}")"
}

live_image_check_rootfs() {
  live_image_parse_root_option "$@"
  [[ -d "$live_image_rootfs" ]] || live_image_fail "rootfs directory is missing: $live_image_rootfs"
  local path
  for path in \
    /usr/local/libexec/sos/sos-login-session \
    /usr/local/libexec/sos/sos-agent-login \
    "$live_image_harness" \
    /usr/local/libexec/sos-agent/dist/agent-runner.cjs \
    /usr/share/wayland-sessions/sos.desktop \
    /usr/share/sos/experiences/daily-flow.luau \
    /usr/share/doc/sos/install-metadata.env \
    /usr/share/doc/sos/install-manifest.tsv \
    "$live_image_identity_path"; do
    [[ -f "$(live_image_target "$path")" ]] || \
      live_image_fail "baked live rootfs is missing $path"
  done
  [[ -e "$(live_image_target /usr/lib/systemd/system/gdm.service)" \
    || -e "$(live_image_target /usr/sbin/gdm)" \
    || -e "$(live_image_target /usr/bin/gdm)" ]] || \
    live_image_fail "baked live rootfs does not contain GDM"
  local default_target display_manager
  default_target="$(live_image_symlink_basename "$(live_image_target /etc/systemd/system/default.target)")"
  if [[ -z "$default_target" ]]; then
    default_target="$(live_image_symlink_basename "$(live_image_target /usr/lib/systemd/system/default.target)")"
  fi
  [[ "$default_target" != sos-session.target ]] || \
    live_image_fail "baked live rootfs enables the boot-owned appliance target"
  display_manager="$(live_image_symlink_basename "$(live_image_target /etc/systemd/system/display-manager.service)")"
  [[ -z "$display_manager" || "$display_manager" == gdm.service || "$display_manager" == gdm3.service ]] || \
    live_image_fail "baked live rootfs replaces GDM as the display manager"
  local identity metadata
  identity="$(live_image_target "$live_image_identity_path")"
  metadata="$(live_image_target /usr/share/doc/sos/install-metadata.env)"
  [[ "$(live_image_metadata_value "$identity" image_kind)" == live-boot ]] || \
    live_image_fail "image identity is not labeled live-boot"
  [[ "$(live_image_metadata_value "$identity" not_installed_product)" == true ]] || \
    live_image_fail "image identity must say this is not an installed product"
  [[ "$(live_image_metadata_value "$identity" agent_mode)" == offline ]] || \
    live_image_fail "image identity must pin the offline agent"
  [[ "$(live_image_metadata_value "$identity" source_dirty)" == false ]] || \
    live_image_fail "image identity came from a dirty source tree"
  local image_revision installed_revision
  image_revision="$(live_image_metadata_value "$identity" source_revision)"
  installed_revision="$(live_image_metadata_value "$metadata" source_revision)"
  [[ -n "$image_revision" && "$image_revision" == "$installed_revision" ]] || \
    live_image_fail "image identity revision does not match staged install metadata"
  [[ "$(live_image_metadata_value "$metadata" agent_mode)" == offline ]] || \
    live_image_fail "staged install metadata must pin the offline agent"
  local skel_config liveuser_config=""
  skel_config="$(live_image_target /etc/skel/.local/state/sos/agent/config.env)"
  [[ -f "$skel_config" ]] || live_image_fail "offline live skel agent config is missing"
  grep -Fx "SOS_AGENT_FAKE_SOURCE=$live_image_offline_source" "$skel_config" >/dev/null || \
    live_image_fail "offline live skel does not pin the baked daily-flow source"
  if [[ -d "$(live_image_target /home/liveuser)" ]]; then
    liveuser_config="$(live_image_target /home/liveuser/.local/state/sos/agent/config.env)"
    [[ -f "$liveuser_config" ]] || live_image_fail "existing liveuser is missing offline agent config"
  fi
  printf 'linux_live_image_rootfs_checked=PASS root=%s revision=%s boot_kind=live-boot not_installed_product=true\n' \
    "$live_image_rootfs" "$image_revision"
}

live_image_probe_payload() {
  local payload="$1"
  if unsquashfs -l "$payload" >/dev/null 2>&1; then
    if unsquashfs -l "$payload" | grep -q 'LiveOS/rootfs.img'; then
      printf 'squashfs-rootfs-img\n'
      return 0
    fi
    printf 'flat-squashfs\n'
    return 0
  fi
  if command -v dump.erofs >/dev/null 2>&1 && dump.erofs "$payload" >/dev/null 2>&1; then
    printf 'erofs\n'
    return 0
  fi
  live_image_fail "unrecognized live payload format: $payload"
}

live_image_find_payload() {
  local iso_tree="$1"
  local candidate
  for candidate in LiveOS/squashfs.img LiveOS/erofs.img LiveOS/overlay.img; do
    if [[ -f "$iso_tree/$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  live_image_fail "source ISO has no LiveOS squashfs/erofs payload; this is not a Fedora live image"
}

live_image_extract_payload() {
  local payload="$1" format="$2" dest="$3" work="$4"
  mkdir -p -- "$dest" "$work"
  case "$format" in
    flat-squashfs)
      unsquashfs -f -d "$dest" "$payload" >/dev/null
      ;;
    squashfs-rootfs-img)
      unsquashfs -f -d "$work/squash" "$payload" >/dev/null
      [[ -f "$work/squash/LiveOS/rootfs.img" ]] || \
        live_image_fail "nested live squashfs is missing LiveOS/rootfs.img"
      live_image_mount_rootfs_img "$work/squash/LiveOS/rootfs.img" "$dest"
      ;;
    erofs)
      command -v fsck.erofs >/dev/null 2>&1 || \
        live_image_fail "fsck.erofs is required to extract this Fedora live payload"
      fsck.erofs --extract="$dest" "$payload" >/dev/null
      ;;
    *) live_image_fail "cannot extract container format: $format" ;;
  esac
}

live_image_mount_rootfs_img() {
  local image="$1" dest="$2"
  live_image_require_command e2fsck
  live_image_require_command resize2fs
  local current added
  current="$(stat -c %s "$image")"
  added=$((2 * 1024 * 1024 * 1024))
  truncate -s $((current + added)) "$image"
  e2fsck -f -y "$image" >/dev/null
  resize2fs "$image" >/dev/null
  sudo mount -o loop -- "$image" "$dest"
  live_image_rootfs_img="$image"
  live_image_rootfs_mounted=true
}

live_image_unmount_rootfs() {
  if [[ "${live_image_rootfs_mounted:-false}" == true ]]; then
    sudo umount -- "$live_image_rootfs"
    live_image_rootfs_mounted=false
    if [[ -n "${live_image_rootfs_img:-}" ]]; then
      e2fsck -f -y "$live_image_rootfs_img" >/dev/null
      resize2fs -M "$live_image_rootfs_img" >/dev/null
    fi
  fi
}

live_image_repack_payload() {
  local format="$1" rootfs="$2" work="$3" output="$4"
  case "$format" in
    flat-squashfs)
      mksquashfs "$rootfs" "$output" -noappend -comp zstd >/dev/null
      ;;
    squashfs-rootfs-img)
      mksquashfs "$work/squash" "$output" -noappend -comp zstd >/dev/null
      ;;
    erofs)
      command -v mkfs.erofs >/dev/null 2>&1 || \
        live_image_fail "mkfs.erofs is required to rebuild this Fedora live payload"
      mkfs.erofs -zlz4 "$output" "$rootfs" >/dev/null
      ;;
    *) live_image_fail "cannot repack container format: $format" ;;
  esac
}

live_image_verify_fedora_workstation() {
  local root="$1" os_release="$1/etc/os-release"
  [[ -r "$os_release" ]] || live_image_fail "extracted live rootfs has no /etc/os-release"
  # shellcheck source=/dev/null
  source "$os_release"
  [[ "${ID:-}" == fedora ]] || \
    live_image_fail "source live image is not Fedora (ID=${ID:-unknown})"
  [[ "${VARIANT_ID:-}" == workstation || "${VARIANT:-}" == *Workstation* ]] || \
    live_image_fail "source live image is not Fedora Workstation (VARIANT=${VARIANT:-unknown})"
}

live_image_install_runtime_packages() {
  local root="$1"
  [[ -r /etc/os-release ]] || live_image_fail "bake host has no /etc/os-release"
  # shellcheck source=/dev/null
  source /etc/os-release
  [[ "${ID:-}" == fedora ]] || \
    live_image_fail "baking a Fedora live remix requires a Fedora host; found ${ID:-unknown}"
  [[ "$(uname -m)" == x86_64 ]] || \
    live_image_fail "Framework 12 live images must be baked on x86_64"
  live_image_require_command dnf
  local releasever=""
  releasever="$(sed -n 's/^VERSION_ID=//p' "$root/etc/os-release" | tail -n 1 | tr -d '"')"
  [[ -n "$releasever" ]] || live_image_fail "extracted live rootfs has no VERSION_ID"
  # Runtime packages only; do not install -devel toolchains or appliance units.
  # shellcheck disable=SC2046
  sudo dnf -y --installroot="$root" --releasever="$releasever" \
    --setopt=install_weak_deps=False \
    install $(live_image_runtime_packages)
  sudo dnf --installroot="$root" --releasever="$releasever" clean all
}

live_image_stage_sos() {
  local root="$1"
  (
    cd "$live_image_root"
    ./tools/install-linux-login-session install --offline --destdir "$root"
  )
  sudo install -o root -g root -m 0755 \
    "$live_image_root/tools/linux-hardware-gate" \
    "$(live_image_target "$live_image_harness")"
  sudo install -o root -g root -m 0644 \
    "$live_image_root/docs/linux-hardware-gate.md" \
    "$(live_image_target /usr/share/doc/sos/linux-hardware-gate.md)"
  sudo install -o root -g root -m 0644 \
    "$live_image_root/docs/linux-live-image.md" \
    "$(live_image_target /usr/share/doc/sos/linux-live-image.md)"
  sudo mkdir -p -- "$(live_image_target /etc/skel)"
  local skel_tmp
  skel_tmp="$(mktemp -d -t sos-live-skel.XXXXXX)"
  live_image_write_offline_user_state --home-root "$skel_tmp"
  sudo mkdir -p -- "$(live_image_target /etc/skel/.local/state)"
  sudo cp -a "$skel_tmp/.local" "$(live_image_target /etc/skel)/"
  sudo chown -R root:root "$(live_image_target /etc/skel/.local)"
  rm -r -- "$skel_tmp"
  if [[ -d "$(live_image_target /home/liveuser)" ]]; then
    local liveuser_tmp live_uid=1000 live_gid=1000
    liveuser_tmp="$(mktemp -d -t sos-liveuser.XXXXXX)"
    live_image_write_offline_user_state --home-root "$liveuser_tmp"
    if [[ -r "$(live_image_target /etc/passwd)" ]]; then
      live_uid="$(awk -F: '$1=="liveuser"{print $3}' "$(live_image_target /etc/passwd)")"
      live_gid="$(awk -F: '$1=="liveuser"{print $4}' "$(live_image_target /etc/passwd)")"
      [[ -n "$live_uid" && -n "$live_gid" ]] || {
        live_uid=1000
        live_gid=1000
      }
    fi
    sudo mkdir -p -- "$(live_image_target /home/liveuser/.local/state)"
    sudo cp -a "$liveuser_tmp/.local" "$(live_image_target /home/liveuser)/"
    sudo chown -R "$live_uid:$live_gid" "$(live_image_target /home/liveuser/.local)"
    rm -r -- "$liveuser_tmp"
  fi
}

live_image_write_identity_file() {
  local dest="$1"
  shift
  local temporary
  temporary="$(mktemp -t sos-image-identity.XXXXXX)"
  live_image_format_identity "$@" >"$temporary"
  if [[ -n "${live_image_rootfs:-}" && "$dest" == "$(live_image_target "$live_image_identity_path")" ]]; then
    sudo install -o root -g root -m 0644 "$temporary" "$dest"
  else
    install -m 0644 "$temporary" "$dest"
  fi
  rm -f -- "$temporary"
}

live_image_bake() {
  local source_iso="" output_dir=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --source-iso)
        [[ "$#" -ge 2 ]] || live_image_fail "--source-iso requires a path"
        source_iso="$(realpath -e -- "$2")"
        shift 2
        ;;
      --output-dir)
        [[ "$#" -ge 2 ]] || live_image_fail "--output-dir requires a directory"
        output_dir="$(realpath -m -- "$2")"
        shift 2
        ;;
      *) live_image_fail "unexpected option: $1" ;;
    esac
  done
  [[ -n "$source_iso" && -n "$output_dir" ]] || \
    live_image_fail "bake requires --source-iso ISO and --output-dir DIR"
  [[ "$(id -u)" -ne 0 ]] || live_image_fail "run bake as a normal user; it invokes sudo only for rootfs mutation"
  live_image_doctor >/dev/null
  for command in dnf e2fsck file resize2fs xorriso unsquashfs mksquashfs; do
    live_image_require_command "$command"
  done
  [[ "$(uname -m)" == x86_64 ]] || live_image_fail "Framework 12 live images must be baked on x86_64"
  # shellcheck source=/dev/null
  source /etc/os-release
  [[ "${ID:-}" == fedora ]] || \
    live_image_fail "baking a Fedora live remix requires a Fedora host; found ${ID:-unknown}"

  cd "$live_image_root"
  [[ -z "$(git status --porcelain --untracked-files=normal)" ]] || \
    live_image_fail "live image bake requires a clean source worktree"
  local source_revision
  source_revision="$(git rev-parse HEAD)"

  mkdir -p -- "$output_dir"
  chmod 0700 "$output_dir"
  local work iso_tree payload_relpath payload_path container_format
  work="$output_dir/work"
  rm -rf -- "$work"
  mkdir -p -- "$work/iso" "$work/rootfs"
  live_image_rootfs="$work/rootfs"
  live_image_rootfs_mounted=false
  live_image_rootfs_img=""
  trap 'live_image_unmount_rootfs' EXIT

  xorriso -osirrox on -indev "$source_iso" -extract / "$work/iso" >/dev/null
  chmod -R u+w "$work/iso"
  payload_relpath="$(live_image_find_payload "$work/iso")"
  payload_path="$work/iso/$payload_relpath"
  container_format="$(live_image_probe_payload "$payload_path")"
  live_image_extract_payload "$payload_path" "$container_format" "$live_image_rootfs" "$work"
  live_image_verify_fedora_workstation "$live_image_rootfs"
  [[ -e "$live_image_rootfs/usr/lib/systemd/system/gdm.service" \
    || -e "$live_image_rootfs/usr/sbin/gdm" \
    || -e "$live_image_rootfs/usr/bin/gdm" ]] || \
    live_image_fail "source live image does not contain GDM"
  live_image_install_runtime_packages "$live_image_rootfs"
  live_image_stage_sos "$live_image_rootfs"

  local base_name base_bytes base_sha baked_at
  base_name="$(basename -- "$source_iso")"
  base_bytes="$(stat -c %s "$source_iso")"
  base_sha="$(sha256sum "$source_iso" | cut -d ' ' -f 1)"
  baked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  live_image_write_identity_file \
    "$(live_image_target "$live_image_identity_path")" \
    --source-revision "$source_revision" \
    --source-dirty false \
    --agent-mode offline \
    --base-iso-filename "$base_name" \
    --base-iso-bytes "$base_bytes" \
    --base-iso-sha256 "$base_sha" \
    --payload-relpath "$payload_relpath" \
    --container-format "$container_format" \
    --baked-at-utc "$baked_at"
  live_image_check_rootfs --root "$live_image_rootfs"

  live_image_unmount_rootfs
  trap - EXIT
  local new_payload payload_bytes payload_sha
  new_payload="$work/payload.img"
  live_image_repack_payload "$container_format" "$live_image_rootfs" "$work" "$new_payload"
  payload_bytes="$(stat -c %s "$new_payload")"
  payload_sha="$(sha256sum "$new_payload" | cut -d ' ' -f 1)"
  live_image_write_identity_file \
    "$work/image-identity.env" \
    --source-revision "$source_revision" \
    --source-dirty false \
    --agent-mode offline \
    --base-iso-filename "$base_name" \
    --base-iso-bytes "$base_bytes" \
    --base-iso-sha256 "$base_sha" \
    --payload-relpath "$payload_relpath" \
    --payload-bytes "$payload_bytes" \
    --payload-sha256 "$payload_sha" \
    --container-format "$container_format" \
    --baked-at-utc "$baked_at"

  install -m 0644 "$work/image-identity.env" "$work/iso/sos-image-identity.env"
  cp -- "$new_payload" "$work/iso/$payload_relpath"
  local output_iso
  output_iso="$output_dir/sos-fedora-workstation-live-${source_revision:0:12}.iso"
  # Preserve the source volume ID and El Torito/EFI boot. Changing the label
  # breaks Fedora's root=live:CDLABEL=... cmdline.
  xorriso -report_about WARNING \
    -indev "$source_iso" -outdev "$output_iso" \
    -boot_image any replay \
    -map "$work/iso/$payload_relpath" "/$payload_relpath" \
    -map "$work/iso/sos-image-identity.env" /sos-image-identity.env
  local output_bytes output_sha
  output_bytes="$(stat -c %s "$output_iso")"
  output_sha="$(sha256sum "$output_iso" | cut -d ' ' -f 1)"
  live_image_write_identity_file \
    "$output_dir/image-identity.env" \
    --source-revision "$source_revision" \
    --source-dirty false \
    --agent-mode offline \
    --base-iso-filename "$base_name" \
    --base-iso-bytes "$base_bytes" \
    --base-iso-sha256 "$base_sha" \
    --payload-relpath "$payload_relpath" \
    --payload-bytes "$payload_bytes" \
    --payload-sha256 "$payload_sha" \
    --container-format "$container_format" \
    --baked-at-utc "$baked_at" \
    --output-iso-filename "$(basename -- "$output_iso")" \
    --output-iso-bytes "$output_bytes" \
    --output-iso-sha256 "$output_sha"
  printf 'linux_live_image_baked=PASS iso=%s bytes=%s sha256=%s boot_kind=live-boot not_installed_product=true\n' \
    "$output_iso" "$output_bytes" "$output_sha"
}

[[ "$#" -ge 1 ]] || {
  live_image_usage >&2
  exit 1
}
live_image_command="$1"
shift
case "$live_image_command" in
  doctor) live_image_doctor "$@" ;;
  format-identity) live_image_format_identity "$@" ;;
  write-offline-user-state) live_image_write_offline_user_state "$@" ;;
  check-rootfs) live_image_check_rootfs "$@" ;;
  bake) live_image_bake "$@" ;;
  *)
    live_image_usage >&2
    exit 1
    ;;
esac
