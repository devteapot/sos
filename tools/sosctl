android_provider_health() {
  local response=""
  if ! { exec 9<>"/dev/tcp/127.0.0.1/$M1_PROVIDER_PORT"; } 2>/dev/null; then
    return 1
  fi
  if ! printf '%s\n' '{"kind":"snapshot","request_id":0}' >&9; then
    exec 9>&- 9<&-
    return 1
  fi
  IFS= read -r -t 1 response <&9 || true
  exec 9>&- 9<&-
  [[ "$response" == *'"request_id":0,"ok":true'* ]]
}

android_provider_port_open() {
  if { exec 9<>"/dev/tcp/127.0.0.1/$M1_PROVIDER_PORT"; } 2>/dev/null; then
    exec 9>&- 9<&-
    return 0
  fi
  return 1
}

managed_android_provider_pid() {
  if [[ ! -f "$M1_PROVIDER_PID" ]]; then
    rm -f "$M1_PROVIDER_UNIT_FILE"
    return 1
  fi

  local pid="" process_command="" unit="" unit_pid="" unit_state=""
  IFS= read -r pid < "$M1_PROVIDER_PID" || true
  if [[ ! "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$M1_PROVIDER_PID" "$M1_PROVIDER_UNIT_FILE"
    return 1
  fi

  if [[ -f "$M1_PROVIDER_UNIT_FILE" ]]; then
    IFS= read -r unit < "$M1_PROVIDER_UNIT_FILE" || true
    if [[ ! "$unit" =~ ^sos-android-providerd-[0-9]+-[0-9]+\.service$ ]]; then
      printf 'error: invalid managed Android provider unit name: %s\n' "$unit" >&2
      return 2
    fi
    unit_pid="$(systemctl --user show --property=MainPID --value "$unit" 2>/dev/null || true)"
    unit_state="$(systemctl --user show --property=ActiveState --value "$unit" 2>/dev/null || true)"
    if [[ "$unit_pid" != "$pid" || "$unit_state" != "active" ]]; then
      printf 'error: managed Android provider unit %s does not own live PID %s\n' \
        "$unit" "$pid" >&2
      return 2
    fi
  fi

  process_command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  if [[ "$process_command" != *"$M1_PROVIDER_BIN"* ]]; then
    printf 'error: %s points to unrelated live process %s\n' \
      "$M1_PROVIDER_PID" "$pid" >&2
    return 2
  fi
  printf '%s\n' "$pid"
}

stop_android_provider_pid() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    for _ in {1..50}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      printf 'error: Android provider/state daemon PID %s did not stop\n' "$pid" >&2
      return 1
    fi
  fi
}

android_provider_systemd_available() {
  command -v systemd-run >/dev/null 2>&1 && \
    command -v systemctl >/dev/null 2>&1 && \
    systemctl --user show-environment >/dev/null 2>&1
}

stop_android_provider_instance() {
  local pid="$1" unit=""
  if [[ -f "$M1_PROVIDER_UNIT_FILE" ]] && android_provider_systemd_available; then
    IFS= read -r unit < "$M1_PROVIDER_UNIT_FILE" || true
    if [[ "$unit" =~ ^sos-android-providerd-[0-9]+-[0-9]+\.service$ ]]; then
      systemctl --user stop "$unit" >/dev/null 2>&1 || true
      systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
    fi
  fi
  stop_android_provider_pid "$pid"
}

stop_android_provider() {
  local pid="" pid_status=0
  if pid="$(managed_android_provider_pid)"; then
    info "stopping Android provider/state daemon (PID $pid)"
    stop_android_provider_instance "$pid"
  else
    pid_status=$?
    [[ "$pid_status" -eq 1 ]] || return "$pid_status"
  fi
  rm -f "$M1_PROVIDER_PID" "$M1_PROVIDER_UNIT_FILE"
}

build_android_provider() {
  info "building the Android provider/state daemon"
  (
    cd "$SOS_ROOT"
    cargo build --locked -p providers-fake --bin providerd
  )
  [[ -x "$M1_PROVIDER_BIN" ]] || fail "provider daemon build did not produce $M1_PROVIDER_BIN"
}

start_android_provider() {
  require_command ps

  stop_android_provider
  if android_provider_health; then
    fail "a compatible unmanaged provider is already listening on 127.0.0.1:$M1_PROVIDER_PORT"
  fi
  if android_provider_port_open; then
    fail "TCP port $M1_PROVIDER_PORT is occupied by an unmanaged process"
  fi

  mkdir -p "$(dirname "$M1_PROVIDER_STATE")" "$(dirname "$M1_PROVIDER_PID")" \
    "$(dirname "$M1_PROVIDER_LOG")" "$(dirname "$M1_PROVIDER_UNIT_FILE")"
  : > "$M1_PROVIDER_LOG"
  local pid="" unit="" unit_state=""
  if android_provider_systemd_available; then
    unit="sos-android-providerd-$$-$RANDOM.service"
    systemd-run --user --quiet --unit="$unit" --service-type=exec \
      --property="StandardOutput=append:$M1_PROVIDER_LOG" \
      --property="StandardError=append:$M1_PROVIDER_LOG" \
      "$M1_PROVIDER_BIN" --state-file "$M1_PROVIDER_STATE"
    printf '%s\n' "$unit" > "$M1_PROVIDER_UNIT_FILE"
    for _ in {1..50}; do
      pid="$(systemctl --user show --property=MainPID --value "$unit" 2>/dev/null || true)"
      [[ "$pid" =~ ^[1-9][0-9]*$ ]] && break
      unit_state="$(systemctl --user show --property=ActiveState --value "$unit" 2>/dev/null || true)"
      [[ "$unit_state" != "failed" ]] || break
      sleep 0.1
    done
    if [[ ! "$pid" =~ ^[1-9][0-9]*$ ]]; then
      systemctl --user stop "$unit" >/dev/null 2>&1 || true
      rm -f "$M1_PROVIDER_UNIT_FILE"
      fail "systemd did not start the Android provider; inspect $M1_PROVIDER_LOG"
    fi
  else
    require_command nohup
    rm -f "$M1_PROVIDER_UNIT_FILE"
    nohup "$M1_PROVIDER_BIN" --state-file "$M1_PROVIDER_STATE" \
      >> "$M1_PROVIDER_LOG" 2>&1 < /dev/null &
    pid=$!
  fi
  printf '%s\n' "$pid" > "$M1_PROVIDER_PID"
  M1_RUN_STARTED_PROVIDER_PID="$pid"

  for _ in {1..100}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$M1_PROVIDER_PID" "$M1_PROVIDER_UNIT_FILE"
      fail "Android provider/state daemon exited during startup; inspect $M1_PROVIDER_LOG"
    fi
    if android_provider_health; then
      info "Android provider/state daemon is ready (PID $pid)"
      return 0
    fi
    sleep 0.1
  done

  stop_android_provider_instance "$pid"
  rm -f "$M1_PROVIDER_PID" "$M1_PROVIDER_UNIT_FILE"
  fail "Android provider/state daemon did not become ready; inspect $M1_PROVIDER_LOG"
}

android_reverse_ready() {
  adb reverse --list | awk -v endpoint="tcp:$M1_PROVIDER_PORT" \
    '$2 == endpoint && $3 == endpoint { found = 1 } END { exit !found }'
}

configure_android_provider_reverse() {
  if android_reverse_ready; then
    info "ADB reverse tcp:$M1_PROVIDER_PORT is already configured"
    return 0
  fi
  adb reverse "tcp:$M1_PROVIDER_PORT" "tcp:$M1_PROVIDER_PORT" >/dev/null
  M1_RUN_ADDED_REVERSE=true
  info "configured ADB reverse tcp:$M1_PROVIDER_PORT"
}

cleanup_failed_m1_run() {
  local status=$?
  trap - EXIT
  if ! $M1_RUN_LAUNCH_COMPLETE; then
    if $M1_RUN_ADDED_REVERSE; then
      adb reverse --remove "tcp:$M1_PROVIDER_PORT" >/dev/null 2>&1 || true
    fi
    if [[ -n "$M1_RUN_STARTED_PROVIDER_PID" ]]; then
      stop_android_provider_instance "$M1_RUN_STARTED_PROVIDER_PID" || true
      if [[ -f "$M1_PROVIDER_PID" ]] && \
        [[ "$(< "$M1_PROVIDER_PID")" == "$M1_RUN_STARTED_PROVIDER_PID" ]]; then
        rm -f "$M1_PROVIDER_PID" "$M1_PROVIDER_UNIT_FILE"
      fi
    fi
  fi
  exit "$status"
}

run_experience() (
  local no_follow=false
  if [[ "${1:-}" == "--no-follow" ]]; then
    no_follow=true
    shift
  fi
  [[ "$#" -eq 0 ]] || fail "unexpected m1-run argument: $1"

  trap cleanup_failed_m1_run EXIT
  doctor
  build_experience_apk
  build_android_provider
  start_android_provider
  configure_android_provider_reverse
  install_experience_apk
  launch_experience
  M1_RUN_LAUNCH_COMPLETE=true
  if ! $no_follow; then
    follow_package_logs "$M1_ANDROID_PACKAGE"
  fi
)

stop_experience() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl m1-stop"
  require_command adb
  stop_android_provider

  local device_count=""
  device_count="$(adb devices | awk 'NR > 1 && $2 == "device" { count += 1 } END { print count + 0 }')"
  if [[ "$device_count" -eq 0 ]]; then
    info "no authorized Android device is connected; local provider is stopped"
    return 0
  fi
  select_device
  info "stopping $M1_ANDROID_PACKAGE"
  adb shell am force-stop "$M1_ANDROID_PACKAGE"
  if android_reverse_ready; then
    adb reverse --remove "tcp:$M1_PROVIDER_PORT" >/dev/null
    info "removed ADB reverse tcp:$M1_PROVIDER_PORT"
  fi
}

trigger_script_reload() {
  adb shell am start \
    -W \
    -a android.intent.action.VIEW \
    -d 'sos://reload' \
    -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY" >/dev/null
}

install_script() {
  local source_path="${1:-}"
  [[ -n "$source_path" ]] || fail "usage: ./tools/sosctl script <experience.luau>"
  [[ -f "$source_path" ]] || fail "script not found: $source_path"

  resolve_android_environment
  require_command adb
  select_device
  adb shell pm path "$M1_ANDROID_PACKAGE" >/dev/null 2>&1 || fail "$M1_ANDROID_PACKAGE is not installed"

  info "copying Luau candidate without rebuilding or restarting the app"
  adb push "$source_path" "$M1_DEVICE_STAGING" >/dev/null
  adb shell run-as "$M1_ANDROID_PACKAGE" \
    cp "$M1_DEVICE_STAGING" files/experience.candidate.luau
  adb shell rm -f "$M1_DEVICE_STAGING"
  trigger_script_reload
  info "candidate delivered; use ./tools/sosctl m1-logs to inspect acceptance"
}

validate_script() {
  local source_path="${1:-}"
  shift || true
  [[ -n "$source_path" ]] || \
    fail "usage: ./tools/sosctl validate <experience.luau> [--module ID=FILE]... [--json]"
  [[ -f "$source_path" ]] || fail "script not found: $source_path"
  local json_output=false has_modules=false argument
  for argument in "$@"; do
    [[ "$argument" == "--json" ]] && json_output=true
    [[ "$argument" == "--module" || "$argument" == --module=* ]] && has_modules=true
  done
  if [[ "$has_modules" == true ]]; then
    if [[ "$json_output" == true ]]; then
      info "entry source uses revision-local modules; validating the complete runtime package" >&2
    else
      info "entry source uses revision-local modules; validating the complete runtime package"
    fi
  elif [[ "$json_output" == true ]]; then
    typecheck_script "$source_path" >&2
  else
    typecheck_script "$source_path"
  fi
  local -a runtime_arguments=()
  local specification module_path
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --json)
        runtime_arguments+=("--json")
        shift
        ;;
      --module)
        [[ "$#" -ge 2 ]] || \
          fail "usage: ./tools/sosctl validate <experience.luau> [--module ID=FILE]... [--json]"
        specification="$2"
        shift 2
        ;;
      --module=*)
        specification="${1#--module=}"
        shift
        ;;
      *)
        fail "usage: ./tools/sosctl validate <experience.luau> [--module ID=FILE]... [--json]"
        ;;
    esac
    if [[ -n "${specification:-}" ]]; then
      [[ "$specification" == *=* ]] || fail "module must be ID=FILE: $specification"
      module_path="${specification#*=}"
      [[ -f "$module_path" ]] || fail "module script not found: $module_path"
      if [[ "$json_output" == true ]]; then
        typecheck_script "$module_path" >&2
      else
        typecheck_script "$module_path"
      fi
      runtime_arguments+=("--module" "$specification")
      specification=""
    fi
  done
  (
    cd "$SOS_ROOT"
    cargo run --quiet --locked -p runtime-luau --example validate -- \
      "$source_path" "${runtime_arguments[@]}"
  )
}

setup_luau_analyzer() {
  require_command git
  require_command cmake
  if [[ ! -d "$LUAU_ANALYZER_ROOT/.git" ]]; then
    [[ ! -e "$LUAU_ANALYZER_ROOT" ]] || \
      fail "Luau analyzer cache exists but is not a Git checkout: $LUAU_ANALYZER_ROOT"
    info "fetching pinned Luau analyzer $LUAU_ANALYZER_TAG"
    git clone --quiet --depth 1 --branch "$LUAU_ANALYZER_TAG" \
      https://github.com/luau-lang/luau.git "$LUAU_ANALYZER_ROOT"
  fi
  local actual_commit
  actual_commit="$(git -C "$LUAU_ANALYZER_ROOT" rev-parse HEAD)"
  [[ "$actual_commit" == "$LUAU_ANALYZER_COMMIT" ]] || \
    fail "Luau analyzer cache is not pinned commit $LUAU_ANALYZER_COMMIT (found $actual_commit)"
  if [[ ! -x "$LUAU_ANALYZER" ]]; then
    info "building pinned Luau analyzer"
    cmake -S "$LUAU_ANALYZER_ROOT" -B "$LUAU_ANALYZER_ROOT/build" \
      -DCMAKE_BUILD_TYPE=Release -DLUAU_BUILD_CLI=ON \
      -DLUAU_BUILD_TESTS=OFF -DLUAU_BUILD_WEB=OFF >/dev/null
    cmake --build "$LUAU_ANALYZER_ROOT/build" --target Luau.Analyze.CLI \
      --parallel "${SOS_BUILD_JOBS:-2}" >/dev/null
  fi
}

typecheck_script() {
  local source_path="${1:-}"
  [[ -f "$source_path" ]] || fail "script not found: $source_path"
  [[ -f "$LUAU_TYPE_PRELUDE" ]] || fail "Luau type prelude not found: $LUAU_TYPE_PRELUDE"
  setup_luau_analyzer

  local source_absolute source_directory temporary prelude_lines offset output status
  source_absolute="$(cd "$(dirname "$source_path")" && pwd)/$(basename "$source_path")"
  source_directory="$(dirname "$source_absolute")"
  temporary="$(mktemp "$source_directory/.sos-typecheck.XXXXXX.luau")"
  prelude_lines="$(wc -l < "$LUAU_TYPE_PRELUDE")"
  offset=$((prelude_lines - 1))
  cp "$LUAU_TYPE_PRELUDE" "$temporary"
  sed '1d' "$source_absolute" >> "$temporary"
  if output="$("$LUAU_ANALYZER" --mode=strict --formatter=gnu "$temporary" 2>&1)"; then
    status=0
  else
    status=$?
  fi
  rm -f "$temporary"

  local line remainder line_number source_line start_tail start_column end_tail end_line end_source_line
  while IFS= read -r line; do
    if [[ "$line" == "$temporary:"* ]]; then
      remainder="${line#"$temporary:"}"
      line_number="${remainder%%.*}"
      if [[ "$line_number" =~ ^[0-9]+$ ]]; then
        source_line=$((line_number - offset))
        start_tail="${remainder#*.}"
        start_column="${start_tail%%-*}"
        end_tail="${start_tail#*-}"
        end_line="${end_tail%%.*}"
        if [[ "$start_column" =~ ^[0-9]+$ && "$end_line" =~ ^[0-9]+$ ]]; then
          end_source_line=$((end_line - offset))
          printf '%s:%s.%s-%s.%s\n' "$source_absolute" "$source_line" "$start_column" \
            "$end_source_line" "${end_tail#*.}"
        else
          printf '%s:%s.%s\n' "$source_absolute" "$source_line" "$start_tail"
        fi
        continue
      fi
    fi
    printf '%s\n' "$line"
  done <<< "$output"
  [[ "$status" -eq 0 ]] || return "$status"
  info "Luau types passed: $source_path"
}

agent_generate_script() {
  local request="${1:-}"
  [[ -n "$request" ]] || fail "usage: ./tools/sosctl agent-generate <request>"
  require_command codex
  mkdir -p "$ARTIFACT_DIR"

  local run_id target transcript final_message prompt
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-luna-medium"
  target="$SOS_ROOT/.cache/agent-candidates/android-stock-agent.luau"
  transcript="$ARTIFACT_DIR/agent-$run_id.jsonl"
  final_message="$ARTIFACT_DIR/agent-$run_id-final.txt"
  mkdir -p "$(dirname "$target")"
  cp "$SOS_ROOT/experiences/mobile.luau" "$target"
  prompt="You are performing a single-shot SOS Stock Mobile mutation. Read docs/experience-api.md and the existing experiences. Implement this request: $request

Edit only .cache/agent-candidates/android-stock-agent.luau. Do not edit any other file. The file is a complete Experience API v4 Stock Mobile module. Keep its main export, mobile.theme import, validation branches, touch-first full-screen navigation, and at least one text_session whose submit_action is agent_submit. Calculate custom spatial geometry and gesture behavior in Luau when the request needs it. Do not run validation or edit again after changing the file; the outer harness performs the single authoritative validation attempt."

  info "running headless Codex with gpt-5.6-luna / medium reasoning"
  (
    cd "$SOS_ROOT"
    codex exec \
      --model gpt-5.6-luna \
      -c 'model_reasoning_effort="medium"' \
      --sandbox workspace-write \
      --ephemeral \
      --json \
      --output-last-message "$final_message" \
      "$prompt" | tee "$transcript"
  )
  [[ -f "$target" ]] || fail "agent did not create $target"
  validate_script "$target" \
    --module "mobile.theme=$SOS_ROOT/experiences/modules/mobile-theme.luau"
  info "generated source: $target"
  info "agent transcript: $transcript"
}

agent_apply_script() {
  local source_path="${1:-}"
  [[ -n "$source_path" ]] || fail "usage: ./tools/sosctl agent-apply <experience.luau>"
  if grep -F 'require("mobile.theme")' "$source_path" >/dev/null; then
    validate_script "$source_path" \
      --module "mobile.theme=$SOS_ROOT/experiences/modules/mobile-theme.luau"
  elif grep -F 'require("stock.theme")' "$source_path" >/dev/null; then
    validate_script "$source_path" \
      --module "stock.theme=$SOS_ROOT/experiences/modules/stock-theme.luau"
  else
    validate_script "$source_path"
  fi

  resolve_android_environment
  require_command adb
  select_device
  local app_pid before_results result=""
  app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
  [[ -n "$app_pid" ]] || fail "$M1_ANDROID_PACKAGE is not running; use ./tools/sosctl m1-launch"
  before_results="$(adb logcat -d --pid="$app_pid" -v brief \
    | grep -Ec 'script_(visible|rejected)|android_graph_presented|android_v4_candidate_rejected' || true)"
  install_script "$source_path"
  for _ in {1..100}; do
    result="$(adb logcat -d --pid="$app_pid" -v brief \
      | grep -E 'script_(visible|rejected)|android_graph_presented|android_v4_candidate_rejected' \
      | tail -n +$((before_results + 1)) | tail -n 1 || true)"
    [[ -n "$result" ]] && break
    sleep 0.1
  done
  [[ -n "$result" ]] || fail "candidate produced no acceptance result"
  printf '%s\n' "$result"
  [[ "$result" == *"script_visible"* || "$result" == *"android_graph_presented"* ]] \
    || fail "candidate was rejected"

  mkdir -p "$ARTIFACT_DIR"
  local screenshot="$ARTIFACT_DIR/sos-agent-latest.png"
  adb exec-out screencap -p > "$screenshot"
  local active_hash
  active_hash="$(sha256sum "$source_path" | awk '{ print $1 }')"
  info "candidate accepted; active source SHA-256: $active_hash"
  info "inspection screenshot: $screenshot"
  info "keep this revision or run ./tools/sosctl rollback"
}

restart_runtime_worker() {
  resolve_android_environment
  require_command adb
  select_device
  local app_pid before_ready result=""
  app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
  [[ -n "$app_pid" ]] || fail "$M1_ANDROID_PACKAGE is not running; use ./tools/sosctl m1-launch"
  before_ready="$(adb logcat -d --pid="$app_pid" -v brief | grep -c 'runtime_worker_ready' || true)"
  adb shell am start \
    -W \
    -a android.intent.action.VIEW \
    -d 'sos://worker-restart' \
    -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY" >/dev/null
  for _ in {1..100}; do
    result="$(adb logcat -d --pid="$app_pid" -v brief | grep 'runtime_worker_ready' | tail -n +$((before_ready + 1)) | tail -n 1 || true)"
    [[ -n "$result" ]] && break
    sleep 0.1
  done
  [[ -n "$result" ]] || fail "runtime worker did not become ready after restart"
  printf '%s\n' "$result"
}

rollback_script() {
  resolve_android_environment
  require_command adb
  select_device
  if [[ "$(adb shell getprop ro.sos.revision_format | tr -d '\r')" == 4 ]]; then
    local app_pid before_results result=""
    app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
    [[ -n "$app_pid" ]] || fail "$M1_ANDROID_PACKAGE is not running; use ./tools/sosctl m1-launch"
    before_results="$(adb logcat -d --pid="$app_pid" -v brief \
      | grep -Ec 'android_graph_rollback_(presented|rejected|selected_legacy)' || true)"
    adb shell am start \
      -W \
      -a android.intent.action.VIEW \
      -d 'sos://rollback' \
      -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY" >/dev/null
    for _ in {1..100}; do
      result="$(adb logcat -d --pid="$app_pid" -v brief \
        | grep -E 'android_graph_rollback_(presented|rejected|selected_legacy)' \
        | tail -n +$((before_results + 1)) | tail -n 1 || true)"
      [[ -n "$result" ]] && break
      sleep 0.1
    done
    [[ "$result" == *"android_graph_rollback_presented"* ]] || \
      fail "v4 graph rollback did not reach a visible frame: ${result:-no result}"
    printf '%s\n' "$result"
    return
  fi
  adb shell run-as "$M1_ANDROID_PACKAGE" \
    test -f files/experience.previous.luau || fail "no accepted previous revision is available"
  adb shell run-as "$M1_ANDROID_PACKAGE" \
    cp files/experience.previous.luau files/experience.candidate.luau
  trigger_script_reload
  info "previous accepted Luau revision submitted"
}

stress_experience() {
  local count="${1:-1000}"
  [[ "$count" =~ ^[0-9]+$ ]] || fail "stress count must be an integer"
  [[ "$count" -ge 1 && "$count" -le 10000 ]] || fail "stress count must be between 1 and 10000"

  resolve_android_environment
  require_command adb
  select_device
  adb shell pm path "$M1_ANDROID_PACKAGE" >/dev/null 2>&1 || fail "$M1_ANDROID_PACKAGE is not installed"

  local app_pid
  app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
  [[ -n "$app_pid" ]] || fail "$M1_ANDROID_PACKAGE is not running; use ./tools/sosctl m1-launch"

  local run_id
  run_id="$(date +%s)-$$-$count"
  info "starting $count transactional swaps; each swap waits for a GPUI frame"
  adb shell am start \
    -W \
    -a android.intent.action.VIEW \
    -d "sos://stress?count=$count\\&run_id=$run_id" \
    -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY" >/dev/null

  local attempts=$((count / 5 + 120))
  local result=""
  for ((attempt = 0; attempt < attempts; attempt += 1)); do
    app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
    [[ -n "$app_pid" ]] || fail "app process exited during stress run $run_id"
    result="$(adb logcat -d --pid="$app_pid" -v brief | grep -E "stress_(complete|failed) run_id=$run_id" | tail -n 1 || true)"
    if [[ -n "$result" ]]; then
      printf '%s\n' "$result"
      [[ "$result" == *"stress_complete"* ]] || fail "stress run $run_id failed"
      return
    fi
    sleep 1
  done
  fail "stress run $run_id did not finish within $attempts seconds"
}

build_linux_session() {
  [[ "$(uname -s)" == "Linux" ]] || fail "the Wayland host currently requires Linux"
  require_command cargo
  info "building the Linux GPUI host, authority, and revision session"
  (
    cd "$SOS_ROOT"
    cargo build --locked \
      -p sos-experience --features linux-host --bin sos-experience-host \
      -p revision-supervisor --bin sos-revision-supervisor \
      -p provider-state-service --bin sos-provider-state-service \
      -p sos-linux-session --bin sos-linux-session
    cargo build --locked -p sos-linux-session --bin sos-agent-authoring
  )
}

build_linux_agent() {
  require_command node
  require_command npm
  local node_version
  node_version="$(node --version | sed 's/^v//')"
  [[ "$(printf '%s\n' 22.19.0 "$node_version" | sort -V | head -n 1)" == "22.19.0" ]] || \
    fail "sos-agent requires Node 22.19 or newer"
  info "building pinned Pi agent service"
  (
    cd "$LINUX_AGENT_PACKAGE"
    npm ci --ignore-scripts
    npm run build
  )
  (
    cd "$SOS_ROOT"
    cargo build -p sos-linux-session --bin sos-agent-authoring
  )
}

require_wayland_session() {
  local runtime_directory="${XDG_RUNTIME_DIR:-}"
  local display_name="${WAYLAND_DISPLAY:-wayland-0}"
  [[ -n "$runtime_directory" ]] || fail "XDG_RUNTIME_DIR is not set"
  [[ -S "$runtime_directory/$display_name" ]] || \
    fail "Wayland socket not found: $runtime_directory/$display_name"
}

wait_for_linux_socket() {
  local socket_path="$1"
  local process_id="$2"
  local process_name="$3"
  for _ in {1..500}; do
    [[ -S "$socket_path" ]] && return
    kill -0 "$process_id" 2>/dev/null || {
      wait "$process_id" || true
      fail "$process_name exited before creating $socket_path"
    }
    sleep 0.01
  done
  fail "$process_name did not create $socket_path"
}

cleanup_linux_processes() {
  local supervisor_pid="$1"
  local provider_pid="$2"
  if [[ -n "$supervisor_pid" ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
    "$LINUX_SUPERVISOR" shutdown --root "$LINUX_REVISION_ROOT" >/dev/null 2>&1 || true
  fi
  if [[ -n "$provider_pid" ]] && kill -0 "$provider_pid" 2>/dev/null; then
    "$LINUX_SESSION" shutdown \
      --service-socket "$LINUX_PROVIDER_SOCKET" >/dev/null 2>&1 || true
  fi
  [[ -z "$supervisor_pid" ]] || wait "$supervisor_pid" 2>/dev/null || true
  [[ -z "$provider_pid" ]] || wait "$provider_pid" 2>/dev/null || true
  if [[ -S "$LINUX_PROVIDER_SOCKET" ]]; then
    rm -f "$LINUX_PROVIDER_SOCKET"
  fi
}

cleanup_linux_processes_from_trap() {
  cleanup_linux_processes "$LINUX_CLEANUP_SUPERVISOR_PID" "$LINUX_CLEANUP_PROVIDER_PID"
}

linux_run() {
  local windowed=false
  local host_timeout_ms="${SOS_LINUX_HOST_TIMEOUT_MS:-30000}"
  if [[ "${1:-}" == "--windowed" ]]; then
    windowed=true
    shift
  fi
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-run [--windowed]"
  [[ "$host_timeout_ms" =~ ^[1-9][0-9]*$ ]] || \
    fail "SOS_LINUX_HOST_TIMEOUT_MS must be a positive integer"
  require_wayland_session
  build_linux_session
  mkdir -p "$LINUX_REVISION_ROOT"

  local current_revision current_graph
  current_revision="$($LINUX_SUPERVISOR experience-status \
    --root "$LINUX_REVISION_ROOT" \
    --experience sos.stock.shell)"
  if [[ "$current_revision" == "none" ]]; then
    info "installing the initial packaged Stock Experience"
    current_revision="$($LINUX_SUPERVISOR install-package \
      --root "$LINUX_REVISION_ROOT" \
      --source "$SOS_ROOT/experiences/default.luau" \
      --state "$SOS_ROOT/tests/fixtures/empty-state.json" \
      --schema 1 \
      --package "$SOS_ROOT/experiences/default.package.json" \
      --asset "stock.theme:luau:$SOS_ROOT/experiences/modules/stock-theme.luau")"
  fi
  current_graph="$($LINUX_SUPERVISOR graph-status \
    --root "$LINUX_REVISION_ROOT" \
    --experience sos.stock.shell)"
  if [[ "$current_graph" == "none" ]]; then
    "$LINUX_SUPERVISOR" bootstrap-graph \
      --root "$LINUX_REVISION_ROOT" \
      --experience sos.stock.shell \
      --revision "$current_revision" >/dev/null
  fi

  if [[ "$($LINUX_SUPERVISOR experience-status \
      --root "$LINUX_REVISION_ROOT" \
      --experience sos.timeflow)" != "none" ]]; then
    "$LINUX_SUPERVISOR" retire-experience \
      --root "$LINUX_REVISION_ROOT" \
      --experience sos.timeflow >/dev/null
  fi

  local capability_file capability_temporary
  for capability_file in \
    "$LINUX_APPEARANCE_CAPABILITY_FILE" \
    "$LINUX_GRANT_CAPABILITY_FILE"; do
    if [[ ! -f "$capability_file" ]]; then
      capability_temporary="$capability_file.$$"
      (umask 077; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$capability_temporary")
      mv -n -- "$capability_temporary" "$capability_file"
      rm -f -- "$capability_temporary"
    fi
    chmod 0600 "$capability_file"
  done

  [[ ! -e "$LINUX_PROVIDER_SOCKET" ]] || \
    fail "provider socket already exists: $LINUX_PROVIDER_SOCKET"
  info "starting provider/state authority"
  "$LINUX_PROVIDER_SERVICE" \
    --socket "$LINUX_PROVIDER_SOCKET" \
    --state-file "$LINUX_AUTHORITY_FILE" \
    --appearance-capability-file "$LINUX_APPEARANCE_CAPABILITY_FILE" \
    --grant-capability-file "$LINUX_GRANT_CAPABILITY_FILE" &
  local provider_pid=$!
  local supervisor_pid=""
  LINUX_CLEANUP_SUPERVISOR_PID=""
  LINUX_CLEANUP_PROVIDER_PID="$provider_pid"
  trap cleanup_linux_processes_from_trap EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  wait_for_linux_socket "$LINUX_PROVIDER_SOCKET" "$provider_pid" "provider/state authority"
  "$LINUX_SESSION" bootstrap-graph \
    --root "$LINUX_REVISION_ROOT" \
    --experience sos.stock.shell \
    --service-socket "$LINUX_PROVIDER_SOCKET"
  "$LINUX_SESSION" review-graph-grants \
    --root "$LINUX_REVISION_ROOT" \
    --experience sos.stock.shell \
    --revision "$current_revision" \
    --service-socket "$LINUX_PROVIDER_SOCKET" \
    --capability-file "$LINUX_GRANT_CAPABILITY_FILE"

  info "starting permanent Linux graph host at revision $current_revision"
  local arguments=(
    serve
    --root "$LINUX_REVISION_ROOT"
    --host-executable "$LINUX_HOST"
    --service-socket "$LINUX_PROVIDER_SOCKET"
    --root-experience sos.stock.shell
    --timeout-ms "$host_timeout_ms"
    --host-arg --service-socket
    --host-arg "$LINUX_PROVIDER_SOCKET"
    --host-arg --agent-socket
    --host-arg "$LINUX_AGENT_SOCKET"
  )
  if $windowed; then
    arguments+=(--host-arg --windowed)
  fi
  "$LINUX_SUPERVISOR" "${arguments[@]}" &
  supervisor_pid=$!
  LINUX_CLEANUP_SUPERVISOR_PID="$supervisor_pid"

  local session_status=0
  set +e
  wait -n "$supervisor_pid" "$provider_pid"
  session_status=$?
  set -e
  local provider_failed=false
  if ! kill -0 "$provider_pid" 2>/dev/null && kill -0 "$supervisor_pid" 2>/dev/null; then
    provider_failed=true
  fi
  cleanup_linux_processes "$supervisor_pid" "$provider_pid"
  LINUX_CLEANUP_SUPERVISOR_PID=""
  LINUX_CLEANUP_PROVIDER_PID=""
  trap - EXIT INT TERM
  if $provider_failed; then
    fail "provider/state authority exited while the Linux session was active"
  fi
  return "$session_status"
}

linux_script() {
  [[ "$#" -ge 1 && "$#" -le 2 ]] || \
    fail "usage: ./tools/sosctl linux-script <experience.luau> [state.json]"
  local source_file="$1"
  local state_file="${2:-$SOS_ROOT/tests/fixtures/empty-state.json}"
  [[ -f "$source_file" ]] || fail "experience source not found: $source_file"
  [[ -f "$state_file" ]] || fail "experience state not found: $state_file"
  grep -Eq 'api_version[[:space:]]*=[[:space:]]*4' "$source_file" || \
    fail "linux-script accepts only Experience API v4 source"
  grep -F 'agent_submit' "$source_file" >/dev/null || \
    fail "linux-script edits Stock and requires the Stock agent composer"
  validate_script "$source_file" \
    --module "stock.theme=$SOS_ROOT/experiences/modules/stock-theme.luau"
  [[ -S "$LINUX_REVISION_ROOT/run/supervisor.sock" ]] || \
    fail "Linux supervisor is not running; start ./tools/sosctl linux-run"
  [[ -S "$LINUX_PROVIDER_SOCKET" ]] || \
    fail "provider/state authority is not running; restart ./tools/sosctl linux-run"

  local revision_id
  revision_id="$($LINUX_SUPERVISOR install-package \
    --root "$LINUX_REVISION_ROOT" \
    --source "$source_file" \
    --state "$state_file" \
    --schema 1 \
    --package "$SOS_ROOT/experiences/default.package.json" \
    --asset "stock.theme:luau:$SOS_ROOT/experiences/modules/stock-theme.luau")"
  local graph_id
  graph_id="$($LINUX_SUPERVISOR resolve-graph \
    --root "$LINUX_REVISION_ROOT" \
    --revision "$revision_id")"
  info "activating Luau revision $revision_id as graph $graph_id"
  "$LINUX_SUPERVISOR" activate-graph \
    --root "$LINUX_REVISION_ROOT" \
    --graph "$graph_id"
}

linux_status() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-status"
  "$LINUX_SUPERVISOR" daemon-status --root "$LINUX_REVISION_ROOT"
}

linux_stop() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-stop"
  if [[ -S "$LINUX_REVISION_ROOT/run/supervisor.sock" ]]; then
    "$LINUX_SUPERVISOR" shutdown --root "$LINUX_REVISION_ROOT"
  elif [[ -S "$LINUX_PROVIDER_SOCKET" ]]; then
    "$LINUX_SESSION" shutdown --service-socket "$LINUX_PROVIDER_SOCKET"
  else
    fail "Linux session is not running"
  fi
}

linux_agent_login() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-agent-login"
  build_linux_agent
  mkdir -p "$LINUX_AGENT_ROOT"
  info "starting Pi device-code login for ${SOS_AGENT_PROVIDER:-openai-codex}"
  node "$LINUX_AGENT_PACKAGE/dist/agent-runner.cjs" login \
    --provider "${SOS_AGENT_PROVIDER:-openai-codex}" \
    --credentials "$LINUX_AGENT_CREDENTIALS" \
    --device-code
}

linux_agent_run() {
  local fake_source=""
  if [[ "${1:-}" == "--fake" ]]; then
    [[ "$#" -eq 2 ]] || fail "usage: ./tools/sosctl linux-agent-run [--fake candidate.luau]"
    fake_source="$2"
    [[ -f "$fake_source" ]] || fail "fake candidate source not found: $fake_source"
    shift 2
  fi
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-agent-run [--fake candidate.luau]"
  [[ -S "$LINUX_REVISION_ROOT/run/supervisor.sock" ]] || \
    fail "Linux supervisor is not running; start ./tools/sosctl linux-run"
  [[ -S "$LINUX_PROVIDER_SOCKET" ]] || \
    fail "provider/state authority is not running; restart ./tools/sosctl linux-run"
  if [[ -z "$fake_source" ]]; then
    [[ -n "${SOS_AGENT_MODEL:-}" ]] || \
      fail "set SOS_AGENT_MODEL to an exact Pi model id and select SOS_AGENT_PROVIDER if needed"
  fi
  build_linux_agent
  mkdir -p "$LINUX_AGENT_ROOT"

  info "starting SOS authoring broker for unprivileged user $(id -un)"
  "$LINUX_AGENT_AUTHORING" \
    --root "$LINUX_REVISION_ROOT" \
    --service-socket "$LINUX_PROVIDER_SOCKET" \
    --supervisor-socket "$LINUX_REVISION_ROOT/run/supervisor.sock" \
    --listen-socket "$LINUX_AGENT_AUTHORING_SOCKET" \
    --agent-user "$(id -un)" &
  local broker_pid=$!
  trap 'kill "$broker_pid" 2>/dev/null || true; wait "$broker_pid" 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  wait_for_linux_socket "$LINUX_AGENT_AUTHORING_SOCKET" "$broker_pid" "SOS authoring broker"

  local arguments=(
    serve
    --socket "$LINUX_AGENT_SOCKET"
    --authoring-socket "$LINUX_AGENT_AUTHORING_SOCKET"
    --state "$LINUX_AGENT_STATE"
    --credentials "$LINUX_AGENT_CREDENTIALS"
    --api-doc "$SOS_ROOT/docs/experience-api.md"
    --example "$SOS_ROOT/experiences/default.luau"
  )
  if [[ -n "$fake_source" ]]; then
    arguments+=(--fake-source "$fake_source")
  fi
  info "starting resident Pi agent at $LINUX_AGENT_SOCKET"
  node "$LINUX_AGENT_PACKAGE/dist/agent-runner.cjs" "${arguments[@]}"
  local agent_status=$?
  kill "$broker_pid" 2>/dev/null || true
  wait "$broker_pid" 2>/dev/null || true
  trap - EXIT INT TERM
  return "$agent_status"
}

linux_agent_prompt() {
  [[ "$#" -eq 1 ]] || fail 'usage: ./tools/sosctl linux-agent-prompt "request"'
  [[ -S "$LINUX_AGENT_SOCKET" ]] || \
    fail "resident agent is not running; start ./tools/sosctl linux-agent-run"
  node "$LINUX_AGENT_PACKAGE/dist/agent-runner.cjs" prompt \
    --socket "$LINUX_AGENT_SOCKET" \
    --request "$1"
}

usage() {
  cat <<'USAGE'
Usage: ./tools/sosctl <command>

Commands:
  doctor              Validate the host toolchain and connected ARM64 device.
  sync                Fetch the exact unmodified GPUI Mobile revision.
  build               Build an optimized native library and debug-signed APK.
  install             Install the existing APK with adb install -r.
  launch              Launch the installed example app.
  logs                Follow logs from the running example process.
  run [--no-follow]   Doctor, build, install, launch, and follow logs.
  m1-build [--abi ABI] [--home] [--compat]
                      Build the SOS GPUI + Luau APK (ABI defaults to arm64-v8a).
  m1-check [--abi ABI]
                      Cross-check arm64-v8a or x86_64 Android compilation.
  m1-install          Install it with adb install -r (preserves app data).
  m1-launch           Launch the installed SOS experience.
  m1-logs             Follow logs from the SOS experience process.
  m1-run [--no-follow]
                      Build, start provider authority, install, launch, and follow logs.
  m1-stop             Stop SOS, its managed provider, and the ADB reverse mapping.
  script <file>       Transactionally load Luau source; no APK or restart.
  validate <file> [--module ID=FILE]... [--json]
                      Typecheck and validate every declared Luau scenario.
  typecheck <file>    Check a Luau source against the current API type prelude.
  agent-apply <file>  Validate and stage a Stock-compatible v4 edit, await its frame, and capture it.
  agent-generate <request>
                      One-shot headless Codex generation (Luna, medium).
  rollback            Present the prior accepted v4 graph, or use the retained compat source path.
  stress [count]      Run frame-paced transactional swaps (default: 1000).
  worker-restart      Recreate the Luau worker without replacing the APK.
  linux-run [--windowed]
                      Run authority, coordinator, and permanent GPUI host in Wayland.
  linux-script <file> [state.json]
                      Stage and activate Luau through the coordinated Linux session.
  linux-status        Report the active Linux revision and permanent host PID.
  linux-stop          Shut down authority, revision supervisor, and host.
  linux-agent-run [--fake candidate.luau]
                      Run the bounded resident Pi agent beside a live Linux session.
  linux-agent-login   Authenticate Pi's selected provider using a headless device code.
  linux-agent-prompt <request>
                      Ask the resident agent to change the active experience.
  linux-agent-test    Run Pi faux-provider through the full headless SOS stack.
  help                 Show this message.

Set ADB_SERIAL when more than one Android device is connected.
USAGE
}

command_name="${1:-help}"
shift || true

case "$command_name" in
  doctor)
    doctor
    ;;
  sync)
    sync_upstream
    ;;
  build)
    doctor
    build_apk
    ;;
  install)
    install_apk
    ;;
  launch)
    launch_app
    ;;
  logs)
    follow_logs
    ;;
  m1-build)
    build_experience_apk "$@"
    ;;
  m1-check)
    check_android_compilation "$@"
    ;;
  m1-install)
    install_experience_apk
    ;;
  m1-launch)
    launch_experience
    ;;
  m1-logs)
    follow_package_logs "$M1_ANDROID_PACKAGE"
    ;;
  script)
    install_script "${1:-}"
    ;;
  validate)
    [[ "$#" -ge 1 ]] || \
      fail "usage: ./tools/sosctl validate <experience.luau> [--module ID=FILE]... [--json]"
    validate_script "$@"
    ;;
  typecheck)
    [[ "$#" -eq 1 ]] || fail "usage: ./tools/sosctl typecheck <experience.luau>"
    typecheck_script "$1"
    ;;
  setup-luau-analyzer)
    [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl setup-luau-analyzer"
    setup_luau_analyzer
    info "Luau analyzer ready: $LUAU_ANALYZER"
    ;;
  agent-apply)
    [[ "$#" -eq 1 ]] || fail "usage: ./tools/sosctl agent-apply <experience.luau>"
    agent_apply_script "$1"
    ;;
  agent-generate)
    [[ "$#" -eq 1 ]] || fail "usage: ./tools/sosctl agent-generate <request>"
    agent_generate_script "$1"
    ;;
  rollback)
    rollback_script
    ;;
  stress)
    [[ "$#" -le 1 ]] || fail "usage: ./tools/sosctl stress [count]"
    stress_experience "${1:-1000}"
    ;;
  worker-restart)
    [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl worker-restart"
    restart_runtime_worker
    ;;
  linux-run)
    linux_run "$@"
    ;;
  linux-script)
    linux_script "$@"
    ;;
  linux-status)
    linux_status "$@"
    ;;
  linux-stop)
    linux_stop "$@"
    ;;
  linux-agent-run)
    linux_agent_run "$@"
    ;;
  linux-agent-login)
    linux_agent_login "$@"
    ;;
  linux-agent-prompt)
    linux_agent_prompt "$@"
    ;;
  linux-agent-test)
    [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-agent-test"
    "$SOS_ROOT/tools/linux-agent-e2e"
    ;;
  m1-run)
    run_experience "$@"
    ;;
  m1-stop)
    stop_experience "$@"
    ;;
  run)
    no_follow=false
    if [[ "${1:-}" == "--no-follow" ]]; then
      no_follow=true
      shift
    fi
    [[ "$#" -eq 0 ]] || fail "unexpected run argument: $1"
    doctor
    build_apk
    install_apk
    launch_app
    if ! $no_follow; then
      follow_logs
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    fail "unknown command: $command_name"
    ;;
esac
