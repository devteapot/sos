#!/usr/bin/env bash

set -euo pipefail

SOS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GPUI_REPOSITORY="https://github.com/itsbalamurali/gpui-mobile.git"
GPUI_COMMIT="1d3ec2a1d14a63b74d1f4269340441d4eeada27a"
GPUI_SHORT_COMMIT="${GPUI_COMMIT:0:12}"
NDK_VERSION="29.0.14206865"
M0_ANDROID_PACKAGE="dev.gpui.mobile.example"
M1_ANDROID_PACKAGE="dev.sos.experience"
ANDROID_ACTIVITY="dev.gpui.mobile.GpuiActivity"
CACHE_ROOT="$SOS_ROOT/.cache"
UPSTREAM_DIR="$CACHE_ROOT/gpui-mobile-$GPUI_SHORT_COMMIT"
ARTIFACT_DIR="$SOS_ROOT/artifacts"
M0_APK_PATH="$ARTIFACT_DIR/gpui-mobile-m0-$GPUI_SHORT_COMMIT.apk"
M1_GRADLE_DIR="$SOS_ROOT/apps/experience/android/gradle"
M1_JNI_DIR="$M1_GRADLE_DIR/app/src/main/jniLibs/arm64-v8a"
M1_GRADLE_APK="$M1_GRADLE_DIR/app/build/outputs/apk/debug/app-debug.apk"
M1_APK_PATH="$ARTIFACT_DIR/sos-experience.apk"
M1_DEVICE_STAGING="/data/local/tmp/dev.sos.experience.candidate.luau"
LINUX_REVISION_ROOT="${SOS_LINUX_REVISION_ROOT:-$CACHE_ROOT/linux-revisions-v3}"
LINUX_SUPERVISOR="$SOS_ROOT/target/debug/sos-revision-supervisor"
LINUX_HOST="$SOS_ROOT/target/debug/sos-experience-host"
LINUX_PROVIDER_SERVICE="$SOS_ROOT/target/debug/sos-provider-state-service"
LINUX_SESSION="$SOS_ROOT/target/debug/sos-linux-session"
LINUX_AGENT_AUTHORING="$SOS_ROOT/target/debug/sos-agent-authoring"
LINUX_PROVIDER_SOCKET="$LINUX_REVISION_ROOT/run/provider-state.sock"
LINUX_AUTHORITY_FILE="$LINUX_REVISION_ROOT/authority.json"
LINUX_AGENT_ROOT="$CACHE_ROOT/linux-agent"
LINUX_AGENT_SOCKET="$LINUX_AGENT_ROOT/agent.sock"
LINUX_AGENT_AUTHORING_SOCKET="$LINUX_AGENT_ROOT/authoring.sock"
LINUX_AGENT_STATE="$LINUX_AGENT_ROOT/messages.json"
LINUX_AGENT_CREDENTIALS="$LINUX_AGENT_ROOT/auth.json"
LINUX_AGENT_PACKAGE="$SOS_ROOT/services/sos-agent"
LINUX_CLEANUP_SUPERVISOR_PID=""
LINUX_CLEANUP_PROVIDER_PID=""

info() {
  printf '==> %s\n' "$*"
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

resolve_android_environment() {
  local sdk_candidate="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
  if [[ -z "$sdk_candidate" && -d "${HOME}/Library/Android/sdk" ]]; then
    sdk_candidate="${HOME}/Library/Android/sdk"
  elif [[ -z "$sdk_candidate" && -d /usr/lib/android-sdk ]]; then
    sdk_candidate="/usr/lib/android-sdk"
  fi
  [[ -n "$sdk_candidate" && -d "$sdk_candidate" ]] || fail "Android SDK not found; set ANDROID_SDK_ROOT"

  local java_candidate="${JAVA_HOME:-}"
  if [[ -z "$java_candidate" || ! -x "$java_candidate/bin/java" ]]; then
    if [[ "$(uname -s)" == "Darwin" ]]; then
      java_candidate="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    elif command -v java >/dev/null 2>&1; then
      java_candidate="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"
    else
      java_candidate=""
    fi
  fi
  [[ -x "$java_candidate/bin/java" ]] || fail "Java not found; set JAVA_HOME or install Android Studio"

  local ndk_candidate="${ANDROID_NDK_ROOT:-${ANDROID_NDK_HOME:-}}"
  if [[ -z "$ndk_candidate" ]]; then
    ndk_candidate="$sdk_candidate/ndk/$NDK_VERSION"
  fi
  [[ -d "$ndk_candidate/toolchains/llvm" ]] || fail "Android NDK $NDK_VERSION not found at $ndk_candidate"

  export ANDROID_HOME="$sdk_candidate"
  export ANDROID_SDK_ROOT="$sdk_candidate"
  export ANDROID_NDK_HOME="$ndk_candidate"
  export ANDROID_NDK_ROOT="$ndk_candidate"
  export JAVA_HOME="$java_candidate"
  export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:${HOME}/.cargo/bin:$PATH"
}

require_android_rust_target() {
  rustup target list --installed | grep -qx 'aarch64-linux-android' || \
    fail "Rust target aarch64-linux-android is not installed"
}

run_native_arm64_android_cargo() {
  [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "aarch64" ]] || \
    fail "native ARM64 Android Cargo wrapper used on an unsupported host"

  for command_name in cargo clang clang++ llvm-ar-18; do
    require_command "$command_name"
  done

  local ndk_sysroot="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/sysroot"
  [[ -d "$ndk_sysroot" ]] || fail "Android NDK sysroot not found: $ndk_sysroot"

  CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="$SOS_ROOT/tools/android-clang-linker" \
  CC_aarch64_linux_android="$(command -v clang)" \
  CXX_aarch64_linux_android="$(command -v clang++)" \
  AR_aarch64_linux_android="$(command -v llvm-ar-18)" \
  CFLAGS_aarch64_linux_android="--target=aarch64-linux-android31 --sysroot=$ndk_sysroot" \
  CXXFLAGS_aarch64_linux_android="--target=aarch64-linux-android31 --sysroot=$ndk_sysroot" \
    cargo "$@"
}

check_android_compilation() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl m1-check"
  resolve_android_environment
  for command_name in cargo rustup; do
    require_command "$command_name"
  done
  require_android_rust_target

  info "checking the SOS GPUI host and embedded Luau runtime for ARM64 Android"
  if [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "aarch64" ]]; then
    (
      cd "$SOS_ROOT"
      run_native_arm64_android_cargo \
        check \
        -p sos-experience \
        --target aarch64-linux-android \
        --release \
        --locked \
        --no-default-features \
        --features gate-strict
    )
  else
    require_command cargo-ndk
    (
      cd "$SOS_ROOT"
      cargo ndk \
        -t arm64-v8a \
        -P 31 \
        check -p sos-experience --release --locked --no-default-features --features gate-strict
    )
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

select_device() {
  if [[ -n "${ADB_SERIAL:-}" ]]; then
    export ANDROID_SERIAL="$ADB_SERIAL"
  fi

  local device_count
  device_count="$(adb devices | awk 'NR > 1 && $2 == "device" { count += 1 } END { print count + 0 }')"
  [[ "$device_count" -gt 0 ]] || fail "no authorized Android device is connected"
  if [[ "$device_count" -gt 1 && -z "${ANDROID_SERIAL:-}" ]]; then
    fail "multiple Android devices are connected; set ADB_SERIAL"
  fi
}

doctor() {
  resolve_android_environment
  for command_name in git cargo rustup cargo-ndk adb; do
    require_command "$command_name"
  done
  select_device

  local target_sdk target_abis target_model
  target_sdk="$(adb shell getprop ro.build.version.sdk | tr -d '\r')"
  target_abis="$(adb shell getprop ro.product.cpu.abilist | tr -d '\r')"
  target_model="$(adb shell getprop ro.product.model | tr -d '\r')"

  [[ "$target_sdk" =~ ^[0-9]+$ && "$target_sdk" -ge 26 ]] || fail "device API level must be at least 26 (found $target_sdk)"
  [[ "$target_abis" == *"arm64-v8a"* ]] || fail "device must support arm64-v8a (found $target_abis)"
  [[ -d "$ANDROID_HOME/platforms/android-34" ]] || fail "Android platform 34 is not installed"
  [[ -d "$ANDROID_HOME/build-tools/34.0.0" ]] || fail "Android build tools 34.0.0 are not installed"
  require_android_rust_target

  info "host toolchain is ready"
  printf '    Rust:       %s\n' "$(rustc --version)"
  printf '    cargo-ndk:  %s\n' "$(cargo ndk --version)"
  printf '    SDK:        %s\n' "$ANDROID_HOME"
  printf '    NDK:        %s\n' "$ANDROID_NDK_HOME"
  printf '    Java:       %s\n' "$JAVA_HOME"
  printf '    Device:     %s (API %s; %s)\n' "$target_model" "$target_sdk" "$target_abis"
}

sync_upstream() {
  require_command git
  mkdir -p "$CACHE_ROOT"

  if [[ ! -d "$UPSTREAM_DIR/.git" ]]; then
    [[ ! -e "$UPSTREAM_DIR" ]] || fail "$UPSTREAM_DIR exists but is not a Git checkout"
    info "cloning GPUI Mobile"
    git clone --filter=blob:none --no-checkout "$GPUI_REPOSITORY" "$UPSTREAM_DIR"
    git -C "$UPSTREAM_DIR" fetch --depth 1 origin "$GPUI_COMMIT"
    git -C "$UPSTREAM_DIR" switch --detach "$GPUI_COMMIT"
  fi

  local actual_commit
  actual_commit="$(git -C "$UPSTREAM_DIR" rev-parse HEAD)"
  [[ "$actual_commit" == "$GPUI_COMMIT" ]] || fail "cached checkout is at $actual_commit, expected $GPUI_COMMIT"
  [[ -z "$(git -C "$UPSTREAM_DIR" status --short --untracked-files=no)" ]] || fail "cached upstream checkout has tracked modifications"
  info "using unmodified GPUI Mobile $GPUI_SHORT_COMMIT"
}

build_apk() {
  resolve_android_environment
  for command_name in git cargo rustup cargo-ndk adb; do
    require_command "$command_name"
  done
  sync_upstream

  local example_dir="$UPSTREAM_DIR/example"
  local gradle_dir="$example_dir/android/gradle"
  local jni_abi_dir="$gradle_dir/app/src/main/jniLibs/arm64-v8a"
  local upstream_apk="$gradle_dir/app/build/outputs/apk/debug/app-debug.apk"

  mkdir -p "$jni_abi_dir" "$ARTIFACT_DIR"
  # This directory contains only generated cargo-ndk outputs in the pinned cache.
  # Removing them prevents stale debug and release dependency libraries from
  # being packaged together.
  find "$jni_abi_dir" -maxdepth 1 -type f -name '*.so' -delete

  info "building optimized ARM64 Rust libraries"
  (
    cd "$example_dir"
    cargo ndk \
      -t arm64-v8a \
      -P 31 \
      -o android/gradle/app/src/main/jniLibs \
      build --release
  )

  info "packaging a debug-signed APK"
  (
    cd "$gradle_dir"
    ./gradlew clean assembleDebug
  )

  [[ -f "$upstream_apk" ]] || fail "Gradle did not produce $upstream_apk"
  cp "$upstream_apk" "$M0_APK_PATH"
  info "artifact: $M0_APK_PATH ($(du -h "$M0_APK_PATH" | awk '{ print $1 }'))"
}

install_apk() {
  resolve_android_environment
  require_command adb
  select_device
  [[ -f "$M0_APK_PATH" ]] || fail "APK not found; run ./tools/sosctl build first"
  info "installing $M0_ANDROID_PACKAGE"
  adb install -r "$M0_APK_PATH"
}

launch_app() {
  resolve_android_environment
  require_command adb
  select_device
  info "launching $M0_ANDROID_PACKAGE"
  adb shell am start -W -n "$M0_ANDROID_PACKAGE/$ANDROID_ACTIVITY"
}

follow_package_logs() {
  local package_name="$1"
  resolve_android_environment
  require_command adb
  select_device

  local app_pid=""
  for _ in {1..50}; do
    app_pid="$(adb shell pidof "$package_name" | tr -d '\r')"
    [[ -n "$app_pid" ]] && break
    sleep 0.1
  done
  [[ -n "$app_pid" ]] || fail "could not find the running $package_name process"

  info "following PID $app_pid logs; press Ctrl-C to stop"
  adb logcat --pid="$app_pid" -v color
}

follow_logs() {
  follow_package_logs "$M0_ANDROID_PACKAGE"
}

build_experience_apk() {
  resolve_android_environment
  for command_name in git cargo rustup cargo-ndk adb; do
    require_command "$command_name"
  done

  mkdir -p "$M1_JNI_DIR" "$ARTIFACT_DIR"
  find "$M1_JNI_DIR" -maxdepth 1 -type f -name '*.so' -delete

  info "building the SOS GPUI host and embedded Luau runtime for ARM64"
  if [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "aarch64" ]]; then
    # Google's Linux NDK host tools are x86-64. On a native ARM64 workstation,
    # compile C/C++ dependencies with the system LLVM toolchain and link through
    # the repository wrapper, which supplies the NDK sysroot and runtime.
    local ndk_sysroot="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/sysroot"
    local ndk_libcxx="$ndk_sysroot/usr/lib/aarch64-linux-android/libc++_shared.so"
    [[ -d "$ndk_sysroot" ]] || fail "Android NDK sysroot not found: $ndk_sysroot"
    [[ -f "$ndk_libcxx" ]] || fail "Android NDK libc++ not found: $ndk_libcxx"
    (
      cd "$SOS_ROOT"
      run_native_arm64_android_cargo \
        build \
        -p sos-experience \
        --target aarch64-linux-android \
        --release \
        --locked \
        --no-default-features \
        --features gate-strict
    )
    cp "$SOS_ROOT/target/aarch64-linux-android/release/libsos_experience.so" \
      "$M1_JNI_DIR/libsos_experience.so"
    cp "$ndk_libcxx" "$M1_JNI_DIR/libc++_shared.so"
  else
    (
      cd "$SOS_ROOT"
      cargo ndk \
        --link-libcxx-shared \
        -t arm64-v8a \
        -P 31 \
        -o apps/experience/android/gradle/app/src/main/jniLibs \
        build -p sos-experience --release --locked --no-default-features --features gate-strict
    )
  fi

  info "packaging a debug-signed SOS APK"
  if [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "aarch64" ]]; then
    # AGP requests Build Tools 36 even with compileSdk 34. Keep additions out of
    # a read-only system SDK and override Maven's x86-64 aapt2 with Ubuntu's
    # native ARM64 binary.
    require_command aapt2
    local sdk_overlay="$CACHE_ROOT/android-sdk-arm64-overlay"
    mkdir -p "$sdk_overlay/build-tools"
    for sdk_directory in licenses platform-tools platforms; do
      [[ -e "$ANDROID_HOME/$sdk_directory" ]] || fail "Android SDK directory missing: $sdk_directory"
      ln -sfn "$ANDROID_HOME/$sdk_directory" "$sdk_overlay/$sdk_directory"
    done
    while IFS= read -r build_tools_directory; do
      ln -sfn "$build_tools_directory" \
        "$sdk_overlay/build-tools/$(basename "$build_tools_directory")"
    done < <(find "$ANDROID_HOME/build-tools" -mindepth 1 -maxdepth 1 \
      -type d -name '[0-9]*' | sort)
    (
      cd "$M1_GRADLE_DIR"
      ANDROID_HOME="$sdk_overlay" ANDROID_SDK_ROOT="$sdk_overlay" \
        ./gradlew \
          -Pandroid.aapt2FromMavenOverride="$(command -v aapt2)" \
          clean assembleDebug
    )
  else
    (
      cd "$M1_GRADLE_DIR"
      ./gradlew clean assembleDebug
    )
  fi

  [[ -f "$M1_GRADLE_APK" ]] || fail "Gradle did not produce $M1_GRADLE_APK"
  cp "$M1_GRADLE_APK" "$M1_APK_PATH"
  local revision
  revision="$(git -C "$SOS_ROOT" rev-parse --short=12 HEAD)"
  if [[ -n "$(git -C "$SOS_ROOT" status --porcelain)" ]]; then
    revision="$revision-dirty"
  fi
  cp "$M1_GRADLE_APK" "$ARTIFACT_DIR/sos-experience-$revision.apk"
  info "artifact: $M1_APK_PATH ($(du -h "$M1_APK_PATH" | awk '{ print $1 }'))"
  info "revision artifact: $ARTIFACT_DIR/sos-experience-$revision.apk"
}

install_experience_apk() {
  resolve_android_environment
  require_command adb
  select_device
  [[ -f "$M1_APK_PATH" ]] || fail "APK not found; run ./tools/sosctl m1-build first"
  info "installing $M1_ANDROID_PACKAGE while preserving its data"
  adb install -r "$M1_APK_PATH"
}

launch_experience() {
  resolve_android_environment
  require_command adb
  select_device
  info "launching $M1_ANDROID_PACKAGE"
  adb shell am start -W -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY"
}

trigger_script_reload() {
  adb shell am start \
    -W \
    -a android.intent.action.VIEW \
    -d 'sos://reload' \
    -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY" >/dev/null
}

install_script() {
  local source_path="${1:-}"
  [[ -n "$source_path" ]] || fail "usage: ./tools/sosctl script <experience.luau>"
  [[ -f "$source_path" ]] || fail "script not found: $source_path"

  resolve_android_environment
  require_command adb
  select_device
  adb shell pm path "$M1_ANDROID_PACKAGE" >/dev/null 2>&1 || fail "$M1_ANDROID_PACKAGE is not installed"

  info "copying Luau candidate without rebuilding or restarting the app"
  adb push "$source_path" "$M1_DEVICE_STAGING" >/dev/null
  adb shell run-as "$M1_ANDROID_PACKAGE" \
    cp "$M1_DEVICE_STAGING" files/experience.candidate.luau
  adb shell rm -f "$M1_DEVICE_STAGING"
  trigger_script_reload
  info "candidate delivered; use ./tools/sosctl m1-logs to inspect acceptance"
}

validate_script() {
  local source_path="${1:-}"
  [[ -n "$source_path" ]] || fail "usage: ./tools/sosctl validate <experience.luau>"
  [[ -f "$source_path" ]] || fail "script not found: $source_path"
  (
    cd "$SOS_ROOT"
    cargo run --quiet --locked -p runtime-luau --example validate -- "$source_path"
  )
}

agent_generate_script() {
  local request="${1:-}"
  [[ -n "$request" ]] || fail "usage: ./tools/sosctl agent-generate <request>"
  require_command codex
  mkdir -p "$ARTIFACT_DIR"

  local run_id target transcript final_message prompt
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-luna-medium"
  target="$SOS_ROOT/experiences/android-exit-agent.luau"
  transcript="$ARTIFACT_DIR/agent-$run_id.jsonl"
  final_message="$ARTIFACT_DIR/agent-$run_id-final.txt"
  prompt="You are performing a single-shot SOS experience mutation. Read docs/experience-api.md and the existing experiences. Implement this request: $request

Create or replace only experiences/android-exit-agent.luau. Do not edit any other file. The file must be a complete Luau module satisfying the documented API. Calculate custom spatial geometry and drag/drop behavior in Luau; do not emulate the request with ordinary cards. Do not run validation or edit again after creating the file; the outer harness performs the single authoritative validation attempt."

  info "running headless Codex with gpt-5.6-luna / medium reasoning"
  (
    cd "$SOS_ROOT"
    codex exec \
      --model gpt-5.6-luna \
      -c 'model_reasoning_effort="medium"' \
      --sandbox workspace-write \
      --ephemeral \
      --json \
      --output-last-message "$final_message" \
      "$prompt" | tee "$transcript"
  )
  [[ -f "$target" ]] || fail "agent did not create $target"
  validate_script "$target"
  info "generated source: $target"
  info "agent transcript: $transcript"
}

agent_apply_script() {
  local source_path="${1:-}"
  [[ -n "$source_path" ]] || fail "usage: ./tools/sosctl agent-apply <experience.luau>"
  validate_script "$source_path"

  resolve_android_environment
  require_command adb
  select_device
  local app_pid before_results result=""
  app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
  [[ -n "$app_pid" ]] || fail "$M1_ANDROID_PACKAGE is not running; use ./tools/sosctl m1-launch"
  before_results="$(adb logcat -d --pid="$app_pid" -v brief | grep -Ec 'script_(visible|rejected)' || true)"
  install_script "$source_path"
  for _ in {1..100}; do
    result="$(adb logcat -d --pid="$app_pid" -v brief | grep -E 'script_(visible|rejected)' | tail -n +$((before_results + 1)) | tail -n 1 || true)"
    [[ -n "$result" ]] && break
    sleep 0.1
  done
  [[ -n "$result" ]] || fail "candidate produced no acceptance result"
  printf '%s\n' "$result"
  [[ "$result" == *"script_visible"* ]] || fail "candidate was rejected"

  mkdir -p "$ARTIFACT_DIR"
  local screenshot="$ARTIFACT_DIR/sos-agent-latest.png"
  adb exec-out screencap -p > "$screenshot"
  local active_hash
  active_hash="$(adb shell run-as "$M1_ANDROID_PACKAGE" sha256sum files/experience.active.luau | awk '{ print $1 }')"
  info "candidate accepted; active source SHA-256: $active_hash"
  info "inspection screenshot: $screenshot"
  info "keep this revision or run ./tools/sosctl rollback"
}

restart_runtime_worker() {
  resolve_android_environment
  require_command adb
  select_device
  local app_pid before_ready result=""
  app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
  [[ -n "$app_pid" ]] || fail "$M1_ANDROID_PACKAGE is not running; use ./tools/sosctl m1-launch"
  before_ready="$(adb logcat -d --pid="$app_pid" -v brief | grep -c 'runtime_worker_ready' || true)"
  adb shell am start \
    -W \
    -a android.intent.action.VIEW \
    -d 'sos://worker-restart' \
    -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY" >/dev/null
  for _ in {1..100}; do
    result="$(adb logcat -d --pid="$app_pid" -v brief | grep 'runtime_worker_ready' | tail -n +$((before_ready + 1)) | tail -n 1 || true)"
    [[ -n "$result" ]] && break
    sleep 0.1
  done
  [[ -n "$result" ]] || fail "runtime worker did not become ready after restart"
  printf '%s\n' "$result"
}

rollback_script() {
  resolve_android_environment
  require_command adb
  select_device
  adb shell run-as "$M1_ANDROID_PACKAGE" \
    test -f files/experience.previous.luau || fail "no accepted previous revision is available"
  adb shell run-as "$M1_ANDROID_PACKAGE" \
    cp files/experience.previous.luau files/experience.candidate.luau
  trigger_script_reload
  info "previous accepted Luau revision submitted"
}

stress_experience() {
  local count="${1:-1000}"
  [[ "$count" =~ ^[0-9]+$ ]] || fail "stress count must be an integer"
  [[ "$count" -ge 1 && "$count" -le 10000 ]] || fail "stress count must be between 1 and 10000"

  resolve_android_environment
  require_command adb
  select_device
  adb shell pm path "$M1_ANDROID_PACKAGE" >/dev/null 2>&1 || fail "$M1_ANDROID_PACKAGE is not installed"

  local app_pid
  app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
  [[ -n "$app_pid" ]] || fail "$M1_ANDROID_PACKAGE is not running; use ./tools/sosctl m1-launch"

  local run_id
  run_id="$(date +%s)-$$-$count"
  info "starting $count transactional swaps; each swap waits for a GPUI frame"
  adb shell am start \
    -W \
    -a android.intent.action.VIEW \
    -d "sos://stress?count=$count\\&run_id=$run_id" \
    -n "$M1_ANDROID_PACKAGE/$ANDROID_ACTIVITY" >/dev/null

  local attempts=$((count / 5 + 120))
  local result=""
  for ((attempt = 0; attempt < attempts; attempt += 1)); do
    app_pid="$(adb shell pidof "$M1_ANDROID_PACKAGE" | tr -d '\r')"
    [[ -n "$app_pid" ]] || fail "app process exited during stress run $run_id"
    result="$(adb logcat -d --pid="$app_pid" -v brief | grep -E "stress_(complete|failed) run_id=$run_id" | tail -n 1 || true)"
    if [[ -n "$result" ]]; then
      printf '%s\n' "$result"
      [[ "$result" == *"stress_complete"* ]] || fail "stress run $run_id failed"
      return
    fi
    sleep 1
  done
  fail "stress run $run_id did not finish within $attempts seconds"
}

build_linux_session() {
  [[ "$(uname -s)" == "Linux" ]] || fail "the Wayland host currently requires Linux"
  require_command cargo
  info "building the Linux GPUI host, authority, and revision session"
  (
    cd "$SOS_ROOT"
    cargo build --locked \
      -p sos-experience --features linux-host --bin sos-experience-host \
      -p revision-supervisor --bin sos-revision-supervisor \
      -p provider-state-service --bin sos-provider-state-service \
      -p sos-linux-session --bin sos-linux-session
    cargo build --locked -p sos-linux-session --bin sos-agent-authoring
  )
}

build_linux_agent() {
  require_command node
  require_command npm
  local node_version
  node_version="$(node --version | sed 's/^v//')"
  [[ "$(printf '%s\n' 22.19.0 "$node_version" | sort -V | head -n 1)" == "22.19.0" ]] || \
    fail "sos-agent requires Node 22.19 or newer"
  info "building pinned Pi agent service"
  (
    cd "$LINUX_AGENT_PACKAGE"
    npm ci --ignore-scripts
    npm run build
  )
  (
    cd "$SOS_ROOT"
    cargo build -p sos-linux-session --bin sos-agent-authoring
  )
}

require_wayland_session() {
  local runtime_directory="${XDG_RUNTIME_DIR:-}"
  local display_name="${WAYLAND_DISPLAY:-wayland-0}"
  [[ -n "$runtime_directory" ]] || fail "XDG_RUNTIME_DIR is not set"
  [[ -S "$runtime_directory/$display_name" ]] || \
    fail "Wayland socket not found: $runtime_directory/$display_name"
}

wait_for_linux_socket() {
  local socket_path="$1"
  local process_id="$2"
  local process_name="$3"
  for _ in {1..500}; do
    [[ -S "$socket_path" ]] && return
    kill -0 "$process_id" 2>/dev/null || {
      wait "$process_id" || true
      fail "$process_name exited before creating $socket_path"
    }
    sleep 0.01
  done
  fail "$process_name did not create $socket_path"
}

cleanup_linux_processes() {
  local supervisor_pid="$1"
  local provider_pid="$2"
  if [[ -n "$supervisor_pid" ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
    "$LINUX_SUPERVISOR" shutdown --root "$LINUX_REVISION_ROOT" >/dev/null 2>&1 || true
  fi
  if [[ -n "$provider_pid" ]] && kill -0 "$provider_pid" 2>/dev/null; then
    "$LINUX_SESSION" shutdown \
      --service-socket "$LINUX_PROVIDER_SOCKET" >/dev/null 2>&1 || true
  fi
  [[ -z "$supervisor_pid" ]] || wait "$supervisor_pid" 2>/dev/null || true
  [[ -z "$provider_pid" ]] || wait "$provider_pid" 2>/dev/null || true
  if [[ -S "$LINUX_PROVIDER_SOCKET" ]]; then
    rm -f "$LINUX_PROVIDER_SOCKET"
  fi
}

cleanup_linux_processes_from_trap() {
  cleanup_linux_processes "$LINUX_CLEANUP_SUPERVISOR_PID" "$LINUX_CLEANUP_PROVIDER_PID"
}

linux_run() {
  local windowed=false
  local host_timeout_ms="${SOS_LINUX_HOST_TIMEOUT_MS:-30000}"
  if [[ "${1:-}" == "--windowed" ]]; then
    windowed=true
    shift
  fi
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-run [--windowed]"
  [[ "$host_timeout_ms" =~ ^[1-9][0-9]*$ ]] || \
    fail "SOS_LINUX_HOST_TIMEOUT_MS must be a positive integer"
  require_wayland_session
  build_linux_session
  mkdir -p "$LINUX_REVISION_ROOT"

  local current_revision
  current_revision="$($LINUX_SUPERVISOR status --root "$LINUX_REVISION_ROOT")"
  if [[ "$current_revision" == "none" ]]; then
    info "installing the initial content-addressed Luau revision"
    current_revision="$($LINUX_SUPERVISOR install \
      --root "$LINUX_REVISION_ROOT" \
      --source "$SOS_ROOT/experiences/default.luau" \
      --state "$SOS_ROOT/tests/fixtures/empty-state.json" \
      --schema 1 \
      --api 3)"
    "$LINUX_SUPERVISOR" bootstrap \
      --root "$LINUX_REVISION_ROOT" \
      --revision "$current_revision" >/dev/null
  fi

  [[ ! -e "$LINUX_PROVIDER_SOCKET" ]] || \
    fail "provider socket already exists: $LINUX_PROVIDER_SOCKET"
  info "starting provider/state authority"
  "$LINUX_PROVIDER_SERVICE" \
    --socket "$LINUX_PROVIDER_SOCKET" \
    --state-file "$LINUX_AUTHORITY_FILE" &
  local provider_pid=$!
  local supervisor_pid=""
  LINUX_CLEANUP_SUPERVISOR_PID=""
  LINUX_CLEANUP_PROVIDER_PID="$provider_pid"
  trap cleanup_linux_processes_from_trap EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  wait_for_linux_socket "$LINUX_PROVIDER_SOCKET" "$provider_pid" "provider/state authority"
  "$LINUX_SESSION" bootstrap \
    --root "$LINUX_REVISION_ROOT" \
    --service-socket "$LINUX_PROVIDER_SOCKET"

  info "starting coordinated permanent Linux host at revision $current_revision"
  local arguments=(
    serve
    --root "$LINUX_REVISION_ROOT"
    --host-executable "$LINUX_HOST"
    --service-socket "$LINUX_PROVIDER_SOCKET"
    --timeout-ms "$host_timeout_ms"
    --host-arg --service-socket
    --host-arg "$LINUX_PROVIDER_SOCKET"
    --host-arg --agent-socket
    --host-arg "$LINUX_AGENT_SOCKET"
  )
  if $windowed; then
    arguments+=(--host-arg --windowed)
  fi
  "$LINUX_SUPERVISOR" "${arguments[@]}" &
  supervisor_pid=$!
  LINUX_CLEANUP_SUPERVISOR_PID="$supervisor_pid"

  local session_status=0
  set +e
  wait -n "$supervisor_pid" "$provider_pid"
  session_status=$?
  set -e
  local provider_failed=false
  if ! kill -0 "$provider_pid" 2>/dev/null && kill -0 "$supervisor_pid" 2>/dev/null; then
    provider_failed=true
  fi
  cleanup_linux_processes "$supervisor_pid" "$provider_pid"
  LINUX_CLEANUP_SUPERVISOR_PID=""
  LINUX_CLEANUP_PROVIDER_PID=""
  trap - EXIT INT TERM
  if $provider_failed; then
    fail "provider/state authority exited while the Linux session was active"
  fi
  return "$session_status"
}

linux_script() {
  [[ "$#" -ge 1 && "$#" -le 2 ]] || \
    fail "usage: ./tools/sosctl linux-script <experience.luau> [state.json]"
  local source_file="$1"
  local state_file="${2:-$SOS_ROOT/tests/fixtures/empty-state.json}"
  [[ -f "$source_file" ]] || fail "experience source not found: $source_file"
  [[ -f "$state_file" ]] || fail "experience state not found: $state_file"
  [[ -S "$LINUX_REVISION_ROOT/run/supervisor.sock" ]] || \
    fail "Linux supervisor is not running; start ./tools/sosctl linux-run"
  [[ -S "$LINUX_PROVIDER_SOCKET" ]] || \
    fail "provider/state authority is not running; restart ./tools/sosctl linux-run"

  local revision_id
  revision_id="$($LINUX_SUPERVISOR install \
    --root "$LINUX_REVISION_ROOT" \
    --source "$source_file" \
    --state "$state_file" \
    --schema 1 \
    --api 3)"
  local transaction_id
  transaction_id="$($LINUX_SESSION stage \
    --root "$LINUX_REVISION_ROOT" \
    --revision "$revision_id" \
    --service-socket "$LINUX_PROVIDER_SOCKET")"
  info "activating Luau revision $revision_id through transaction $transaction_id"
  "$LINUX_SUPERVISOR" activate \
    --root "$LINUX_REVISION_ROOT" \
    --revision "$revision_id" \
    --transaction "$transaction_id"
}

linux_status() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-status"
  "$LINUX_SUPERVISOR" daemon-status --root "$LINUX_REVISION_ROOT"
}

linux_stop() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-stop"
  if [[ -S "$LINUX_REVISION_ROOT/run/supervisor.sock" ]]; then
    "$LINUX_SUPERVISOR" shutdown --root "$LINUX_REVISION_ROOT"
  elif [[ -S "$LINUX_PROVIDER_SOCKET" ]]; then
    "$LINUX_SESSION" shutdown --service-socket "$LINUX_PROVIDER_SOCKET"
  else
    fail "Linux session is not running"
  fi
}

linux_agent_login() {
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-agent-login"
  build_linux_agent
  mkdir -p "$LINUX_AGENT_ROOT"
  info "starting Pi device-code login for ${SOS_AGENT_PROVIDER:-openai-codex}"
  node "$LINUX_AGENT_PACKAGE/dist/src/main.js" login \
    --provider "${SOS_AGENT_PROVIDER:-openai-codex}" \
    --credentials "$LINUX_AGENT_CREDENTIALS" \
    --device-code
}

linux_agent_run() {
  local fake_source=""
  if [[ "${1:-}" == "--fake" ]]; then
    [[ "$#" -eq 2 ]] || fail "usage: ./tools/sosctl linux-agent-run [--fake candidate.luau]"
    fake_source="$2"
    [[ -f "$fake_source" ]] || fail "fake candidate source not found: $fake_source"
    shift 2
  fi
  [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-agent-run [--fake candidate.luau]"
  [[ -S "$LINUX_REVISION_ROOT/run/supervisor.sock" ]] || \
    fail "Linux supervisor is not running; start ./tools/sosctl linux-run"
  [[ -S "$LINUX_PROVIDER_SOCKET" ]] || \
    fail "provider/state authority is not running; restart ./tools/sosctl linux-run"
  if [[ -z "$fake_source" ]]; then
    [[ -n "${SOS_AGENT_MODEL:-}" ]] || \
      fail "set SOS_AGENT_MODEL to an exact Pi model id and select SOS_AGENT_PROVIDER if needed"
  fi
  build_linux_agent
  mkdir -p "$LINUX_AGENT_ROOT"

  info "starting SOS authoring broker for unprivileged user $(id -un)"
  "$LINUX_AGENT_AUTHORING" \
    --root "$LINUX_REVISION_ROOT" \
    --service-socket "$LINUX_PROVIDER_SOCKET" \
    --supervisor-socket "$LINUX_REVISION_ROOT/run/supervisor.sock" \
    --listen-socket "$LINUX_AGENT_AUTHORING_SOCKET" \
    --agent-user "$(id -un)" &
  local broker_pid=$!
  trap 'kill "$broker_pid" 2>/dev/null || true; wait "$broker_pid" 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  wait_for_linux_socket "$LINUX_AGENT_AUTHORING_SOCKET" "$broker_pid" "SOS authoring broker"

  local arguments=(
    serve
    --socket "$LINUX_AGENT_SOCKET"
    --authoring-socket "$LINUX_AGENT_AUTHORING_SOCKET"
    --state "$LINUX_AGENT_STATE"
    --credentials "$LINUX_AGENT_CREDENTIALS"
    --api-doc "$SOS_ROOT/docs/experience-api.md"
    --example "$SOS_ROOT/experiences/default.luau"
    --example-secondary "$SOS_ROOT/experiences/daily-flow.luau"
  )
  if [[ -n "$fake_source" ]]; then
    arguments+=(--fake-source "$fake_source")
  fi
  info "starting resident Pi agent at $LINUX_AGENT_SOCKET"
  node "$LINUX_AGENT_PACKAGE/dist/src/main.js" "${arguments[@]}"
  local agent_status=$?
  kill "$broker_pid" 2>/dev/null || true
  wait "$broker_pid" 2>/dev/null || true
  trap - EXIT INT TERM
  return "$agent_status"
}

linux_agent_prompt() {
  [[ "$#" -eq 1 ]] || fail 'usage: ./tools/sosctl linux-agent-prompt "request"'
  [[ -S "$LINUX_AGENT_SOCKET" ]] || \
    fail "resident agent is not running; start ./tools/sosctl linux-agent-run"
  node "$LINUX_AGENT_PACKAGE/dist/src/main.js" prompt \
    --socket "$LINUX_AGENT_SOCKET" \
    --request "$1"
}

usage() {
  cat <<'USAGE'
Usage: ./tools/sosctl <command>

Commands:
  doctor              Validate the host toolchain and connected ARM64 device.
  sync                Fetch the exact unmodified GPUI Mobile revision.
  build               Build an optimized native library and debug-signed APK.
  install             Install the existing APK with adb install -r.
  launch              Launch the installed example app.
  logs                Follow logs from the running example process.
  run [--no-follow]   Doctor, build, install, launch, and follow logs.
  m1-build            Build the SOS GPUI + Luau ARM64 APK.
  m1-check            Cross-check the SOS GPUI + Luau ARM64 Android target.
  m1-install          Install it with adb install -r (preserves app data).
  m1-launch           Launch the installed SOS experience.
  m1-logs             Follow logs from the SOS experience process.
  m1-run [--no-follow]
                      Build, install, launch, and follow logs.
  script <file>       Transactionally load Luau source; no APK or restart.
  validate <file>     Compile, evaluate, decode, and validate Luau locally.
  agent-apply <file>  Validate, install, await frame, and capture screenshot.
  agent-generate <request>
                      One-shot headless Codex generation (Luna, medium).
  rollback            Submit the prior accepted Luau source as a candidate.
  stress [count]      Run frame-paced transactional swaps (default: 1000).
  worker-restart      Recreate the Luau worker without replacing the APK.
  linux-run [--windowed]
                      Run authority, coordinator, and permanent GPUI host in Wayland.
  linux-script <file> [state.json]
                      Stage and activate Luau through the coordinated Linux session.
  linux-status        Report the active Linux revision and permanent host PID.
  linux-stop          Shut down authority, revision supervisor, and host.
  linux-agent-run [--fake candidate.luau]
                      Run the bounded resident Pi agent beside a live Linux session.
  linux-agent-login   Authenticate Pi's selected provider using a headless device code.
  linux-agent-prompt <request>
                      Ask the resident agent to change the active experience.
  linux-agent-test    Run Pi faux-provider through the full headless SOS stack.
  help                 Show this message.

Set ADB_SERIAL when more than one Android device is connected.
USAGE
}

command_name="${1:-help}"
shift || true

case "$command_name" in
  doctor)
    doctor
    ;;
  sync)
    sync_upstream
    ;;
  build)
    doctor
    build_apk
    ;;
  install)
    install_apk
    ;;
  launch)
    launch_app
    ;;
  logs)
    follow_logs
    ;;
  m1-build)
    doctor
    build_experience_apk
    ;;
  m1-check)
    check_android_compilation "$@"
    ;;
  m1-install)
    install_experience_apk
    ;;
  m1-launch)
    launch_experience
    ;;
  m1-logs)
    follow_package_logs "$M1_ANDROID_PACKAGE"
    ;;
  script)
    install_script "${1:-}"
    ;;
  validate)
    [[ "$#" -eq 1 ]] || fail "usage: ./tools/sosctl validate <experience.luau>"
    validate_script "$1"
    ;;
  agent-apply)
    [[ "$#" -eq 1 ]] || fail "usage: ./tools/sosctl agent-apply <experience.luau>"
    agent_apply_script "$1"
    ;;
  agent-generate)
    [[ "$#" -eq 1 ]] || fail "usage: ./tools/sosctl agent-generate <request>"
    agent_generate_script "$1"
    ;;
  rollback)
    rollback_script
    ;;
  stress)
    [[ "$#" -le 1 ]] || fail "usage: ./tools/sosctl stress [count]"
    stress_experience "${1:-1000}"
    ;;
  worker-restart)
    [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl worker-restart"
    restart_runtime_worker
    ;;
  linux-run)
    linux_run "$@"
    ;;
  linux-script)
    linux_script "$@"
    ;;
  linux-status)
    linux_status "$@"
    ;;
  linux-stop)
    linux_stop "$@"
    ;;
  linux-agent-run)
    linux_agent_run "$@"
    ;;
  linux-agent-login)
    linux_agent_login "$@"
    ;;
  linux-agent-prompt)
    linux_agent_prompt "$@"
    ;;
  linux-agent-test)
    [[ "$#" -eq 0 ]] || fail "usage: ./tools/sosctl linux-agent-test"
    "$SOS_ROOT/tools/linux-agent-e2e"
    ;;
  m1-run)
    no_follow=false
    if [[ "${1:-}" == "--no-follow" ]]; then
      no_follow=true
      shift
    fi
    [[ "$#" -eq 0 ]] || fail "unexpected m1-run argument: $1"
    doctor
    build_experience_apk
    install_experience_apk
    launch_experience
    if ! $no_follow; then
      follow_package_logs "$M1_ANDROID_PACKAGE"
    fi
    ;;
  run)
    no_follow=false
    if [[ "${1:-}" == "--no-follow" ]]; then
      no_follow=true
      shift
    fi
    [[ "$#" -eq 0 ]] || fail "unexpected run argument: $1"
    doctor
    build_apk
    install_apk
    launch_app
    if ! $no_follow; then
      follow_logs
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    fail "unknown command: $command_name"
    ;;
esac
