#!/usr/bin/env bash

set -euo pipefail
umask 077

hardware_gate_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hardware_gate_install_metadata=/usr/share/doc/sos/install-metadata.env
hardware_gate_install_manifest=/usr/share/doc/sos/install-manifest.tsv
hardware_gate_image_identity=/usr/share/doc/sos/image-identity.env
hardware_gate_live_media_identity=/sos-image-identity.env
hardware_gate_development_metadata=/usr/share/doc/sos/development-deployment.env
hardware_gate_development_manifest=/usr/share/doc/sos/development-deployment-manifest.tsv
hardware_gate_session_entry=/usr/share/wayland-sessions/sos.desktop
hardware_gate_state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
hardware_gate_awake_unit=sos-linux-hardware-gate-awake.service
hardware_gate_collect_cleanup_unit=""

hardware_gate_fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

hardware_gate_usage() {
  printf '%s\n' \
    'usage:' \
    '  tools/linux-hardware-gate prepare --evidence-dir DIR [--expect-product TEXT]' \
    '  tools/linux-hardware-gate collect --evidence-dir DIR' \
    '  tools/linux-hardware-gate audit --evidence-dir DIR' \
    '  tools/linux-hardware-gate finalize-manifest --evidence-dir DIR' \
    '  tools/linux-hardware-gate verify-manifest --evidence-dir DIR' \
    '  tools/linux-hardware-gate classify-boot [--sysroot DIR]'
}

hardware_gate_require_command() {
  command -v "$1" >/dev/null 2>&1 || hardware_gate_fail "required command not found: $1"
}

hardware_gate_start_awake_inhibitor() {
  local evidence_dir="$1" inhibitor_list="" attempt inhibitor_registered=false
  if sudo systemctl is-active --quiet "$hardware_gate_awake_unit"; then
    hardware_gate_fail "another prepared Linux hardware gate already owns $hardware_gate_awake_unit"
  fi
  sudo systemd-run --quiet \
    --unit="$hardware_gate_awake_unit" \
    --property=CollectMode=inactive-or-failed \
    /usr/bin/systemd-inhibit \
      --what=idle:sleep:handle-lid-switch \
      --who='SOS Linux hardware gate' \
      --why='Prepared physical acceptance campaign' \
      --mode=block \
      /usr/bin/sleep infinity
  for ((attempt = 1; attempt <= 20; attempt++)); do
    if ! sudo systemctl is-active --quiet "$hardware_gate_awake_unit"; then
      hardware_gate_fail "Linux hardware gate awake inhibitor exited during startup"
    fi
    inhibitor_list="$(COLUMNS=1000 systemd-inhibit --list --no-pager --no-legend)"
    if grep -F 'SOS Linux hardware gate' <<<"$inhibitor_list" \
      | grep -F 'sleep:idle:handle-lid-switch' \
      | grep -F 'Prepared physical acceptance campaign' \
      | grep -F 'block' >/dev/null; then
      inhibitor_registered=true
      break
    fi
    sleep 0.05
  done
  if [[ "$inhibitor_registered" != true ]]; then
    sudo systemctl stop "$hardware_gate_awake_unit"
    hardware_gate_fail "logind did not register the Linux hardware gate awake inhibitor"
  fi
  printf '%s\n' "$inhibitor_list" >"$evidence_dir/environment/gate-inhibitor-prepared.txt"
}

hardware_gate_collect_cleanup() {
  if [[ -n "$hardware_gate_collect_cleanup_unit" ]] \
    && sudo systemctl is-active --quiet "$hardware_gate_collect_cleanup_unit"; then
    sudo systemctl stop "$hardware_gate_collect_cleanup_unit"
  fi
}

hardware_gate_stop_awake_inhibitor() {
  local evidence_dir="$1" unit="$2" inhibitor_list attempt
  [[ "$unit" == "$hardware_gate_awake_unit" ]] || \
    hardware_gate_fail "recorded Linux hardware gate awake unit is invalid: $unit"
  sudo systemctl is-active --quiet "$unit" || \
    hardware_gate_fail "prepared Linux hardware gate awake inhibitor is not active"
  inhibitor_list="$(COLUMNS=1000 systemd-inhibit --list --no-pager --no-legend)"
  grep -F 'SOS Linux hardware gate' <<<"$inhibitor_list" \
    | grep -F 'sleep:idle:handle-lid-switch' \
    | grep -F 'Prepared physical acceptance campaign' \
    | grep -F 'block' >"$evidence_dir/gate-inhibitor-before-release.txt" || \
    hardware_gate_fail "prepared Linux hardware gate awake inhibitor is not registered"
  sudo systemctl stop "$unit"
  for ((attempt = 1; attempt <= 20; attempt++)); do
    if ! sudo systemctl is-active --quiet "$unit"; then
      printf 'unit=%s\nstate=inactive\n' "$unit" \
        >"$evidence_dir/gate-inhibitor-release.txt"
      return 0
    fi
    sleep 0.05
  done
  hardware_gate_fail "Linux hardware gate awake inhibitor did not stop"
}

hardware_gate_metadata_value() {
  local file="$1" key="$2"
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

hardware_gate_monotonic_ns() {
  python3 -c 'import time; print(time.monotonic_ns())'
}

hardware_gate_resolve_new_dir() {
  local requested="$1" resolved
  resolved="$(realpath -m -- "$requested")"
  [[ "$resolved" != / && "$resolved" != "$hardware_gate_root" ]] || \
    hardware_gate_fail "unsafe evidence directory: $resolved"
  case "$resolved" in
    "$hardware_gate_root"/.cache/*|"$hardware_gate_root"/artifacts/*) ;;
    "$hardware_gate_root"/*) \
      hardware_gate_fail "evidence inside the worktree must be below ignored .cache/ or artifacts/" ;;
    *) ;;
  esac
  [[ ! -e "$resolved" ]] || hardware_gate_fail "evidence directory already exists: $resolved"
  mkdir -p -- "$resolved"
  chmod 0700 "$resolved"
  printf '%s\n' "$resolved"
}

hardware_gate_resolve_existing_dir() {
  local requested="$1" resolved
  resolved="$(realpath -e -- "$requested")"
  [[ -d "$resolved" && -O "$resolved" ]] || \
    hardware_gate_fail "evidence directory must exist and belong to the current user: $resolved"
  [[ "$resolved" != / && "$resolved" != "$hardware_gate_root" ]] || \
    hardware_gate_fail "unsafe evidence directory: $resolved"
  printf '%s\n' "$resolved"
}

hardware_gate_parse_dir_options() {
  hardware_gate_requested_dir=""
  hardware_gate_expected_product=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --evidence-dir)
        [[ "$#" -ge 2 ]] || hardware_gate_fail "--evidence-dir requires a path"
        hardware_gate_requested_dir="$2"
        shift 2
        ;;
      --expect-product)
        [[ "$#" -ge 2 ]] || hardware_gate_fail "--expect-product requires text"
        hardware_gate_expected_product="$2"
        shift 2
        ;;
      *) hardware_gate_fail "unexpected option: $1" ;;
    esac
  done
  [[ -n "$hardware_gate_requested_dir" ]] || hardware_gate_fail "--evidence-dir is required"
  [[ "$hardware_gate_requested_dir" != *$'\n'* && "$hardware_gate_requested_dir" != *$'\t'* ]] || \
    hardware_gate_fail "evidence directory contains a tab or newline"
  [[ "$hardware_gate_expected_product" != *$'\n'* && "$hardware_gate_expected_product" != *$'\t'* ]] || \
    hardware_gate_fail "expected product contains a tab or newline"
}

hardware_gate_capture_optional() {
  local output="$1"
  shift
  set +e
  "$@" >"$output" 2>&1
  local status=$?
  set -e
  printf '%s\n' "$status" >"$output.status"
}

hardware_gate_validate_output_config() {
  local path="$1"
  jq -e '
    type == "object"
    and ((keys - ["mode", "rotation", "scale", "layout", "input_outputs"]) | length == 0)
    and (.mode == null or (.mode | type == "string" and test("^[1-9][0-9]*x[1-9][0-9]*$")))
    and (.rotation == null or (.rotation == 0 or .rotation == 90 or .rotation == 180 or .rotation == 270))
    and (.scale == null or (.scale | type == "number" and . >= 1 and . <= 4))
    and (.layout == null or .layout == "mirror" or .layout == "extend")
    and (
      .input_outputs == null
      or (
        .input_outputs
        | type == "object"
          and length <= 32
          and all(
            to_entries[];
            (.key
              | utf8bytelength >= 1
                and utf8bytelength <= 128
                and (test("[[:cntrl:]]") | not))
            and (.value
              | type == "string"
                and utf8bytelength >= 1
                and utf8bytelength <= 128
                and (test("[[:cntrl:]]") | not))
          )
      )
    )
  ' "$path" >/dev/null
}

hardware_gate_sysroot_path() {
  local sysroot="$1" path="$2"
  printf '%s%s\n' "$sysroot" "$path"
}

hardware_gate_read_boot_id() {
  local sysroot="${1:-}" path boot_id
  path="$(hardware_gate_sysroot_path "$sysroot" /proc/sys/kernel/random/boot_id)"
  [[ -r "$path" ]] || hardware_gate_fail "kernel boot ID is unavailable: $path"
  boot_id="$(tr -d '\n' <"$path")"
  [[ "$boot_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || \
    hardware_gate_fail "kernel boot ID is malformed: $boot_id"
  printf '%s\n' "${boot_id,,}"
}

hardware_gate_has_live_overlay() {
  local sysroot="${1:-}" cmdline
  if [[ -n "$sysroot" ]]; then
    [[ -d "$(hardware_gate_sysroot_path "$sysroot" /run/initramfs/live)" ]] && return 0
    cmdline="$(hardware_gate_sysroot_path "$sysroot" /proc/cmdline)"
    [[ -r "$cmdline" ]] && grep -Eq 'rd\.live(\.|=|[[:space:]]|$)' "$cmdline" && return 0
    return 1
  fi
  [[ -d /run/initramfs/live ]] && return 0
  [[ -r /proc/cmdline ]] && grep -Eq 'rd\.live(\.|=|[[:space:]]|$)' /proc/cmdline && return 0
  return 1
}

hardware_gate_classify_boot() {
  local sysroot="${1:-}"
  local identity_file media_identity overlay=absent image_kind="" boot_id
  identity_file="$(hardware_gate_sysroot_path "$sysroot" "$hardware_gate_image_identity")"
  boot_id="$(hardware_gate_read_boot_id "$sysroot")"
  if [[ -z "$sysroot" && -d /run/initramfs/live ]]; then
    media_identity="/run/initramfs/live$hardware_gate_live_media_identity"
  else
    media_identity="$(hardware_gate_sysroot_path "$sysroot" "/run/initramfs/live$hardware_gate_live_media_identity")"
  fi
  if hardware_gate_has_live_overlay "$sysroot"; then
    overlay=present
  fi
  if [[ -r "$identity_file" ]]; then
    image_kind="$(hardware_gate_metadata_value "$identity_file" image_kind)"
  fi
  if [[ "$overlay" == present && "$image_kind" == development-live ]]; then
    [[ -r "$media_identity" ]] || \
      hardware_gate_fail "SOS live overlay is missing the ISO-level image identity: $media_identity"
    local inner_revision media_revision media_kind media_product_flag
    local media_promotion_eligible media_mutable_runtime media_ssh_enabled
    local payload_relpath payload_bytes payload_sha container_format
    inner_revision="$(hardware_gate_metadata_value "$identity_file" source_revision)"
    media_revision="$(hardware_gate_metadata_value "$media_identity" source_revision)"
    media_kind="$(hardware_gate_metadata_value "$media_identity" image_kind)"
    media_product_flag="$(hardware_gate_metadata_value "$media_identity" not_installed_product)"
    media_promotion_eligible="$(hardware_gate_metadata_value "$media_identity" promotion_eligible)"
    media_mutable_runtime="$(hardware_gate_metadata_value "$media_identity" mutable_runtime)"
    media_ssh_enabled="$(hardware_gate_metadata_value "$media_identity" ssh_enabled)"
    payload_relpath="$(hardware_gate_metadata_value "$media_identity" payload_relpath)"
    payload_bytes="$(hardware_gate_metadata_value "$media_identity" payload_bytes)"
    payload_sha="$(hardware_gate_metadata_value "$media_identity" payload_sha256)"
    container_format="$(hardware_gate_metadata_value "$media_identity" container_format)"
    [[ -n "$inner_revision" && "$inner_revision" == "$media_revision" ]] || \
      hardware_gate_fail "rootfs and ISO-level image identities disagree"
    local identity_key inner_value media_value
    for identity_key in \
      image_kind campaign_class not_installed_product promotion_eligible \
      mutable_runtime ssh_enabled container_format \
      fedora_release build_host_release source_revision source_dirty agent_mode \
      base_iso_filename base_iso_bytes base_iso_sha256 payload_relpath baked_at_utc; do
      inner_value="$(hardware_gate_metadata_value "$identity_file" "$identity_key")"
      media_value="$(hardware_gate_metadata_value "$media_identity" "$identity_key")"
      [[ -n "$inner_value" && "$inner_value" == "$media_value" ]] || \
        hardware_gate_fail "rootfs and ISO-level image identities disagree on $identity_key"
    done
    [[ "$media_kind" == development-live && "$media_product_flag" == true \
      && "$media_promotion_eligible" == false && "$media_mutable_runtime" == true \
      && "$media_ssh_enabled" == true ]] || \
      hardware_gate_fail "ISO-level identity is not a mutable, non-promotable development-live image"
    [[ "$payload_relpath" == LiveOS/squashfs.img ]] || \
      hardware_gate_fail "unsupported or unsafe live payload path: $payload_relpath"
    [[ "$container_format" == erofs-rootfs ]] || \
      hardware_gate_fail "unsupported live payload format: $container_format"
    [[ "$payload_bytes" =~ ^[1-9][0-9]*$ ]] || \
      hardware_gate_fail "ISO-level identity has an invalid payload size"
    [[ "$payload_sha" =~ ^[0-9a-f]{64}$ ]] || \
      hardware_gate_fail "ISO-level identity has an invalid payload SHA-256"
    printf '%s\n' \
      'boot_kind=development-live' \
      'campaign_class=development-live' \
      'not_installed_product=true' \
      'promotion_eligible=false' \
      'mutable_runtime=true' \
      "boot_id=$boot_id" \
      "live_overlay=$overlay" \
      "image_kind=$image_kind" \
      "image_identity=$identity_file" \
      "live_media_identity=$media_identity"
    return 0
  fi
  if [[ "$overlay" == present ]]; then
    hardware_gate_fail "live overlay without SOS image-identity (stock live media is not a development image)"
  fi
  if [[ "$image_kind" == development-live ]]; then
    hardware_gate_fail "image-identity is development-live but this boot is not a live overlay; do not collect it as development-live or an installed product"
  fi
  printf '%s\n' \
    'boot_kind=installed' \
    'campaign_class=installed-workstation' \
    'not_installed_product=false' \
    'promotion_eligible=false' \
    "boot_id=$boot_id" \
    "live_overlay=$overlay" \
    'image_kind='
}

hardware_gate_verify_installed_files() {
  local output="$1" path expected_bytes expected_sha actual_bytes actual_sha count=0
  : >"$output"
  while IFS=$'\t' read -r path expected_bytes expected_sha; do
    [[ -n "$path" && -n "$expected_bytes" && -n "$expected_sha" ]] || \
      hardware_gate_fail "malformed installed artifact manifest"
    case "$path" in
      /usr/local/libexec/sos/*|\
      /usr/local/libexec/sos-agent/*|\
      /usr/local/lib/systemd/user/sos-session.target|\
      /usr/local/lib/systemd/user/sos-session-shutdown.target|\
      /usr/share/wayland-sessions/sos.desktop|\
      /usr/share/sos/*) ;;
      *) hardware_gate_fail "unsafe installed artifact path: $path" ;;
    esac
    [[ -f "$path" ]] || hardware_gate_fail "installed artifact is missing: $path"
    actual_bytes="$(stat -c %s "$path")"
    actual_sha="$(sha256sum "$path" | cut -d ' ' -f 1)"
    [[ "$actual_bytes" == "$expected_bytes" && "$actual_sha" == "$expected_sha" ]] || \
      hardware_gate_fail "installed artifact identity mismatch: $path"
    printf '%s\t%s\t%s\n' "$path" "$actual_bytes" "$actual_sha" >>"$output"
    count=$((count + 1))
  done <"$hardware_gate_install_manifest"
  [[ "$count" -gt 0 ]] || hardware_gate_fail "installed artifact manifest is empty"
  printf 'installed_artifacts_verified=PASS files=%s\n' "$count" >>"$output"
}

hardware_gate_snapshot_development_files() {
  local output="$1" path expected_bytes expected_sha actual_bytes actual_sha count=0 status
  : >"$output"
  while IFS=$'\t' read -r path expected_bytes expected_sha; do
    [[ -n "$path" && -n "$expected_bytes" && -n "$expected_sha" ]] || \
      hardware_gate_fail "malformed baked artifact manifest"
    case "$path" in
      /usr/local/libexec/sos/*|\
      /usr/local/libexec/sos-agent/*|\
      /usr/local/lib/systemd/user/sos-session.target|\
      /usr/local/lib/systemd/user/sos-session-shutdown.target|\
      /usr/share/wayland-sessions/sos.desktop|\
      /usr/share/sos/*) ;;
      *) hardware_gate_fail "unsafe baked artifact path: $path" ;;
    esac
    [[ -f "$path" ]] || hardware_gate_fail "development artifact is missing: $path"
    actual_bytes="$(stat -c %s "$path")"
    actual_sha="$(sha256sum "$path" | cut -d ' ' -f 1)"
    status=modified
    if [[ "$actual_bytes" == "$expected_bytes" && "$actual_sha" == "$expected_sha" ]]; then
      status=baked
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$path" "$actual_bytes" "$actual_sha" "$status" "$expected_bytes" "$expected_sha" \
      >>"$output"
    count=$((count + 1))
  done <"$hardware_gate_install_manifest"
  [[ "$count" -gt 0 ]] || hardware_gate_fail "baked artifact manifest is empty"
  printf 'development_artifacts_snapshotted=PASS files=%s promotion_eligible=false\n' \
    "$count" >>"$output"
}

hardware_gate_verify_development_deployment() {
  local evidence_dir="$1"
  [[ -e "$hardware_gate_development_metadata" \
    || -e "$hardware_gate_development_manifest" ]] || return 0
  [[ -r "$hardware_gate_development_metadata" \
    && -r "$hardware_gate_development_manifest" ]] || \
    hardware_gate_fail "development deployment metadata and manifest must be present together"
  local source_revision source_dirty
  local path expected_bytes expected_sha count=0
  source_revision="$(hardware_gate_metadata_value "$hardware_gate_development_metadata" source_revision)"
  source_dirty="$(hardware_gate_metadata_value "$hardware_gate_development_metadata" source_dirty)"
  [[ "$source_revision" =~ ^[0-9a-f]{40}$ && "$source_dirty" =~ ^(true|false)$ ]] || \
    hardware_gate_fail "development deployment source identity is invalid"
  while IFS=$'\t' read -r path expected_bytes expected_sha; do
    case "$path" in
      /usr/local/libexec/sos/sos-compositor|\
      /usr/local/libexec/sos/sos-experience-host|\
      /usr/local/libexec/sos/sos-provider-state-service|\
      /usr/local/libexec/sos/sos-revision-supervisor|\
      /usr/local/libexec/sos/sos-linux-session|\
      /usr/local/libexec/sos/sos-agent-authoring|\
      /usr/local/libexec/sos/sos-linux-provider-probe|\
      /usr/local/libexec/sos/sos-login-session|\
      /usr/local/libexec/sos/sos-agent-login|\
      /usr/local/libexec/sos-agent/dist/agent-runner.cjs|\
      /usr/local/lib/systemd/user/sos-session.target|\
      /usr/local/lib/systemd/user/sos-session-shutdown.target|\
      /usr/local/libexec/sos/linux-hardware-gate|\
      /usr/share/sos/experiences/default.luau|\
      /usr/share/sos/experiences/default.package.json|\
      /usr/share/sos/experiences/modules/stock-theme.luau|\
      /usr/share/doc/sos/experience-api.md|\
      /usr/share/doc/sos/sos-agent.md|\
      /usr/share/doc/sos/linux-stable-host.md|\
      /etc/xdg/monitors.xml) ;;
      *) hardware_gate_fail "unsafe development deployment path: $path" ;;
    esac
    [[ "$expected_bytes" =~ ^[1-9][0-9]*$ && "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || \
      hardware_gate_fail "invalid development deployment identity: $path"
    [[ -f "$path" && "$(stat -c %s "$path")" == "$expected_bytes" \
      && "$(sha256sum "$path" | cut -d ' ' -f 1)" == "$expected_sha" ]] || \
      hardware_gate_fail "development deployment no longer matches: $path"
    count=$((count + 1))
  done <"$hardware_gate_development_manifest"
  [[ "$count" -gt 0 ]] || hardware_gate_fail "development deployment manifest is empty"
  cp -- "$hardware_gate_development_metadata" \
    "$evidence_dir/installed/development-deployment.env"
  cp -- "$hardware_gate_development_manifest" \
    "$evidence_dir/installed/development-deployment-manifest.tsv"
}

hardware_gate_capture_drm() {
  local output="$1" status connector edid
  : >"$output"
  for status in /sys/class/drm/card*-*/status; do
    [[ -f "$status" ]] || continue
    connector="${status%/status}"
    printf 'connector=%s status=%s\n' \
      "$(basename "$connector")" "$(tr -d '\n' <"$status")" >>"$output"
    if [[ -r "$connector/modes" ]]; then
      sed 's/^/mode=/' "$connector/modes" >>"$output"
    fi
    edid="$connector/edid"
    if [[ -s "$edid" ]]; then
      printf 'edid_bytes=%s edid_sha256=%s\n' \
        "$(stat -c %s "$edid")" "$(sha256sum "$edid" | cut -d ' ' -f 1)" >>"$output"
    fi
  done
  [[ -s "$output" ]] || hardware_gate_fail "no DRM connector state is available"
}

hardware_gate_prepare() {
  hardware_gate_parse_dir_options "$@"
  for command in cut journalctl jq libinput lscpu lspci loginctl python3 readlink realpath \
    sed sha256sum stat sudo systemctl systemd-detect-virt systemd-inhibit systemd-run tr uname; do
    hardware_gate_require_command "$command"
  done
  [[ "$(id -u)" -ne 0 ]] || hardware_gate_fail "run the physical gate as the desktop user, not root"
  if systemd-detect-virt --quiet; then
    hardware_gate_fail "the physical Linux gate refuses virtual machines"
  fi
  local boot_class
  boot_class="$(hardware_gate_classify_boot)"
  local boot_kind campaign_class not_installed_product boot_id
  boot_kind="$(printf '%s\n' "$boot_class" | sed -n 's/^boot_kind=//p' | tail -n 1)"
  campaign_class="$(printf '%s\n' "$boot_class" | sed -n 's/^campaign_class=//p' | tail -n 1)"
  not_installed_product="$(printf '%s\n' "$boot_class" | sed -n 's/^not_installed_product=//p' | tail -n 1)"
  boot_id="$(printf '%s\n' "$boot_class" | sed -n 's/^boot_id=//p' | tail -n 1)"
  if [[ "$boot_kind" == installed ]]; then
    for command in cargo git node npm pkg-config rustc; do
      hardware_gate_require_command "$command"
    done
  fi
  [[ "${XDG_CURRENT_DESKTOP:-}" != SOS ]] || \
    hardware_gate_fail "prepare the gate from the fallback desktop or a text login"
  systemctl is-active --quiet display-manager || \
    hardware_gate_fail "the display manager is not active"
  local display_manager_unit
  display_manager_unit="$(readlink -f /etc/systemd/system/display-manager.service)"
  case "$(basename "$display_manager_unit")" in
    gdm.service|gdm3.service) ;;
    *) hardware_gate_fail "the first physical gate requires GDM, found $display_manager_unit" ;;
  esac
  [[ -f "$hardware_gate_session_entry" ]] || hardware_gate_fail "SOS GDM session is not installed"
  [[ -r "$hardware_gate_install_metadata" && -r "$hardware_gate_install_manifest" ]] || \
    hardware_gate_fail "SOS install metadata is missing; reinstall with the current installer"

  local source_revision source_dirty installed_revision installed_dirty installed_mode product evidence_dir
  installed_revision="$(hardware_gate_metadata_value "$hardware_gate_install_metadata" source_revision)"
  installed_dirty="$(hardware_gate_metadata_value "$hardware_gate_install_metadata" source_dirty)"
  installed_mode="$(hardware_gate_metadata_value "$hardware_gate_install_metadata" agent_mode)"
  [[ "$installed_dirty" == false ]] || \
    hardware_gate_fail "installed binaries came from a dirty source tree"
  [[ "$installed_mode" == offline || "$installed_mode" == live ]] || \
    hardware_gate_fail "installed agent mode is invalid: $installed_mode"
  source_dirty=false
  if [[ "$boot_kind" == development-live ]]; then
    [[ "$installed_mode" == offline ]] || \
      hardware_gate_fail "development-live requires the baked offline agent"
    local image_revision
    image_revision="$(hardware_gate_metadata_value "$hardware_gate_image_identity" source_revision)"
    [[ -n "$image_revision" && "$image_revision" == "$installed_revision" ]] || \
      hardware_gate_fail "development-live image revision $image_revision does not match its baked install $installed_revision"
    source_revision="$image_revision"
    if [[ -r "$hardware_gate_development_metadata" ]]; then
      source_revision="$(hardware_gate_metadata_value "$hardware_gate_development_metadata" source_revision)"
      source_dirty="$(hardware_gate_metadata_value "$hardware_gate_development_metadata" source_dirty)"
    fi
  else
    cd "$hardware_gate_root"
    [[ -z "$(git status --porcelain --untracked-files=normal)" ]] || \
      hardware_gate_fail "physical acceptance requires a clean source worktree"
    source_revision="$(git rev-parse HEAD)"
    [[ "$installed_revision" == "$source_revision" ]] || \
      hardware_gate_fail "installed revision $installed_revision does not match source $source_revision"
  fi
  local agent_config="$hardware_gate_state_home/sos/agent/config.env"
  [[ -s "$agent_config" ]] || hardware_gate_fail "selectable-session agent config is missing"
  if [[ "$installed_mode" == offline ]]; then
    local fake_source
    fake_source="$(sed -n 's/^SOS_AGENT_FAKE_SOURCE=//p' "$agent_config" | tail -n 1)"
    [[ "$fake_source" == /usr/share/sos/experiences/default.luau && -r "$fake_source" ]] || \
      hardware_gate_fail "physical gate requires the installed Stock offline source"
  else
    [[ -s "$hardware_gate_state_home/sos/agent/auth.json" ]] || \
      hardware_gate_fail "live selectable-session credentials are missing"
  fi

  product="$(tr -d '\n' </sys/class/dmi/id/product_name 2>/dev/null || true)"
  if [[ -n "$hardware_gate_expected_product" ]]; then
    [[ "${product,,}" == *"${hardware_gate_expected_product,,}"* ]] || \
      hardware_gate_fail "target product '$product' does not contain '$hardware_gate_expected_product'"
  fi

  evidence_dir="$(hardware_gate_resolve_new_dir "$hardware_gate_requested_dir")"
  mkdir -m 0700 "$evidence_dir/environment" "$evidence_dir/installed"
  cp -- "$hardware_gate_install_metadata" "$evidence_dir/installed/install-metadata.env"
  cp -- "$hardware_gate_install_manifest" "$evidence_dir/installed/install-manifest.tsv"
  printf '%s\n' "$boot_class" >"$evidence_dir/environment/boot-kind.txt"
  if [[ -r "$hardware_gate_image_identity" ]]; then
    cp -- "$hardware_gate_image_identity" "$evidence_dir/installed/image-identity.env"
  fi
  if [[ "$boot_kind" == development-live ]]; then
    local live_media=/run/initramfs/live payload_relpath payload_path
    local actual_payload_bytes actual_payload_sha expected_payload_bytes expected_payload_sha
    [[ -d "$live_media" && -r "$live_media$hardware_gate_live_media_identity" ]] || \
      hardware_gate_fail "mounted live media identity is unavailable"
    cp -- "$live_media$hardware_gate_live_media_identity" \
      "$evidence_dir/installed/live-media-identity.env"
    payload_relpath="$(hardware_gate_metadata_value "$live_media$hardware_gate_live_media_identity" payload_relpath)"
    [[ "$payload_relpath" == LiveOS/squashfs.img ]] || \
      hardware_gate_fail "unsupported or unsafe live payload path: $payload_relpath"
    payload_path="$live_media/$payload_relpath"
    [[ -f "$payload_path" ]] || hardware_gate_fail "booted live payload is unavailable: $payload_path"
    actual_payload_bytes="$(stat -c %s "$payload_path")"
    actual_payload_sha="$(sha256sum "$payload_path" | cut -d ' ' -f 1)"
    expected_payload_bytes="$(hardware_gate_metadata_value "$live_media$hardware_gate_live_media_identity" payload_bytes)"
    expected_payload_sha="$(hardware_gate_metadata_value "$live_media$hardware_gate_live_media_identity" payload_sha256)"
    [[ "$actual_payload_bytes" == "$expected_payload_bytes" \
      && "$actual_payload_sha" == "$expected_payload_sha" ]] || \
      hardware_gate_fail "booted live payload identity does not match the baked image"
    printf '%s\n' \
      "payload_relpath=$payload_relpath" \
      "payload_bytes=$actual_payload_bytes" \
      "payload_sha256=$actual_payload_sha" \
      "payload_identity_match=PASS" >"$evidence_dir/installed/live-payload.txt"
  fi
  if [[ "$boot_kind" == development-live ]]; then
    hardware_gate_verify_development_deployment "$evidence_dir"
    hardware_gate_snapshot_development_files \
      "$evidence_dir/installed/current-artifacts.tsv"
  else
    hardware_gate_verify_installed_files "$evidence_dir/installed/verified-artifacts.tsv"
  fi
  [[ -f "$hardware_gate_state_home/sos/output.json" \
    && ! -L "$hardware_gate_state_home/sos/output.json" \
    && -O "$hardware_gate_state_home/sos/output.json" \
    && -r "$hardware_gate_state_home/sos/output.json" ]] || \
    hardware_gate_fail "selectable-session output configuration is missing"
  hardware_gate_validate_output_config \
    "$hardware_gate_state_home/sos/output.json" || \
    hardware_gate_fail "selectable-session output configuration is invalid"
  cp -- "$hardware_gate_state_home/sos/output.json" "$evidence_dir/environment/output.json"

  cp -- /etc/os-release "$evidence_dir/environment/os-release.txt"
  uname -a >"$evidence_dir/environment/uname.txt"
  lscpu >"$evidence_dir/environment/lscpu.txt"
  lspci -nnk >"$evidence_dir/environment/lspci-nnk.txt" 2>&1
  {
    for dmi_name in sys_vendor product_name product_version board_name bios_version bios_date; do
      if [[ -r "/sys/class/dmi/id/$dmi_name" ]]; then
        printf '%s=%s\n' "$dmi_name" "$(tr -d '\n' <"/sys/class/dmi/id/$dmi_name")"
      fi
    done
  } >"$evidence_dir/environment/dmi.txt"
  hardware_gate_capture_drm "$evidence_dir/environment/drm-connectors.txt"
  # The redirect intentionally runs as the evidence owner; only device access needs sudo.
  # shellcheck disable=SC2024
  sudo libinput list-devices >"$evidence_dir/environment/libinput.txt"
  hardware_gate_capture_optional "$evidence_dir/environment/loginctl-before.txt" loginctl list-sessions
  hardware_gate_capture_optional "$evidence_dir/environment/display-manager-before.txt" \
    systemctl status display-manager --no-pager
  printf '%s\n' "$display_manager_unit" >"$evidence_dir/environment/display-manager-unit.txt"
  if [[ "$boot_kind" == development-live ]]; then
    {
      printf 'boot_kind=development-live\n'
      printf 'not_installed_product=true\n'
      printf 'promotion_eligible=false\n'
      printf 'mutable_runtime=true\n'
      printf 'rustc_version=%s\n' \
        "$(hardware_gate_metadata_value "$hardware_gate_install_metadata" rustc_version)"
      printf 'node_version=%s\n' \
        "$(hardware_gate_metadata_value "$hardware_gate_install_metadata" node_version)"
    } >"$evidence_dir/environment/tool-versions.txt"
  else
    {
      printf 'rustc=%s\n' "$(rustc --version)"
      printf 'cargo=%s\n' "$(cargo --version)"
      printf 'node=%s\n' "$(node --version)"
      printf 'npm=%s\n' "$(npm --version)"
      for module in gbm libinput libseat libudev wayland-client xkbcommon xkbcommon-x11; do
        printf '%s=%s\n' "$module" "$(pkg-config --modversion "$module")"
      done
    } >"$evidence_dir/environment/tool-versions.txt"
  fi

  local boot_id cursor started_ns
  cursor="$(sudo journalctl --show-cursor -n 0 --no-pager | sed -n 's/^-- cursor: //p' | tail -n 1)"
  [[ -n "$cursor" ]] || hardware_gate_fail "could not capture the journal cursor"
  boot_id="$(hardware_gate_read_boot_id)"
  started_ns="$(hardware_gate_monotonic_ns)"
  printf '%s\n' \
    "source_revision=$source_revision" \
    "source_dirty=$source_dirty" \
    "agent_mode=$installed_mode" \
    "boot_id=$boot_id" \
    "boot_kind=$boot_kind" \
    "campaign_class=$campaign_class" \
    "not_installed_product=$not_installed_product" \
    'promotion_eligible=false' \
    "gate_inhibitor_unit=$hardware_gate_awake_unit" \
    "user_uid=$(id -u)" \
    "state_home=$hardware_gate_state_home" \
    "product_name=$product" \
    "expected_product=$hardware_gate_expected_product" \
    "started_at_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "started_monotonic_ns=$started_ns" >"$evidence_dir/campaign.env"
  printf '%s\n' "$cursor" >"$evidence_dir/journal.cursor"
  local collect_command='./tools/linux-hardware-gate collect'
  if [[ "$boot_kind" == development-live ]]; then
    collect_command='/usr/local/libexec/sos/linux-hardware-gate collect'
  fi
  printf '%s\n' \
    '1. Log out and select SOS from the GDM session menu.' \
    '2. Confirm the recovery view and generated experience appear.' \
    '3. Exercise keyboard, touchpad motion/button, and the touchscreen.' \
    '4. Enter one composer prompt and wait for the offline/live revision to activate.' \
    '5. Press Ctrl+Alt+Backspace, return to GDM, and log into the fallback desktop.' \
    "6. Run: $collect_command --evidence-dir $evidence_dir" \
    >"$evidence_dir/instructions.txt"
  if [[ "$boot_kind" == development-live ]]; then
    printf '%s\n' \
      'This is mutable development-live diagnostic evidence, not release acceptance.' \
      'Its verdict is never promotion eligible, even when every criterion passes.' \
      'Collect on this same boot and copy the evidence directory off before reboot.' \
      >>"$evidence_dir/instructions.txt"
  fi
  hardware_gate_start_awake_inhibitor "$evidence_dir"
  touch "$evidence_dir/prepared"
  printf 'linux_hardware_gate_prepared evidence_dir=%s revision=%s product=%s agent_mode=%s boot_kind=%s\n' \
    "$evidence_dir" "$source_revision" "$product" "$installed_mode" "$boot_kind"
  sed -n '1,6p' "$evidence_dir/instructions.txt"
}

hardware_gate_criterion_pattern() {
  local name="$1" pattern="$2" file="$3"
  if grep -Eq "$pattern" "$file"; then
    printf 'criterion=%s result=PASS\n' "$name"
  else
    printf 'criterion=%s result=FAIL\n' "$name"
    hardware_gate_audit_failed=true
  fi
}

hardware_gate_criterion_absent() {
  local name="$1" pattern="$2" file="$3"
  if grep -Eiq "$pattern" "$file"; then
    printf 'criterion=%s result=FAIL\n' "$name"
    hardware_gate_audit_failed=true
  else
    printf 'criterion=%s result=PASS\n' "$name"
  fi
}

hardware_gate_audit_dir() {
  local evidence_dir="$1"
  local journal="$evidence_dir/journal-user.txt"
  [[ -f "$evidence_dir/campaign.env" && -f "$evidence_dir/collection.env" \
    && -f "$journal" && -f "$evidence_dir/environment/libinput.txt" ]] || \
    hardware_gate_fail "campaign, collection, input inventory, or collected session journal is missing"
  hardware_gate_audit_failed=false
  local agent_mode current_revision authority_revision presentation_count presentation_revisions
  local boot_kind campaign_class prepared_boot_id collected_boot_id
  agent_mode="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" agent_mode)"
  boot_kind="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" boot_kind)"
  campaign_class="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" campaign_class)"
  prepared_boot_id="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" boot_id)"
  collected_boot_id="$(hardware_gate_metadata_value "$evidence_dir/collection.env" boot_id)"
  if [[ "$prepared_boot_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ \
    && "$prepared_boot_id" == "$collected_boot_id" ]]; then
    printf 'criterion=same_boot result=PASS boot_id=%s\n' "$prepared_boot_id"
  else
    printf 'criterion=same_boot result=FAIL prepared=%s collected=%s\n' \
      "$prepared_boot_id" "$collected_boot_id"
    hardware_gate_audit_failed=true
  fi
  if [[ -n "$boot_kind" ]]; then
    printf 'boot_kind=%s campaign_class=%s\n' "$boot_kind" "${campaign_class:-$boot_kind}"
    if [[ "$boot_kind" == development-live ]]; then
      printf 'not_installed_product=true\n'
      printf 'promotion_eligible=false\n'
    fi
  fi
  hardware_gate_criterion_pattern recovery_page_flip \
    'completed significant DRM page flip.*recovery_view=true' "$journal"
  hardware_gate_criterion_pattern direct_compositor \
    'sos_compositor_ready .*backend=drm.*evidence=drm_page_flip' "$journal"
  hardware_gate_criterion_pattern session_ready \
    'linux_system_session_ready .*evidence=drm_page_flip' "$journal"
  hardware_gate_criterion_pattern agent_mode \
    "sos_login_agent_mode mode=${agent_mode}" "$journal"
  hardware_gate_criterion_pattern agent_started \
    'sos_login_agent_started pid=[0-9]+ socket=' "$journal"
  hardware_gate_criterion_pattern keyboard_input \
    'observed native compositor input input_class="keyboard"' "$journal"
  hardware_gate_criterion_pattern touchpad_motion \
    'observed native compositor input input_class="relative_pointer"' "$journal"
  hardware_gate_criterion_pattern touchpad_button \
    'observed native compositor input input_class="pointer_button"' "$journal"
  hardware_gate_criterion_pattern touchscreen_input \
    'observed native compositor input input_class="touch"' "$journal"
  local input_inventory unexpected_input_devices unexpected_input_count
  input_inventory="$(sed -n 's/^Device:[[:space:]]*//p' \
    "$evidence_dir/environment/libinput.txt")"
  unexpected_input_devices="$({
    sed -n 's/.*libinput device added .*device_name="\([^"]*\)".*/\1/p' "$journal" \
      | LC_ALL=C sort -u \
      | while IFS= read -r device_name; do
          if ! grep -Fxq -- "$device_name" <<<"$input_inventory"; then
            printf '%s\n' "$device_name"
          fi
        done
  })"
  unexpected_input_count="$(sed '/^$/d' <<<"$unexpected_input_devices" | wc -l)"
  if [[ -n "$input_inventory" && "$unexpected_input_count" -eq 0 ]]; then
    printf 'criterion=input_device_inventory result=PASS\n'
  else
    printf 'criterion=input_device_inventory result=FAIL unexpected_devices=%s\n' \
      "$unexpected_input_count"
    hardware_gate_audit_failed=true
  fi
  hardware_gate_criterion_pattern clean_logout \
    'linux_login_session_stopped reason=user_logout' "$journal"

  local inhibitor_prepared="$evidence_dir/environment/gate-inhibitor-prepared.txt"
  local inhibitor_before_release="$evidence_dir/gate-inhibitor-before-release.txt"
  local inhibitor_release="$evidence_dir/gate-inhibitor-release.txt"
  if [[ -f "$inhibitor_prepared" && -f "$inhibitor_before_release" \
    && -f "$inhibitor_release" ]] \
    && grep -F 'SOS Linux hardware gate' "$inhibitor_prepared" \
      | grep -F 'sleep:idle:handle-lid-switch' \
      | grep -F 'Prepared physical acceptance campaign' \
      | grep -F 'block' >/dev/null \
    && grep -F 'SOS Linux hardware gate' "$inhibitor_before_release" \
      | grep -F 'sleep:idle:handle-lid-switch' \
      | grep -F 'Prepared physical acceptance campaign' \
      | grep -F 'block' >/dev/null \
    && grep -Fx "unit=$hardware_gate_awake_unit" "$inhibitor_release" >/dev/null \
    && grep -Fx 'state=inactive' "$inhibitor_release" >/dev/null; then
    printf 'criterion=gate_awake_inhibitor result=PASS\n'
  else
    printf 'criterion=gate_awake_inhibitor result=FAIL\n'
    hardware_gate_audit_failed=true
  fi

  presentation_count="$(grep -c 'presented armed shell revision.*evidence="drm_page_flip"' "$journal" || true)"
  presentation_revisions="$(
    sed -n 's/.*presented armed shell revision.*revision_id="\([0-9a-f]*\)".*/\1/p' "$journal" \
      | sort -u | sed '/^$/d' | wc -l
  )"
  if [[ "$presentation_count" -ge 2 && "$presentation_revisions" -ge 2 ]]; then
    printf 'criterion=transactional_activation result=PASS presentations=%s revisions=%s\n' \
      "$presentation_count" "$presentation_revisions"
  else
    printf 'criterion=transactional_activation result=FAIL presentations=%s revisions=%s\n' \
      "$presentation_count" "$presentation_revisions"
    hardware_gate_audit_failed=true
  fi

  local shell_host_pids application_host_pids
  shell_host_pids="$({
    sed -n 's/.*authenticated SOS compositor control connection pid=\([0-9][0-9]*\) role=Shell.*/\1/p' \
      "$journal"
  } | sort -u | sed '/^$/d' | wc -l)"
  application_host_pids="$({
    sed -n 's/.*authenticated SOS compositor control connection pid=\([0-9][0-9]*\) role=NativeApplication.*/\1/p' \
      "$journal"
  } | sort -u | sed '/^$/d' | wc -l)"
  if [[ "$shell_host_pids" -eq 1 ]]; then
    printf 'criterion=stable_host_lifecycle result=PASS shell_host_pids=1 application_host_pids=%s\n' \
      "$application_host_pids"
  else
    printf 'criterion=stable_host_lifecycle result=FAIL shell_host_pids=%s application_host_pids=%s\n' \
      "$shell_host_pids" "$application_host_pids"
    hardware_gate_audit_failed=true
  fi

  current_revision="$(tr -d '\n' <"$evidence_dir/stock-registry-revision.txt")"
  authority_revision="$(tr -d '\n' <"$evidence_dir/stock-authority-revision.txt")"
  if [[ -n "$current_revision" && "$current_revision" == "$authority_revision" ]]; then
    printf 'criterion=durable_authority result=PASS revision_id=%s\n' "$current_revision"
  else
    printf 'criterion=durable_authority result=FAIL current=%s authority=%s\n' \
      "$current_revision" "$authority_revision"
    hardware_gate_audit_failed=true
  fi
  if [[ "$(tr -d '\n' <"$evidence_dir/display-manager-active.txt")" == active ]]; then
    printf 'criterion=fallback_display_manager result=PASS\n'
  else
    printf 'criterion=fallback_display_manager result=FAIL\n'
    hardware_gate_audit_failed=true
  fi
  hardware_gate_criterion_absent sos_process_failures \
    'sos_login_session_failed|linux_session_failed|panicked at|fatal runtime error' "$journal"
  hardware_gate_criterion_absent kernel_gpu_faults \
    'GPU HANG|drm.*(ERROR|FAULT)|i915.*(reset|hang)|xe.*(reset|hang)' \
    "$evidence_dir/journal-kernel.txt"
  if [[ "$hardware_gate_audit_failed" == true ]]; then
    if [[ "$boot_kind" == development-live ]]; then
      printf 'linux_hardware_gate_result=DIAGNOSTIC_FAIL promotion_eligible=false\n'
    else
      printf 'linux_hardware_gate_result=FAIL\n'
    fi
    return 1
  fi
  if [[ "$boot_kind" == development-live ]]; then
    printf 'linux_hardware_gate_result=DIAGNOSTIC_PASS promotion_eligible=false evidence=drm_page_flip physical_input=keyboard,touchpad,touchscreen\n'
    return 0
  fi
  printf 'linux_hardware_gate_result=PASS evidence=drm_page_flip physical_input=keyboard,touchpad,touchscreen\n'
}

hardware_gate_generate_manifest() {
  local evidence_dir="$1"
  local manifest="$evidence_dir/evidence-manifest.tsv"
  local temporary="$evidence_dir/.evidence-manifest.tsv.$$" path relative before after bytes digest
  : >"$temporary"
  while IFS= read -r -d '' path; do
    [[ "$path" != "$manifest" && "$path" != "$temporary" ]] || continue
    relative="${path#"$evidence_dir"/}"
    [[ "$relative" != *$'\t'* && "$relative" != *$'\n'* ]] || \
      hardware_gate_fail "evidence path contains a tab or newline"
    before="$(stat -c '%s:%Y' "$path")"
    bytes="$(stat -c %s "$path")"
    digest="$(sha256sum "$path" | cut -d ' ' -f 1)"
    after="$(stat -c '%s:%Y' "$path")"
    [[ "$before" == "$after" ]] || hardware_gate_fail "evidence changed while hashing: $relative"
    printf '%s\t%s\t%s\n' "$relative" "$bytes" "$digest" >>"$temporary"
  done < <(find "$evidence_dir" -type f ! -name '.evidence-manifest.tsv.*' -print0 \
    | LC_ALL=C sort -z)
  [[ -s "$temporary" ]] || hardware_gate_fail "evidence directory contains no finalized files"
  mv -- "$temporary" "$manifest"
}

hardware_gate_verify_manifest_dir() {
  local evidence_dir="$1"
  local manifest="$evidence_dir/evidence-manifest.tsv"
  [[ -f "$manifest" ]] || hardware_gate_fail "evidence manifest is missing"
  local path bytes digest absolute count=0
  diff -u \
    <(cut -f 1 "$manifest") \
    <(find "$evidence_dir" -type f ! -name evidence-manifest.tsv \
      ! -name '.evidence-manifest.tsv.*' -printf '%P\n' | LC_ALL=C sort) >/dev/null || \
    hardware_gate_fail "evidence manifest paths are missing, extra, or unsorted"
  while IFS=$'\t' read -r path bytes digest; do
    [[ -n "$path" && "$path" != /* && "$path" != *'..'* ]] || \
      hardware_gate_fail "unsafe manifested evidence path: $path"
    absolute="$evidence_dir/$path"
    [[ -f "$absolute" ]] || hardware_gate_fail "manifested evidence is missing: $path"
    [[ "$(stat -c %s "$absolute")" == "$bytes" ]] || \
      hardware_gate_fail "manifested evidence size changed: $path"
    [[ "$(sha256sum "$absolute" | cut -d ' ' -f 1)" == "$digest" ]] || \
      hardware_gate_fail "manifested evidence digest changed: $path"
    count=$((count + 1))
  done <"$manifest"
  [[ "$count" -gt 0 ]] || hardware_gate_fail "evidence manifest is empty"
  printf 'evidence_manifest_verified=PASS files=%s manifest=%s bytes=%s sha256=%s\n' \
    "$count" "$manifest" "$(stat -c %s "$manifest")" \
    "$(sha256sum "$manifest" | cut -d ' ' -f 1)"
}

hardware_gate_collect() {
  hardware_gate_parse_dir_options "$@"
  [[ -z "$hardware_gate_expected_product" ]] || \
    hardware_gate_fail "--expect-product is accepted only by prepare"
  for command in cut diff find journalctl jq loginctl python3 realpath sed sha256sum sort stat \
    sudo systemctl systemd-inhibit tr; do
    hardware_gate_require_command "$command"
  done
  [[ "${XDG_CURRENT_DESKTOP:-}" != SOS ]] || \
    hardware_gate_fail "return to the fallback desktop before collecting evidence"
  local evidence_dir cursor user_uid state_home started_ns finished_ns duration_ns
  local gate_inhibitor_unit
  local prepared_boot_kind current_boot_kind prepared_boot_id current_boot_id
  evidence_dir="$(hardware_gate_resolve_existing_dir "$hardware_gate_requested_dir")"
  [[ -f "$evidence_dir/prepared" ]] || hardware_gate_fail "campaign was not prepared"
  [[ ! -f "$evidence_dir/collected" ]] || hardware_gate_fail "campaign was already collected"
  cursor="$(tr -d '\n' <"$evidence_dir/journal.cursor")"
  user_uid="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" user_uid)"
  state_home="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" state_home)"
  [[ "$user_uid" == "$(id -u)" ]] || hardware_gate_fail "collect must run as the user who prepared the gate"
  [[ "$state_home" == /* ]] || hardware_gate_fail "recorded state home is invalid"
  prepared_boot_kind="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" boot_kind)"
  prepared_boot_id="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" boot_id)"
  current_boot_id="$(hardware_gate_read_boot_id)"
  [[ -n "$prepared_boot_id" && "$current_boot_id" == "$prepared_boot_id" ]] || \
    hardware_gate_fail "evidence must be collected on the exact kernel boot that prepared it"
  if [[ "$prepared_boot_kind" == development-live ]]; then
    current_boot_kind="$(hardware_gate_classify_boot | sed -n 's/^boot_kind=//p' | tail -n 1)"
    [[ "$current_boot_kind" == development-live ]] || \
      hardware_gate_fail "development-live evidence must be collected on the same live overlay boot"
  fi
  gate_inhibitor_unit="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" gate_inhibitor_unit)"
  [[ "$gate_inhibitor_unit" == "$hardware_gate_awake_unit" ]] || \
    hardware_gate_fail "campaign has no valid Linux hardware gate awake inhibitor"
  sudo systemctl is-active --quiet "$gate_inhibitor_unit" || \
    hardware_gate_fail "prepared Linux hardware gate awake inhibitor is not active"
  hardware_gate_collect_cleanup_unit="$gate_inhibitor_unit"
  trap hardware_gate_collect_cleanup EXIT

  # The redirects intentionally run as the evidence owner; only journal access needs sudo.
  # shellcheck disable=SC2024
  sudo journalctl --after-cursor="$cursor" _UID="$user_uid" -o short-monotonic --no-pager \
    >"$evidence_dir/journal-user.txt"
  # shellcheck disable=SC2024
  sudo journalctl --after-cursor="$cursor" -k -o short-monotonic --no-pager \
    >"$evidence_dir/journal-kernel.txt"
  loginctl list-sessions >"$evidence_dir/loginctl-after.txt"
  systemctl is-active display-manager >"$evidence_dir/display-manager-active.txt" || true
  systemctl status display-manager --no-pager >"$evidence_dir/display-manager-after.txt" 2>&1 || true

  local revision_root="$state_home/sos/revisions"
  /usr/local/libexec/sos/sos-revision-supervisor experience-status \
    --root "$revision_root" \
    --experience sos.stock.shell >"$evidence_dir/stock-registry-revision.txt"
  [[ -r "$state_home/sos/provider/authority.json" ]] || \
    hardware_gate_fail "durable provider authority is missing"
  jq -er '.experiences["sos.stock.shell"].revision_id // empty | select(length > 0)' \
    "$state_home/sos/provider/authority.json" >"$evidence_dir/stock-authority-revision.txt"
  cp -- "$state_home/sos/provider/authority.json" "$evidence_dir/authority.json"

  started_ns="$(hardware_gate_metadata_value "$evidence_dir/campaign.env" started_monotonic_ns)"
  finished_ns="$(hardware_gate_monotonic_ns)"
  duration_ns=$((finished_ns - started_ns))
  [[ "$duration_ns" -gt 0 ]] || hardware_gate_fail "measured campaign duration is not positive"
  printf '%s\n' \
    "finished_at_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "boot_id=$current_boot_id" \
    "finished_monotonic_ns=$finished_ns" \
    "duration_ns=$duration_ns" >"$evidence_dir/collection.env"

  hardware_gate_stop_awake_inhibitor "$evidence_dir" "$gate_inhibitor_unit"
  hardware_gate_collect_cleanup_unit=""
  trap - EXIT

  local audit_status=0
  set +e
  hardware_gate_audit_dir "$evidence_dir" >"$evidence_dir/verdict.txt" 2>&1
  audit_status=$?
  set -e
  touch "$evidence_dir/collected"
  hardware_gate_generate_manifest "$evidence_dir"
  hardware_gate_verify_manifest_dir "$evidence_dir"
  cat "$evidence_dir/verdict.txt"
  printf 'measured_wall_time_ns=%s evidence_dir=%s\n' "$duration_ns" "$evidence_dir"
  return "$audit_status"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

[[ "$#" -ge 1 ]] || {
  hardware_gate_usage >&2
  exit 1
}
hardware_gate_command="$1"
shift
case "$hardware_gate_command" in
  prepare) hardware_gate_prepare "$@" ;;
  collect) hardware_gate_collect "$@" ;;
  audit)
    hardware_gate_parse_dir_options "$@"
    [[ -z "$hardware_gate_expected_product" ]] || hardware_gate_fail "--expect-product is accepted only by prepare"
    hardware_gate_audit_dir "$(hardware_gate_resolve_existing_dir "$hardware_gate_requested_dir")"
    ;;
  finalize-manifest)
    hardware_gate_parse_dir_options "$@"
    [[ -z "$hardware_gate_expected_product" ]] || hardware_gate_fail "--expect-product is accepted only by prepare"
    hardware_gate_generate_manifest "$(hardware_gate_resolve_existing_dir "$hardware_gate_requested_dir")"
    ;;
  verify-manifest)
    hardware_gate_parse_dir_options "$@"
    [[ -z "$hardware_gate_expected_product" ]] || hardware_gate_fail "--expect-product is accepted only by prepare"
    hardware_gate_verify_manifest_dir "$(hardware_gate_resolve_existing_dir "$hardware_gate_requested_dir")"
    ;;
  classify-boot)
    hardware_gate_sysroot=""
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --sysroot)
          [[ "$#" -ge 2 ]] || hardware_gate_fail "--sysroot requires a directory"
          hardware_gate_sysroot="$(realpath -e -- "$2")"
          shift 2
          ;;
        *) hardware_gate_fail "classify-boot accepts only --sysroot DIR" ;;
      esac
    done
    hardware_gate_classify_boot "$hardware_gate_sysroot"
    ;;
  *)
    hardware_gate_usage >&2
    exit 1
    ;;
esac
