FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bc \
        bison \
        build-essential \
        ca-certificates \
        ccache \
        cpio \
        curl \
        file \
        flex \
        fontconfig \
        g++-multilib \
        gcc-multilib \
        git-core \
        git-lfs \
        gnupg \
        gperf \
        imagemagick \
        lib32readline-dev \
        lib32z1-dev \
        libdw-dev \
        libelf-dev \
        liblz4-tool \
        libncurses-dev \
        libssl-dev \
        libxml2 \
        libxml2-utils \
        lz4 \
        lzop \
        openssh-client \
        pngcrush \
        protobuf-compiler \
        python3 \
        python3-protobuf \
        repo \
        rsync \
        schedtool \
        squashfs-tools \
        unzip \
        xsltproc \
        zip \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN repo version | grep -Eq 'repo launcher version ([2-9]|[1-9][0-9])\.' \
    && git lfs install --system --skip-smudge

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
